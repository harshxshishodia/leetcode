[{"leetcode_no":729,"name":"My Calendar I","solutions":{"approach_1":{"cpp":"class MyCalendar {\n    vector<pair<int, int>> bookingsList;\n\npublic:\n    MyCalendar() {}\n\n    bool book(int startTime, int endTime) {\n        for (const auto& [start, end] : bookingsList) {\n            if (max(startTime, start) < min(endTime, end)) {\n                return false;\n            }\n        }\n        bookingsList.emplace_back(startTime, endTime);\n        return true;\n    }\n};"},"approach_2":{"cpp":"class MyCalendar {\n    map<int, int> scheduledBookings; // start -> end\n\npublic:\n    MyCalendar() {}\n\n    bool book(int startTime, int endTime) {\n        auto nextBooking = scheduledBookings.upper_bound(startTime);\n        if (nextBooking != scheduledBookings.end() && nextBooking->first < endTime) {\n            return false;\n        }\n        if (nextBooking != scheduledBookings.begin()) {\n            auto prevBooking = prev(nextBooking);\n            if (prevBooking->second > startTime) {\n                return false;\n            }\n        }\n        scheduledBookings[startTime] = endTime;\n        return true;\n    }\n};"}}}]
