[{"leetcode_no":72,"name":"Edit Distance","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(const string& first, const string& second, int i, int j) {\n        if (i == static_cast<int>(first.size())) {\n            return static_cast<int>(second.size()) - j;\n        }\n\n        if (j == static_cast<int>(second.size())) {\n            return static_cast<int>(first.size()) - i;\n        }\n\n        if (first[i] == second[j]) {\n            return solve(first, second, i + 1, j + 1);\n        }\n\n        int insertCost = solve(first, second, i, j + 1);\n        int deleteCost = solve(first, second, i + 1, j);\n        int replaceCost = solve(first, second, i + 1, j + 1);\n\n        return 1 + min({insertCost, deleteCost, replaceCost});\n    }\n\npublic:\n    int minDistance(string word1, string word2) {\n        return solve(word1, word2, 0, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const string& first,\n        const string& second,\n        int i,\n        int j,\n        vector<vector<int>>& dp\n    ) {\n        if (i == static_cast<int>(first.size())) {\n            return static_cast<int>(second.size()) - j;\n        }\n\n        if (j == static_cast<int>(second.size())) {\n            return static_cast<int>(first.size()) - i;\n        }\n\n        if (dp[i][j] != -1) {\n            return dp[i][j];\n        }\n\n        if (first[i] == second[j]) {\n            dp[i][j] = solve(first, second, i + 1, j + 1, dp);\n        } else {\n            int insertCost = solve(first, second, i, j + 1, dp);\n            int deleteCost = solve(first, second, i + 1, j, dp);\n            int replaceCost = solve(first, second, i + 1, j + 1, dp);\n            dp[i][j] = 1 + min({insertCost, deleteCost, replaceCost});\n        }\n\n        return dp[i][j];\n    }\n\npublic:\n    int minDistance(string word1, string word2) {\n        vector<vector<int>> dp(\n            word1.size(),\n            vector<int>(word2.size(), -1)\n        );\n\n        return solve(word1, word2, 0, 0, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minDistance(string word1, string word2) {\n        int firstLength = static_cast<int>(word1.size());\n        int secondLength = static_cast<int>(word2.size());\n        vector<vector<int>> dp(\n            firstLength + 1,\n            vector<int>(secondLength + 1)\n        );\n\n        for (int i = 0; i <= firstLength; i++) {\n            dp[i][0] = i;\n        }\n\n        for (int j = 0; j <= secondLength; j++) {\n            dp[0][j] = j;\n        }\n\n        for (int i = 1; i <= firstLength; i++) {\n            for (int j = 1; j <= secondLength; j++) {\n                if (word1[i - 1] == word2[j - 1]) {\n                    dp[i][j] = dp[i - 1][j - 1];\n                } else {\n                    dp[i][j] = 1 + min({\n                        dp[i][j - 1],\n                        dp[i - 1][j],\n                        dp[i - 1][j - 1]\n                    });\n                }\n            }\n        }\n\n        return dp[firstLength][secondLength];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minDistance(string word1, string word2) {\n        int firstLength = static_cast<int>(word1.size());\n        int secondLength = static_cast<int>(word2.size());\n        vector<int> previous(secondLength + 1);\n        vector<int> current(secondLength + 1);\n\n        for (int j = 0; j <= secondLength; j++) {\n            previous[j] = j;\n        }\n\n        for (int i = 1; i <= firstLength; i++) {\n            current[0] = i;\n\n            for (int j = 1; j <= secondLength; j++) {\n                if (word1[i - 1] == word2[j - 1]) {\n                    current[j] = previous[j - 1];\n                } else {\n                    current[j] = 1 + min({\n                        current[j - 1],\n                        previous[j],\n                        previous[j - 1]\n                    });\n                }\n            }\n\n            previous = current;\n        }\n\n        return previous[secondLength];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int minDistance(string word1, string word2) {\n        if (word1.size() < word2.size()) {\n            swap(word1, word2);\n        }\n\n        int firstLength = static_cast<int>(word1.size());\n        int secondLength = static_cast<int>(word2.size());\n        vector<int> dp(secondLength + 1);\n\n        for (int j = 0; j <= secondLength; j++) {\n            dp[j] = j;\n        }\n\n        for (int i = 1; i <= firstLength; i++) {\n            int diagonal = dp[0];\n            dp[0] = i;\n\n            for (int j = 1; j <= secondLength; j++) {\n                int fromTop = dp[j];\n\n                if (word1[i - 1] == word2[j - 1]) {\n                    dp[j] = diagonal;\n                } else {\n                    dp[j] = 1 + min({\n                        dp[j - 1],\n                        fromTop,\n                        diagonal\n                    });\n                }\n\n                diagonal = fromTop;\n            }\n        }\n\n        return dp[secondLength];\n    }\n};"}}}]
