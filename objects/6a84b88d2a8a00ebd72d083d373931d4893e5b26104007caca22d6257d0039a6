[{"leetcode_no":983,"name":"Minimum Cost For Tickets","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& days,\n        const vector<int>& costs,\n        int index\n    ) {\n        if (index == static_cast<int>(days.size())) {\n            return 0;\n        }\n\n        int next1 =\n            index + 1;\n\n        int next7 =\n            lower_bound(\n                days.begin(),\n                days.end(),\n                days[index] + 7\n            ) -\n            days.begin();\n\n        int next30 =\n            lower_bound(\n                days.begin(),\n                days.end(),\n                days[index] + 30\n            ) -\n            days.begin();\n\n        return min({\n            costs[0] +\n            solve(\n                days,\n                costs,\n                next1\n            ),\n            costs[1] +\n            solve(\n                days,\n                costs,\n                next7\n            ),\n            costs[2] +\n            solve(\n                days,\n                costs,\n                next30\n            )\n        });\n    }\n\npublic:\n    int mincostTickets(\n        vector<int>& days,\n        vector<int>& costs\n    ) {\n        return solve(\n            days,\n            costs,\n            0\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& days,\n        const vector<int>& costs,\n        int index,\n        vector<int>& memo\n    ) {\n        if (index == static_cast<int>(days.size())) {\n            return 0;\n        }\n\n        if (memo[index] != -1) {\n            return memo[index];\n        }\n\n        int next1 =\n            index + 1;\n\n        int next7 =\n            lower_bound(\n                days.begin(),\n                days.end(),\n                days[index] + 7\n            ) -\n            days.begin();\n\n        int next30 =\n            lower_bound(\n                days.begin(),\n                days.end(),\n                days[index] + 30\n            ) -\n            days.begin();\n\n        memo[index] = min({\n            costs[0] +\n            solve(\n                days,\n                costs,\n                next1,\n                memo\n            ),\n            costs[1] +\n            solve(\n                days,\n                costs,\n                next7,\n                memo\n            ),\n            costs[2] +\n            solve(\n                days,\n                costs,\n                next30,\n                memo\n            )\n        });\n\n        return memo[index];\n    }\n\npublic:\n    int mincostTickets(\n        vector<int>& days,\n        vector<int>& costs\n    ) {\n        vector<int> memo(\n            days.size(),\n            -1\n        );\n\n        return solve(\n            days,\n            costs,\n            0,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int mincostTickets(\n        vector<int>& days,\n        vector<int>& costs\n    ) {\n        int n = static_cast<int>(days.size());\n        vector<int> dp(n + 1);\n\n        for (int index = n - 1; index >= 0; index--) {\n            int next7 =\n                lower_bound(\n                    days.begin(),\n                    days.end(),\n                    days[index] + 7\n                ) -\n                days.begin();\n\n            int next30 =\n                lower_bound(\n                    days.begin(),\n                    days.end(),\n                    days[index] + 30\n                ) -\n                days.begin();\n\n            dp[index] = min({\n                costs[0] +\n                dp[index + 1],\n                costs[1] +\n                dp[next7],\n                costs[2] +\n                dp[next30]\n            });\n        }\n\n        return dp[0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int mincostTickets(\n        vector<int>& days,\n        vector<int>& costs\n    ) {\n        vector<bool> travel(366);\n\n        for (int day : days) {\n            travel[day] = true;\n        }\n\n        vector<int> dp(366);\n\n        for (int day = 1; day <= 365; day++) {\n            if (!travel[day]) {\n                dp[day] =\n                    dp[day - 1];\n\n                continue;\n            }\n\n            dp[day] = min({\n                dp[day - 1] +\n                costs[0],\n                dp[max(0, day - 7)] +\n                costs[1],\n                dp[max(0, day - 30)] +\n                costs[2]\n            });\n        }\n\n        return dp[365];\n    }\n};"}}}]
