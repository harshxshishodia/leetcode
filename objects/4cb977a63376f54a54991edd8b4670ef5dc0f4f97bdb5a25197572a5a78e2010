[{"leetcode_no":714,"name":"Best Time to Buy and Sell Stock with Transaction Fee","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& prices,\n        int fee,\n        int index,\n        bool canBuy\n    ) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (canBuy) {\n            return max(\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    true\n                ),\n                -prices[index] +\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    false\n                )\n            );\n        }\n\n        return max(\n            solve(\n                prices,\n                fee,\n                index + 1,\n                false\n            ),\n            prices[index] -\n            fee +\n            solve(\n                prices,\n                fee,\n                index + 1,\n                true\n            )\n        );\n    }\n\npublic:\n    int maxProfit(vector<int>& prices, int fee) {\n        return solve(\n            prices,\n            fee,\n            0,\n            true\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& prices,\n        int fee,\n        int index,\n        int canBuy,\n        vector<vector<int>>& memo\n    ) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (memo[index][canBuy] != -1) {\n            return memo[index][canBuy];\n        }\n\n        if (canBuy == 1) {\n            memo[index][canBuy] = max(\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    1,\n                    memo\n                ),\n                -prices[index] +\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    0,\n                    memo\n                )\n            );\n        } else {\n            memo[index][canBuy] = max(\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    0,\n                    memo\n                ),\n                prices[index] -\n                fee +\n                solve(\n                    prices,\n                    fee,\n                    index + 1,\n                    1,\n                    memo\n                )\n            );\n        }\n\n        return memo[index][canBuy];\n    }\n\npublic:\n    int maxProfit(vector<int>& prices, int fee) {\n        vector<vector<int>> memo(\n            prices.size(),\n            vector<int>(2, -1)\n        );\n\n        return solve(\n            prices,\n            fee,\n            0,\n            1,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices, int fee) {\n        int n = static_cast<int>(prices.size());\n\n        vector<vector<int>> dp(\n            n + 1,\n            vector<int>(2)\n        );\n\n        for (int index = n - 1; index >= 0; index--) {\n            dp[index][1] = max(\n                dp[index + 1][1],\n                -prices[index] +\n                dp[index + 1][0]\n            );\n\n            dp[index][0] = max(\n                dp[index + 1][0],\n                prices[index] -\n                fee +\n                dp[index + 1][1]\n            );\n        }\n\n        return dp[0][1];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices, int fee) {\n        int nextCanBuy = 0;\n        int nextHolding = 0;\n\n        for (int index = static_cast<int>(prices.size()) - 1;\n             index >= 0;\n             index--) {\n            int currentCanBuy = max(\n                nextCanBuy,\n                -prices[index] + nextHolding\n            );\n\n            int currentHolding = max(\n                nextHolding,\n                prices[index] -\n                fee +\n                nextCanBuy\n            );\n\n            nextCanBuy = currentCanBuy;\n            nextHolding = currentHolding;\n        }\n\n        return nextCanBuy;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices, int fee) {\n        int profit = 0;\n        int effectiveBuy =\n            prices[0] + fee;\n\n        for (int i = 1; i < static_cast<int>(prices.size()); i++) {\n            effectiveBuy = min(\n                effectiveBuy,\n                prices[i] + fee\n            );\n\n            if (prices[i] > effectiveBuy) {\n                profit +=\n                    prices[i] - effectiveBuy;\n\n                effectiveBuy =\n                    prices[i];\n            }\n        }\n\n        return profit;\n    }\n};"}}}]
