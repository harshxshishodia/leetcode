[{"leetcode_no":792,"name":"Number of Matching Subsequences","solutions":{"approach_1":{"cpp":"class Solution {\n    bool subsequence(\n        const string& s,\n        const string& word\n    ) {\n        int index = 0;\n\n        for (char character : s) {\n            if (index < static_cast<int>(word.size()) &&\n                word[index] == character) {\n                index++;\n            }\n        }\n\n        return index ==\n               static_cast<int>(word.size());\n    }\n\npublic:\n    int numMatchingSubseq(\n        string s,\n        vector<string>& words\n    ) {\n        int answer = 0;\n\n        for (const string& word : words) {\n            if (subsequence(\n                    s,\n                    word)) {\n                answer++;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int numMatchingSubseq(\n        string s,\n        vector<string>& words\n    ) {\n        int n = static_cast<int>(s.size());\n\n        vector<array<int, 26>> next(\n            n + 1\n        );\n\n        next[n].fill(-1);\n\n        for (int i = n - 1; i >= 0; i--) {\n            next[i] = next[i + 1];\n            next[i][s[i] - 'a'] = i;\n        }\n\n        int answer = 0;\n\n        for (const string& word : words) {\n            int position = 0;\n            bool possible = true;\n\n            for (char character : word) {\n                if (position > n ||\n                    next[position][character - 'a'] == -1) {\n                    possible = false;\n                    break;\n                }\n\n                position =\n                    next[position][character - 'a'] +\n                    1;\n            }\n\n            if (possible) {\n                answer++;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int numMatchingSubseq(\n        string s,\n        vector<string>& words\n    ) {\n        array<vector<int>, 26> positions;\n\n        for (int i = 0; i < static_cast<int>(s.size()); i++) {\n            positions[s[i] - 'a'].push_back(i);\n        }\n\n        int answer = 0;\n\n        for (const string& word : words) {\n            int previous = -1;\n            bool possible = true;\n\n            for (char character : word) {\n                const vector<int>& indices =\n                    positions[character - 'a'];\n\n                auto position = upper_bound(\n                    indices.begin(),\n                    indices.end(),\n                    previous\n                );\n\n                if (position == indices.end()) {\n                    possible = false;\n                    break;\n                }\n\n                previous = *position;\n            }\n\n            if (possible) {\n                answer++;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int numMatchingSubseq(\n        string s,\n        vector<string>& words\n    ) {\n        array<vector<pair<int, int>>, 26> waiting;\n\n        int answer = 0;\n\n        for (int index = 0;\n             index < static_cast<int>(words.size());\n             index++) {\n            if (words[index].empty()) {\n                answer++;\n            } else {\n                waiting[\n                    words[index][0] - 'a'\n                ].push_back({\n                    index,\n                    0\n                });\n            }\n        }\n\n        for (char character : s) {\n            int bucket =\n                character - 'a';\n\n            vector<pair<int, int>> current =\n                move(waiting[bucket]);\n\n            waiting[bucket].clear();\n\n            for (auto [wordIndex, position] : current) {\n                position++;\n\n                if (position ==\n                    static_cast<int>(words[wordIndex].size())) {\n                    answer++;\n                } else {\n                    waiting[\n                        words[wordIndex][position] - 'a'\n                    ].push_back({\n                        wordIndex,\n                        position\n                    });\n                }\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
