[{"leetcode_no":313,"name":"Super Ugly Number","solutions":{"approach_1":{"cpp":"class Solution {\n    bool isSuperUgly(int number, const vector<int>& primes) {\n        if (number <= 0) {\n            return false;\n        }\n\n        for (int prime : primes) {\n            while (number % prime == 0) {\n                number /= prime;\n            }\n        }\n\n        return number == 1;\n    }\n\npublic:\n    int nthSuperUglyNumber(int n, vector<int>& primes) {\n        int count = 0;\n        int number = 0;\n\n        while (count < n) {\n            number++;\n\n            if (isSuperUgly(number, primes)) {\n                count++;\n            }\n        }\n\n        return number;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int nthSuperUglyNumber(int n, vector<int>& primes) {\n        priority_queue<\n            long long,\n            vector<long long>,\n            greater<long long>\n        > minimumHeap;\n\n        unordered_set<long long> seen;\n        minimumHeap.push(1);\n        seen.insert(1);\n        long long current = 1;\n\n        for (int i = 0; i < n; i++) {\n            current = minimumHeap.top();\n            minimumHeap.pop();\n\n            for (int prime : primes) {\n                long long next = current * prime;\n\n                if (next <= numeric_limits<int>::max() &&\n                    seen.insert(next).second) {\n                    minimumHeap.push(next);\n                }\n            }\n        }\n\n        return static_cast<int>(current);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int nthSuperUglyNumber(int n, vector<int>& primes) {\n        int count = static_cast<int>(primes.size());\n        vector<long long> ugly(n);\n        vector<int> index(count);\n        vector<long long> candidate(count);\n\n        ugly[0] = 1;\n\n        for (int i = 0; i < count; i++) {\n            candidate[i] = primes[i];\n        }\n\n        for (int position = 1; position < n; position++) {\n            long long next = *min_element(\n                candidate.begin(),\n                candidate.end()\n            );\n\n            ugly[position] = next;\n\n            for (int i = 0; i < count; i++) {\n                if (candidate[i] == next) {\n                    index[i]++;\n                    candidate[i] =\n                        ugly[index[i]] * primes[i];\n                }\n            }\n        }\n\n        return static_cast<int>(ugly[n - 1]);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int nthSuperUglyNumber(int n, vector<int>& primes) {\n        using Entry = tuple<long long, int, int>;\n\n        priority_queue<\n            Entry,\n            vector<Entry>,\n            greater<Entry>\n        > minimumHeap;\n\n        vector<long long> ugly(n);\n        ugly[0] = 1;\n\n        for (int prime : primes) {\n            minimumHeap.push({prime, prime, 0});\n        }\n\n        for (int position = 1; position < n; position++) {\n            long long next = get<0>(minimumHeap.top());\n            ugly[position] = next;\n\n            while (!minimumHeap.empty() &&\n                   get<0>(minimumHeap.top()) == next) {\n                auto [value, prime, index] = minimumHeap.top();\n                minimumHeap.pop();\n\n                index++;\n                minimumHeap.push({\n                    ugly[index] * prime,\n                    prime,\n                    index\n                });\n            }\n        }\n\n        return static_cast<int>(ugly[n - 1]);\n    }\n};"}}}]
