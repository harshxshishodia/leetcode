[{"leetcode_no":647,"name":"Palindromic Substrings","solutions":{"approach_1":{"cpp":"class Solution {\n    bool isPalindrome(const string& s, int left, int right) {\n        while (left < right) {\n            if (s[left] != s[right]) {\n                return false;\n            }\n\n            left++;\n            right--;\n        }\n\n        return true;\n    }\n\npublic:\n    int countSubstrings(string s) {\n        int answer = 0;\n\n        for (int left = 0; left < static_cast<int>(s.size()); left++) {\n            for (int right = left; right < static_cast<int>(s.size()); right++) {\n                if (isPalindrome(s, left, right)) {\n                    answer++;\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int palindrome(\n        const string& s,\n        int left,\n        int right,\n        vector<vector<int>>& memo\n    ) {\n        if (left >= right) {\n            return 1;\n        }\n\n        if (memo[left][right] != -1) {\n            return memo[left][right];\n        }\n\n        if (s[left] != s[right]) {\n            memo[left][right] = 0;\n        } else {\n            memo[left][right] = palindrome(\n                s,\n                left + 1,\n                right - 1,\n                memo\n            );\n        }\n\n        return memo[left][right];\n    }\n\npublic:\n    int countSubstrings(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<int>> memo(\n            n,\n            vector<int>(n, -1)\n        );\n\n        int answer = 0;\n\n        for (int left = 0; left < n; left++) {\n            for (int right = left; right < n; right++) {\n                answer += palindrome(\n                    s,\n                    left,\n                    right,\n                    memo\n                );\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int countSubstrings(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<bool>> dp(\n            n,\n            vector<bool>(n)\n        );\n\n        int answer = 0;\n\n        for (int length = 1; length <= n; length++) {\n            for (int left = 0; left + length <= n; left++) {\n                int right = left + length - 1;\n\n                if (s[left] == s[right] &&\n                    (length <= 2 || dp[left + 1][right - 1])) {\n                    dp[left][right] = true;\n                    answer++;\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    int expand(\n        const string& s,\n        int left,\n        int right\n    ) {\n        int count = 0;\n\n        while (left >= 0 &&\n               right < static_cast<int>(s.size()) &&\n               s[left] == s[right]) {\n            count++;\n            left--;\n            right++;\n        }\n\n        return count;\n    }\n\npublic:\n    int countSubstrings(string s) {\n        int answer = 0;\n\n        for (int center = 0; center < static_cast<int>(s.size()); center++) {\n            answer += expand(\n                s,\n                center,\n                center\n            );\n\n            answer += expand(\n                s,\n                center,\n                center + 1\n            );\n        }\n\n        return answer;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int countSubstrings(string s) {\n        int n = static_cast<int>(s.size());\n        vector<int> odd(n);\n        vector<int> even(n);\n\n        int left = 0;\n        int right = -1;\n\n        for (int i = 0; i < n; i++) {\n            int radius =\n                i > right\n                    ? 1\n                    : min(\n                        odd[left + right - i],\n                        right - i + 1\n                    );\n\n            while (i - radius >= 0 &&\n                   i + radius < n &&\n                   s[i - radius] == s[i + radius]) {\n                radius++;\n            }\n\n            odd[i] = radius;\n\n            if (i + radius - 1 > right) {\n                left = i - radius + 1;\n                right = i + radius - 1;\n            }\n        }\n\n        left = 0;\n        right = -1;\n\n        for (int i = 0; i < n; i++) {\n            int radius =\n                i > right\n                    ? 0\n                    : min(\n                        even[left + right - i + 1],\n                        right - i + 1\n                    );\n\n            while (i - radius - 1 >= 0 &&\n                   i + radius < n &&\n                   s[i - radius - 1] == s[i + radius]) {\n                radius++;\n            }\n\n            even[i] = radius;\n\n            if (i + radius - 1 > right) {\n                left = i - radius;\n                right = i + radius - 1;\n            }\n        }\n\n        long long answer = 0;\n\n        for (int radius : odd) {\n            answer += radius;\n        }\n\n        for (int radius : even) {\n            answer += radius;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
