[{"leetcode_no":526,"name":"Beautiful Arrangement","solutions":{"approach_1":{"cpp":"class Solution {\n    bool beautiful(const vector<int>& arrangement) {\n        for (int i = 0; i < static_cast<int>(arrangement.size()); i++) {\n            int position = i + 1;\n            int value = arrangement[i];\n\n            if (value % position != 0 &&\n                position % value != 0) {\n                return false;\n            }\n        }\n\n        return true;\n    }\n\npublic:\n    int countArrangement(int n) {\n        vector<int> values(n);\n\n        for (int i = 0; i < n; i++) {\n            values[i] = i + 1;\n        }\n\n        int answer = 0;\n\n        do {\n            if (beautiful(values)) {\n                answer++;\n            }\n        } while (next_permutation(values.begin(), values.end()));\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int search(\n        int n,\n        int position,\n        vector<bool>& used\n    ) {\n        if (position > n) {\n            return 1;\n        }\n\n        int answer = 0;\n\n        for (int value = 1; value <= n; value++) {\n            if (used[value]) {\n                continue;\n            }\n\n            if (value % position != 0 &&\n                position % value != 0) {\n                continue;\n            }\n\n            used[value] = true;\n            answer += search(\n                n,\n                position + 1,\n                used\n            );\n            used[value] = false;\n        }\n\n        return answer;\n    }\n\npublic:\n    int countArrangement(int n) {\n        vector<bool> used(n + 1);\n        return search(n, 1, used);\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    vector<int> memo;\n    int n;\n\n    int solve(int mask) {\n        if (mask == (1 << n) - 1) {\n            return 1;\n        }\n\n        if (memo[mask] != -1) {\n            return memo[mask];\n        }\n\n        int position = __builtin_popcount(\n            static_cast<unsigned int>(mask)\n        ) + 1;\n\n        int answer = 0;\n\n        for (int value = 1; value <= n; value++) {\n            int bit = 1 << (value - 1);\n\n            if ((mask & bit) != 0) {\n                continue;\n            }\n\n            if (value % position != 0 &&\n                position % value != 0) {\n                continue;\n            }\n\n            answer += solve(mask | bit);\n        }\n\n        memo[mask] = answer;\n        return memo[mask];\n    }\n\npublic:\n    int countArrangement(int value) {\n        n = value;\n        memo.assign(1 << n, -1);\n        return solve(0);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int countArrangement(int n) {\n        int states = 1 << n;\n        vector<int> dp(states);\n        dp[0] = 1;\n\n        for (int mask = 0; mask < states; mask++) {\n            int position = __builtin_popcount(\n                static_cast<unsigned int>(mask)\n            ) + 1;\n\n            for (int value = 1; value <= n; value++) {\n                int bit = 1 << (value - 1);\n\n                if ((mask & bit) != 0) {\n                    continue;\n                }\n\n                if (value % position != 0 &&\n                    position % value != 0) {\n                    continue;\n                }\n\n                dp[mask | bit] += dp[mask];\n            }\n        }\n\n        return dp[states - 1];\n    }\n};"}}}]
