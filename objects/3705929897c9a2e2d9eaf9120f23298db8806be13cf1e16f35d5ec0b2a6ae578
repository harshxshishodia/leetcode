[{"leetcode_no":122,"name":"Best Time to Buy and Sell Stock II","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(const vector<int>& prices, int index, bool canBuy) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (canBuy) {\n            return max(\n                solve(prices, index + 1, true),\n                -prices[index] + solve(prices, index + 1, false)\n            );\n        }\n\n        return max(\n            solve(prices, index + 1, false),\n            prices[index] + solve(prices, index + 1, true)\n        );\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        return solve(prices, 0, true);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& prices,\n        int index,\n        int canBuy,\n        vector<vector<int>>& dp\n    ) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (dp[index][canBuy] != -1) {\n            return dp[index][canBuy];\n        }\n\n        if (canBuy == 1) {\n            dp[index][canBuy] = max(\n                solve(prices, index + 1, 1, dp),\n                -prices[index] + solve(prices, index + 1, 0, dp)\n            );\n        } else {\n            dp[index][canBuy] = max(\n                solve(prices, index + 1, 0, dp),\n                prices[index] + solve(prices, index + 1, 1, dp)\n            );\n        }\n\n        return dp[index][canBuy];\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        vector<vector<int>> dp(\n            prices.size(),\n            vector<int>(2, -1)\n        );\n\n        return solve(prices, 0, 1, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int n = static_cast<int>(prices.size());\n        vector<vector<int>> dp(n + 1, vector<int>(2));\n\n        for (int index = n - 1; index >= 0; index--) {\n            dp[index][1] = max(\n                dp[index + 1][1],\n                -prices[index] + dp[index + 1][0]\n            );\n\n            dp[index][0] = max(\n                dp[index + 1][0],\n                prices[index] + dp[index + 1][1]\n            );\n        }\n\n        return dp[0][1];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int nextCanBuy = 0;\n        int nextHolding = 0;\n\n        for (int index = static_cast<int>(prices.size()) - 1; index >= 0; index--) {\n            int currentCanBuy = max(\n                nextCanBuy,\n                -prices[index] + nextHolding\n            );\n\n            int currentHolding = max(\n                nextHolding,\n                prices[index] + nextCanBuy\n            );\n\n            nextCanBuy = currentCanBuy;\n            nextHolding = currentHolding;\n        }\n\n        return nextCanBuy;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int profit = 0;\n\n        for (int i = 1; i < static_cast<int>(prices.size()); i++) {\n            if (prices[i] > prices[i - 1]) {\n                profit += prices[i] - prices[i - 1];\n            }\n        }\n\n        return profit;\n    }\n};"}}}]
