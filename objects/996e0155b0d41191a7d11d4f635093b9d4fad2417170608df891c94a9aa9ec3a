[{"leetcode_no":799,"name":"Champagne Tower","solutions":{"approach_1":{"cpp":"class Solution {\n    double amount(\n        int poured,\n        int row,\n        int glass\n    ) {\n        if (glass < 0 ||\n            glass > row) {\n            return 0.0;\n        }\n\n        if (row == 0) {\n            return glass == 0\n                ? poured\n                : 0.0;\n        }\n\n        double fromLeft =\n            max(\n                0.0,\n                (amount(\n                    poured,\n                    row - 1,\n                    glass - 1\n                ) - 1.0) /\n                2.0\n            );\n\n        double fromRight =\n            max(\n                0.0,\n                (amount(\n                    poured,\n                    row - 1,\n                    glass\n                ) - 1.0) /\n                2.0\n            );\n\n        return\n            fromLeft +\n            fromRight;\n    }\n\npublic:\n    double champagneTower(\n        int poured,\n        int query_row,\n        int query_glass\n    ) {\n        return min(\n            1.0,\n            amount(\n                poured,\n                query_row,\n                query_glass\n            )\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    vector<vector<double>> memo;\n    vector<vector<bool>> visited;\n    int poured;\n\n    double amount(\n        int row,\n        int glass\n    ) {\n        if (glass < 0 ||\n            glass > row) {\n            return 0.0;\n        }\n\n        if (row == 0) {\n            return glass == 0\n                ? poured\n                : 0.0;\n        }\n\n        if (visited[row][glass]) {\n            return memo[row][glass];\n        }\n\n        visited[row][glass] = true;\n\n        double fromLeft =\n            max(\n                0.0,\n                (amount(\n                    row - 1,\n                    glass - 1\n                ) - 1.0) /\n                2.0\n            );\n\n        double fromRight =\n            max(\n                0.0,\n                (amount(\n                    row - 1,\n                    glass\n                ) - 1.0) /\n                2.0\n            );\n\n        memo[row][glass] =\n            fromLeft +\n            fromRight;\n\n        return memo[row][glass];\n    }\n\npublic:\n    double champagneTower(\n        int input,\n        int query_row,\n        int query_glass\n    ) {\n        poured = input;\n\n        memo.assign(\n            query_row + 1,\n            vector<double>(\n                query_row + 1\n            )\n        );\n\n        visited.assign(\n            query_row + 1,\n            vector<bool>(\n                query_row + 1\n            )\n        );\n\n        return min(\n            1.0,\n            amount(\n                query_row,\n                query_glass\n            )\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    double champagneTower(\n        int poured,\n        int query_row,\n        int query_glass\n    ) {\n        vector<vector<double>> dp(\n            query_row + 2,\n            vector<double>(\n                query_row + 2\n            )\n        );\n\n        dp[0][0] = poured;\n\n        for (int row = 0; row < query_row; row++) {\n            for (int glass = 0; glass <= row; glass++) {\n                double overflow =\n                    max(\n                        0.0,\n                        (dp[row][glass] - 1.0) /\n                        2.0\n                    );\n\n                dp[row + 1][glass] +=\n                    overflow;\n\n                dp[row + 1][glass + 1] +=\n                    overflow;\n            }\n        }\n\n        return min(\n            1.0,\n            dp[query_row][query_glass]\n        );\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    double champagneTower(\n        int poured,\n        int query_row,\n        int query_glass\n    ) {\n        vector<double> row(\n            query_row + 2\n        );\n\n        row[0] = poured;\n\n        for (int currentRow = 0;\n             currentRow < query_row;\n             currentRow++) {\n            for (int glass = currentRow;\n                 glass >= 0;\n                 glass--) {\n                double overflow =\n                    max(\n                        0.0,\n                        (row[glass] - 1.0) /\n                        2.0\n                    );\n\n                row[glass + 1] +=\n                    overflow;\n\n                row[glass] =\n                    overflow;\n            }\n        }\n\n        return min(\n            1.0,\n            row[query_glass]\n        );\n    }\n};"}}}]
