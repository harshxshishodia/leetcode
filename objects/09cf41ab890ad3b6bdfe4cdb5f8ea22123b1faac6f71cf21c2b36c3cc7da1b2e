[{"leetcode_no":487,"name":"Max Consecutive Ones II","solutions":{"approach_1":{"cpp":"class Solution {\n    int longest(const vector<int>& nums) {\n        int answer = 0;\n        int current = 0;\n\n        for (int value : nums) {\n            if (value == 1) {\n                current++;\n                answer = max(answer, current);\n            } else {\n                current = 0;\n            }\n        }\n\n        return answer;\n    }\n\npublic:\n    int findMaxConsecutiveOnes(vector<int>& nums) {\n        int answer = longest(nums);\n\n        for (int i = 0; i < static_cast<int>(nums.size()); i++) {\n            if (nums[i] == 1) {\n                continue;\n            }\n\n            nums[i] = 1;\n            answer = max(answer, longest(nums));\n            nums[i] = 0;\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int findMaxConsecutiveOnes(vector<int>& nums) {\n        int withoutFlip = 0;\n        int withFlip = 0;\n        int answer = 0;\n\n        for (int value : nums) {\n            if (value == 1) {\n                withoutFlip++;\n                withFlip++;\n            } else {\n                withFlip = withoutFlip + 1;\n                withoutFlip = 0;\n            }\n\n            answer = max(answer, withFlip);\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int findMaxConsecutiveOnes(vector<int>& nums) {\n        int left = 0;\n        int zeroes = 0;\n        int answer = 0;\n\n        for (int right = 0;\n             right < static_cast<int>(nums.size());\n             right++) {\n            if (nums[right] == 0) {\n                zeroes++;\n            }\n\n            while (zeroes > 1) {\n                if (nums[left] == 0) {\n                    zeroes--;\n                }\n\n                left++;\n            }\n\n            answer = max(\n                answer,\n                right - left + 1\n            );\n        }\n\n        return answer;\n    }\n};"}}}]
