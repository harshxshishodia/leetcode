[{"leetcode_no":322,"name":"Coin Change","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& coins,\n        int index,\n        int amount\n    ) {\n        if (amount == 0) {\n            return 0;\n        }\n\n        if (index == static_cast<int>(coins.size()) ||\n            amount < 0) {\n            return 1000000000;\n        }\n\n        int skip = solve(\n            coins,\n            index + 1,\n            amount\n        );\n\n        int take = 1000000000;\n\n        if (coins[index] <= amount) {\n            take = 1 + solve(\n                coins,\n                index,\n                amount - coins[index]\n            );\n        }\n\n        return min(skip, take);\n    }\n\npublic:\n    int coinChange(vector<int>& coins, int amount) {\n        int answer = solve(coins, 0, amount);\n        return answer >= 1000000000 ? -1 : answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& coins,\n        int index,\n        int amount,\n        vector<vector<int>>& memo\n    ) {\n        if (amount == 0) {\n            return 0;\n        }\n\n        if (index == static_cast<int>(coins.size()) ||\n            amount < 0) {\n            return 1000000000;\n        }\n\n        if (memo[index][amount] != -1) {\n            return memo[index][amount];\n        }\n\n        int skip = solve(\n            coins,\n            index + 1,\n            amount,\n            memo\n        );\n\n        int take = 1000000000;\n\n        if (coins[index] <= amount) {\n            take = 1 + solve(\n                coins,\n                index,\n                amount - coins[index],\n                memo\n            );\n        }\n\n        memo[index][amount] = min(skip, take);\n        return memo[index][amount];\n    }\n\npublic:\n    int coinChange(vector<int>& coins, int amount) {\n        vector<vector<int>> memo(\n            coins.size(),\n            vector<int>(amount + 1, -1)\n        );\n\n        int answer = solve(\n            coins,\n            0,\n            amount,\n            memo\n        );\n\n        return answer >= 1000000000 ? -1 : answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int coinChange(vector<int>& coins, int amount) {\n        int n = static_cast<int>(coins.size());\n        const int INF = 1000000000;\n\n        vector<vector<int>> dp(\n            n + 1,\n            vector<int>(amount + 1, INF)\n        );\n\n        for (int index = 0; index <= n; index++) {\n            dp[index][0] = 0;\n        }\n\n        for (int index = n - 1; index >= 0; index--) {\n            for (int value = 1; value <= amount; value++) {\n                dp[index][value] = dp[index + 1][value];\n\n                if (coins[index] <= value &&\n                    dp[index][value - coins[index]] != INF) {\n                    dp[index][value] = min(\n                        dp[index][value],\n                        1 + dp[index][value - coins[index]]\n                    );\n                }\n            }\n        }\n\n        return dp[0][amount] == INF ? -1 : dp[0][amount];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int coinChange(vector<int>& coins, int amount) {\n        const int INF = 1000000000;\n        vector<int> dp(amount + 1, INF);\n        dp[0] = 0;\n\n        for (int coin : coins) {\n            for (int value = coin; value <= amount; value++) {\n                if (dp[value - coin] != INF) {\n                    dp[value] = min(\n                        dp[value],\n                        1 + dp[value - coin]\n                    );\n                }\n            }\n        }\n\n        return dp[amount] == INF ? -1 : dp[amount];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int coinChange(vector<int>& coins, int amount) {\n        if (amount == 0) {\n            return 0;\n        }\n\n        vector<bool> visited(amount + 1);\n        queue<int> pending;\n        pending.push(0);\n        visited[0] = true;\n        int steps = 0;\n\n        while (!pending.empty()) {\n            int levelSize = static_cast<int>(pending.size());\n            steps++;\n\n            for (int i = 0; i < levelSize; i++) {\n                int current = pending.front();\n                pending.pop();\n\n                for (int coin : coins) {\n                    int next = current + coin;\n\n                    if (next == amount) {\n                        return steps;\n                    }\n\n                    if (next < amount && !visited[next]) {\n                        visited[next] = true;\n                        pending.push(next);\n                    }\n                }\n            }\n        }\n\n        return -1;\n    }\n};"}}}]
