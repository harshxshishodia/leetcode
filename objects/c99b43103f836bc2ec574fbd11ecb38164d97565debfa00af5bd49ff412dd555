[{"leetcode_no":787,"name":"Cheapest Flights Within K Stops","solutions":{"approach_1":{"cpp":"class Solution {\n    static constexpr int INF = 1000000000;\n\n    int solve(\n        const vector<vector<pair<int, int>>>& graph,\n        int node,\n        int destination,\n        int edgesRemaining\n    ) {\n        if (node == destination) {\n            return 0;\n        }\n\n        if (edgesRemaining == 0) {\n            return INF;\n        }\n\n        int answer = INF;\n\n        for (auto [next, price] : graph[node]) {\n            int remaining = solve(\n                graph,\n                next,\n                destination,\n                edgesRemaining - 1\n            );\n\n            if (remaining != INF) {\n                answer = min(\n                    answer,\n                    price + remaining\n                );\n            }\n        }\n\n        return answer;\n    }\n\npublic:\n    int findCheapestPrice(\n        int n,\n        vector<vector<int>>& flights,\n        int src,\n        int dst,\n        int k\n    ) {\n        vector<vector<pair<int, int>>> graph(n);\n\n        for (const vector<int>& flight : flights) {\n            graph[flight[0]].push_back({\n                flight[1],\n                flight[2]\n            });\n        }\n\n        int answer = solve(\n            graph,\n            src,\n            dst,\n            k + 1\n        );\n\n        return answer == INF\n            ? -1\n            : answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    static constexpr int INF = 1000000000;\n    vector<vector<int>> memo;\n\n    int solve(\n        const vector<vector<pair<int, int>>>& graph,\n        int node,\n        int destination,\n        int edgesRemaining\n    ) {\n        if (node == destination) {\n            return 0;\n        }\n\n        if (edgesRemaining == 0) {\n            return INF;\n        }\n\n        if (memo[node][edgesRemaining] != -1) {\n            return memo[node][edgesRemaining];\n        }\n\n        int answer = INF;\n\n        for (auto [next, price] : graph[node]) {\n            int remaining = solve(\n                graph,\n                next,\n                destination,\n                edgesRemaining - 1\n            );\n\n            if (remaining != INF) {\n                answer = min(\n                    answer,\n                    price + remaining\n                );\n            }\n        }\n\n        memo[node][edgesRemaining] = answer;\n        return memo[node][edgesRemaining];\n    }\n\npublic:\n    int findCheapestPrice(\n        int n,\n        vector<vector<int>>& flights,\n        int src,\n        int dst,\n        int k\n    ) {\n        vector<vector<pair<int, int>>> graph(n);\n\n        for (const vector<int>& flight : flights) {\n            graph[flight[0]].push_back({\n                flight[1],\n                flight[2]\n            });\n        }\n\n        memo.assign(\n            n,\n            vector<int>(k + 2, -1)\n        );\n\n        int answer = solve(\n            graph,\n            src,\n            dst,\n            k + 1\n        );\n\n        return answer == INF\n            ? -1\n            : answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int findCheapestPrice(\n        int n,\n        vector<vector<int>>& flights,\n        int src,\n        int dst,\n        int k\n    ) {\n        const int INF = 1000000000;\n\n        vector<vector<int>> dp(\n            k + 2,\n            vector<int>(n, INF)\n        );\n\n        dp[0][src] = 0;\n\n        for (int edges = 1; edges <= k + 1; edges++) {\n            dp[edges] = dp[edges - 1];\n\n            for (const vector<int>& flight : flights) {\n                int from = flight[0];\n                int to = flight[1];\n                int price = flight[2];\n\n                if (dp[edges - 1][from] == INF) {\n                    continue;\n                }\n\n                dp[edges][to] = min(\n                    dp[edges][to],\n                    dp[edges - 1][from] + price\n                );\n            }\n        }\n\n        return dp[k + 1][dst] == INF\n            ? -1\n            : dp[k + 1][dst];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int findCheapestPrice(\n        int n,\n        vector<vector<int>>& flights,\n        int src,\n        int dst,\n        int k\n    ) {\n        const int INF = 1000000000;\n\n        vector<int> distance(\n            n,\n            INF\n        );\n\n        distance[src] = 0;\n\n        for (int edges = 0; edges <= k; edges++) {\n            vector<int> next = distance;\n\n            for (const vector<int>& flight : flights) {\n                int from = flight[0];\n                int to = flight[1];\n                int price = flight[2];\n\n                if (distance[from] == INF) {\n                    continue;\n                }\n\n                next[to] = min(\n                    next[to],\n                    distance[from] + price\n                );\n            }\n\n            distance = next;\n        }\n\n        return distance[dst] == INF\n            ? -1\n            : distance[dst];\n    }\n};"}}}]
