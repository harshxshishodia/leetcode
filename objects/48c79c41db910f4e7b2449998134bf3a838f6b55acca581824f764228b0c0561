[{"leetcode_no":139,"name":"Word Break","solutions":{"approach_1":{"cpp":"class Solution {\n    bool contains(const vector<string>& wordDict, const string& word) {\n        for (const string& candidate : wordDict) {\n            if (candidate == word) {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\n    bool solve(const string& s, const vector<string>& wordDict, int start) {\n        if (start == static_cast<int>(s.size())) {\n            return true;\n        }\n\n        for (int end = start; end < static_cast<int>(s.size()); end++) {\n            string word = s.substr(start, end - start + 1);\n\n            if (contains(wordDict, word) &&\n                solve(s, wordDict, end + 1)) {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\npublic:\n    bool wordBreak(string s, vector<string>& wordDict) {\n        return solve(s, wordDict, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    bool solve(\n        const string& s,\n        int start,\n        const unordered_set<string>& words,\n        vector<int>& memo\n    ) {\n        if (start == static_cast<int>(s.size())) {\n            return true;\n        }\n\n        if (memo[start] != -1) {\n            return memo[start];\n        }\n\n        for (int end = start; end < static_cast<int>(s.size()); end++) {\n            if (words.count(s.substr(start, end - start + 1)) &&\n                solve(s, end + 1, words, memo)) {\n                return memo[start] = 1;\n            }\n        }\n\n        return memo[start] = 0;\n    }\n\npublic:\n    bool wordBreak(string s, vector<string>& wordDict) {\n        unordered_set<string> words(wordDict.begin(), wordDict.end());\n        vector<int> memo(s.size(), -1);\n\n        return solve(s, 0, words, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool wordBreak(string s, vector<string>& wordDict) {\n        unordered_set<string> words(wordDict.begin(), wordDict.end());\n        int n = static_cast<int>(s.size());\n        vector<bool> dp(n + 1);\n        dp[0] = true;\n\n        for (int end = 1; end <= n; end++) {\n            for (int start = 0; start < end; start++) {\n                if (dp[start] &&\n                    words.count(s.substr(start, end - start))) {\n                    dp[end] = true;\n                    break;\n                }\n            }\n        }\n\n        return dp[n];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool wordBreak(string s, vector<string>& wordDict) {\n        unordered_set<string> words(wordDict.begin(), wordDict.end());\n        int n = static_cast<int>(s.size());\n        vector<bool> visited(n + 1);\n        queue<int> pending;\n        pending.push(0);\n\n        while (!pending.empty()) {\n            int start = pending.front();\n            pending.pop();\n\n            if (visited[start]) {\n                continue;\n            }\n\n            visited[start] = true;\n\n            for (int end = start + 1; end <= n; end++) {\n                if (!words.count(s.substr(start, end - start))) {\n                    continue;\n                }\n\n                if (end == n) {\n                    return true;\n                }\n\n                if (!visited[end]) {\n                    pending.push(end);\n                }\n            }\n        }\n\n        return false;\n    }\n};"},"approach_5":{"cpp":"class Solution {\n    struct Node {\n        array<int, 26> next;\n        bool terminal;\n\n        Node() : terminal(false) {\n            next.fill(-1);\n        }\n    };\n\npublic:\n    bool wordBreak(string s, vector<string>& wordDict) {\n        vector<Node> trie(1);\n\n        for (const string& word : wordDict) {\n            int node = 0;\n\n            for (char character : word) {\n                int index = character - 'a';\n\n                if (trie[node].next[index] == -1) {\n                    trie[node].next[index] = static_cast<int>(trie.size());\n                    trie.push_back(Node());\n                }\n\n                node = trie[node].next[index];\n            }\n\n            trie[node].terminal = true;\n        }\n\n        int n = static_cast<int>(s.size());\n        vector<bool> dp(n + 1);\n        dp[0] = true;\n\n        for (int start = 0; start < n; start++) {\n            if (!dp[start]) {\n                continue;\n            }\n\n            int node = 0;\n\n            for (int end = start; end < n; end++) {\n                int index = s[end] - 'a';\n\n                if (trie[node].next[index] == -1) {\n                    break;\n                }\n\n                node = trie[node].next[index];\n\n                if (trie[node].terminal) {\n                    dp[end + 1] = true;\n                }\n            }\n        }\n\n        return dp[n];\n    }\n};"}}}]
