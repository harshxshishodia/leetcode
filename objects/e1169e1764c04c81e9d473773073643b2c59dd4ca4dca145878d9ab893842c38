[{"leetcode_no":55,"name":"Jump Game","solutions":{"approach_1":{"cpp":"class Solution {\n    bool solve(const vector<int>& nums, int index) {\n        if (index >= static_cast<int>(nums.size()) - 1) {\n            return true;\n        }\n\n        int furthest = min(\n            static_cast<int>(nums.size()) - 1,\n            index + nums[index]\n        );\n\n        for (int next = index + 1; next <= furthest; next++) {\n            if (solve(nums, next)) {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\npublic:\n    bool canJump(vector<int>& nums) {\n        return solve(nums, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(const vector<int>& nums, int index, vector<int>& dp) {\n        if (index >= static_cast<int>(nums.size()) - 1) {\n            return 1;\n        }\n\n        if (dp[index] != -1) {\n            return dp[index];\n        }\n\n        int furthest = min(\n            static_cast<int>(nums.size()) - 1,\n            index + nums[index]\n        );\n\n        for (int next = index + 1; next <= furthest; next++) {\n            if (solve(nums, next, dp)) {\n                return dp[index] = 1;\n            }\n        }\n\n        return dp[index] = 0;\n    }\n\npublic:\n    bool canJump(vector<int>& nums) {\n        vector<int> dp(nums.size(), -1);\n        return solve(nums, 0, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool canJump(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<bool> dp(n);\n        dp[n - 1] = true;\n\n        for (int index = n - 2; index >= 0; index--) {\n            int furthest = min(n - 1, index + nums[index]);\n\n            for (int next = index + 1; next <= furthest; next++) {\n                if (dp[next]) {\n                    dp[index] = true;\n                    break;\n                }\n            }\n        }\n\n        return dp[0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool canJump(vector<int>& nums) {\n        int farthest = 0;\n\n        for (int i = 0; i < static_cast<int>(nums.size()); i++) {\n            if (i > farthest) {\n                return false;\n            }\n\n            farthest = max(farthest, i + nums[i]);\n\n            if (farthest >= static_cast<int>(nums.size()) - 1) {\n                return true;\n            }\n        }\n\n        return true;\n    }\n};"}}}]
