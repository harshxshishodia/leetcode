[{"leetcode_no":981,"name":"Time Based Key-Value Store","solutions":{"approach_1":{"cpp":"class TimeMap {\n    unordered_map<string, vector<pair<int, string>>> store;\n\npublic:\n    TimeMap() {}\n\n    void set(string key, string value, int timestamp) {\n        store[key].emplace_back(timestamp, value);\n    }\n\n    string get(string key, int timestamp) {\n        auto it = store.find(key);\n        if (it == store.end()) return \"\";\n\n        const auto& records = it->second;\n        int left = 0, right = static_cast<int>(records.size()) - 1;\n        int matchedIndex = -1;\n\n        while (left <= right) {\n            int mid = left + (right - left) / 2;\n            if (records[mid].first <= timestamp) {\n                matchedIndex = mid;\n                left = mid + 1;\n            } else {\n                right = mid - 1;\n            }\n        }\n        return matchedIndex == -1 ? \"\" : records[matchedIndex].second;\n    }\n};"}}}]
