[{"leetcode_no":877,"name":"Stone Game","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& piles,\n        int left,\n        int right\n    ) {\n        if (left == right) {\n            return piles[left];\n        }\n\n        return max(\n            piles[left] -\n            solve(\n                piles,\n                left + 1,\n                right\n            ),\n            piles[right] -\n            solve(\n                piles,\n                left,\n                right - 1\n            )\n        );\n    }\n\npublic:\n    bool stoneGame(vector<int>& piles) {\n        return solve(\n            piles,\n            0,\n            static_cast<int>(piles.size()) - 1\n        ) > 0;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& piles,\n        int left,\n        int right,\n        vector<vector<int>>& memo\n    ) {\n        if (left == right) {\n            return piles[left];\n        }\n\n        if (memo[left][right] != numeric_limits<int>::min()) {\n            return memo[left][right];\n        }\n\n        memo[left][right] = max(\n            piles[left] -\n            solve(\n                piles,\n                left + 1,\n                right,\n                memo\n            ),\n            piles[right] -\n            solve(\n                piles,\n                left,\n                right - 1,\n                memo\n            )\n        );\n\n        return memo[left][right];\n    }\n\npublic:\n    bool stoneGame(vector<int>& piles) {\n        int n = static_cast<int>(piles.size());\n\n        vector<vector<int>> memo(\n            n,\n            vector<int>(\n                n,\n                numeric_limits<int>::min()\n            )\n        );\n\n        return solve(\n            piles,\n            0,\n            n - 1,\n            memo\n        ) > 0;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool stoneGame(vector<int>& piles) {\n        int n = static_cast<int>(piles.size());\n\n        vector<vector<int>> dp(\n            n,\n            vector<int>(n)\n        );\n\n        for (int i = 0; i < n; i++) {\n            dp[i][i] = piles[i];\n        }\n\n        for (int length = 2; length <= n; length++) {\n            for (int left = 0;\n                 left + length <= n;\n                 left++) {\n                int right =\n                    left + length - 1;\n\n                dp[left][right] = max(\n                    piles[left] -\n                    dp[left + 1][right],\n                    piles[right] -\n                    dp[left][right - 1]\n                );\n            }\n        }\n\n        return dp[0][n - 1] > 0;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool stoneGame(vector<int>& piles) {\n        int n = static_cast<int>(piles.size());\n        vector<int> dp = piles;\n\n        for (int length = 2; length <= n; length++) {\n            for (int left = 0;\n                 left + length <= n;\n                 left++) {\n                int right =\n                    left + length - 1;\n\n                dp[left] = max(\n                    piles[left] -\n                    dp[left + 1],\n                    piles[right] -\n                    dp[left]\n                );\n            }\n        }\n\n        return dp[0] > 0;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    bool stoneGame(vector<int>& piles) {\n        return true;\n    }\n};"}}}]
