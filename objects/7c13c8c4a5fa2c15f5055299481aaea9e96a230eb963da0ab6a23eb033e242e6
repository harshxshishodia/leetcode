[{"leetcode_no":284,"name":"Peeking Iterator","solutions":{"approach_1":{"cpp":"class Iterator {\n    struct Data;\n    Data* data;\npublic:\n    Iterator(const vector<int>& nums);\n    Iterator(const Iterator& iter);\n    int next();\n    bool hasNext() const;\n};\n\nclass PeekingIterator : public Iterator {\n    int cachedNextValue;\n    bool hasNextFlag;\n\npublic:\n    PeekingIterator(const vector<int>& nums) : Iterator(nums) {\n        hasNextFlag = Iterator::hasNext();\n        if (hasNextFlag) {\n            cachedNextValue = Iterator::next();\n        }\n    }\n\n    int peek() {\n        return cachedNextValue;\n    }\n\n    int next() {\n        int result = cachedNextValue;\n        hasNextFlag = Iterator::hasNext();\n        if (hasNextFlag) {\n            cachedNextValue = Iterator::next();\n        }\n        return result;\n    }\n\n    bool hasNext() const {\n        return hasNextFlag;\n    }\n};"}}}]
