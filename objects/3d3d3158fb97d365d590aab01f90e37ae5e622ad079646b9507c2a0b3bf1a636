[{"leetcode_no":146,"name":"LRU Cache","solutions":{"approach_1":{"cpp":"class LRUCache {\n    struct CacheNode {\n        int key;\n        int value;\n        int accessTimestamp;\n    };\n\n    vector<CacheNode> cacheStorage;\n    int cacheCapacity;\n    int currentTimer;\n\npublic:\n    LRUCache(int capacity) : cacheCapacity(capacity), currentTimer(0) {}\n\n    int get(int key) {\n        currentTimer++;\n        for (auto& item : cacheStorage) {\n            if (item.key == key) {\n                item.accessTimestamp = currentTimer;\n                return item.value;\n            }\n        }\n        return -1;\n    }\n\n    void put(int key, int value) {\n        currentTimer++;\n        for (auto& item : cacheStorage) {\n            if (item.key == key) {\n                item.value = value;\n                item.accessTimestamp = currentTimer;\n                return;\n            }\n        }\n\n        if (static_cast<int>(cacheStorage.size()) == cacheCapacity) {\n            int oldestIndex = 0;\n            for (int i = 1; i < static_cast<int>(cacheStorage.size()); i++) {\n                if (cacheStorage[i].accessTimestamp < cacheStorage[oldestIndex].accessTimestamp) {\n                    oldestIndex = i;\n                }\n            }\n            cacheStorage.erase(cacheStorage.begin() + oldestIndex);\n        }\n\n        cacheStorage.push_back({key, value, currentTimer});\n    }\n};"},"approach_2":{"cpp":"class LRUCache {\n    int capacity;\n    list<pair<int, int>> cacheList; // pair of (key, value)\n    unordered_map<int, list<pair<int, int>>::iterator> keyToIterator;\n\npublic:\n    LRUCache(int cap) : capacity(cap) {}\n\n    int get(int key) {\n        auto it = keyToIterator.find(key);\n        if (it == keyToIterator.end()) {\n            return -1;\n        }\n        cacheList.splice(cacheList.begin(), cacheList, it->second);\n        return it->second->second;\n    }\n\n    void put(int key, int value) {\n        auto it = keyToIterator.find(key);\n        if (it != keyToIterator.end()) {\n            cacheList.splice(cacheList.begin(), cacheList, it->second);\n            it->second->second = value;\n            return;\n        }\n\n        if (static_cast<int>(keyToIterator.size()) == capacity) {\n            int lruKey = cacheList.back().first;\n            cacheList.pop_back();\n            keyToIterator.erase(lruKey);\n        }\n\n        cacheList.emplace_front(key, value);\n        keyToIterator[key] = cacheList.begin();\n    }\n};"}}}]
