[{"leetcode_no":746,"name":"Min Cost Climbing Stairs","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(vector<int>& cost, int index) {\n        if (index >= static_cast<int>(cost.size())) {\n            return 0;\n        }\n\n        return cost[index] + min(solve(cost, index + 1), solve(cost, index + 2));\n    }\n\npublic:\n    int minCostClimbingStairs(vector<int>& cost) {\n        return min(solve(cost, 0), solve(cost, 1));\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(vector<int>& cost, int index, vector<int>& dp) {\n        if (index >= static_cast<int>(cost.size())) {\n            return 0;\n        }\n\n        if (dp[index] != -1) {\n            return dp[index];\n        }\n\n        dp[index] = cost[index] + min(\n            solve(cost, index + 1, dp),\n            solve(cost, index + 2, dp)\n        );\n\n        return dp[index];\n    }\n\npublic:\n    int minCostClimbingStairs(vector<int>& cost) {\n        vector<int> dp(cost.size(), -1);\n        return min(solve(cost, 0, dp), solve(cost, 1, dp));\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minCostClimbingStairs(vector<int>& cost) {\n        int n = static_cast<int>(cost.size());\n        vector<int> dp(n + 1);\n\n        for (int i = 2; i <= n; i++) {\n            dp[i] = min(\n                dp[i - 1] + cost[i - 1],\n                dp[i - 2] + cost[i - 2]\n            );\n        }\n\n        return dp[n];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minCostClimbingStairs(vector<int>& cost) {\n        int previous2 = 0;\n        int previous1 = 0;\n\n        for (int i = 2; i <= static_cast<int>(cost.size()); i++) {\n            int current = min(\n                previous1 + cost[i - 1],\n                previous2 + cost[i - 2]\n            );\n\n            previous2 = previous1;\n            previous1 = current;\n        }\n\n        return previous1;\n    }\n};"}}}]
