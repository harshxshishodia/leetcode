[{"leetcode_no":542,"name":"01 Matrix","solutions":{"approach_1":{"cpp":"class Solution {\n    int distanceToZero(\n        const vector<vector<int>>& mat,\n        int startRow,\n        int startCol\n    ) {\n        if (mat[startRow][startCol] == 0) {\n            return 0;\n        }\n\n        int rows = static_cast<int>(mat.size());\n        int cols = static_cast<int>(mat[0].size());\n\n        queue<pair<int, int>> pending;\n        vector<vector<bool>> visited(\n            rows,\n            vector<bool>(cols)\n        );\n\n        pending.push({startRow, startCol});\n        visited[startRow][startCol] = true;\n        int distance = 0;\n\n        array<int, 4> rowChange = {-1, 1, 0, 0};\n        array<int, 4> colChange = {0, 0, -1, 1};\n\n        while (!pending.empty()) {\n            int levelSize = static_cast<int>(pending.size());\n            distance++;\n\n            for (int i = 0; i < levelSize; i++) {\n                auto [row, col] = pending.front();\n                pending.pop();\n\n                for (int direction = 0; direction < 4; direction++) {\n                    int nextRow = row + rowChange[direction];\n                    int nextCol = col + colChange[direction];\n\n                    if (nextRow < 0 ||\n                        nextRow >= rows ||\n                        nextCol < 0 ||\n                        nextCol >= cols ||\n                        visited[nextRow][nextCol]) {\n                        continue;\n                    }\n\n                    if (mat[nextRow][nextCol] == 0) {\n                        return distance;\n                    }\n\n                    visited[nextRow][nextCol] = true;\n                    pending.push({nextRow, nextCol});\n                }\n            }\n        }\n\n        return distance;\n    }\n\npublic:\n    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {\n        int rows = static_cast<int>(mat.size());\n        int cols = static_cast<int>(mat[0].size());\n        vector<vector<int>> answer(\n            rows,\n            vector<int>(cols)\n        );\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                answer[row][col] =\n                    distanceToZero(mat, row, col);\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {\n        int rows = static_cast<int>(mat.size());\n        int cols = static_cast<int>(mat[0].size());\n        vector<vector<int>> distance(\n            rows,\n            vector<int>(cols, -1)\n        );\n\n        queue<pair<int, int>> pending;\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                if (mat[row][col] == 0) {\n                    distance[row][col] = 0;\n                    pending.push({row, col});\n                }\n            }\n        }\n\n        array<int, 4> rowChange = {-1, 1, 0, 0};\n        array<int, 4> colChange = {0, 0, -1, 1};\n\n        while (!pending.empty()) {\n            auto [row, col] = pending.front();\n            pending.pop();\n\n            for (int direction = 0; direction < 4; direction++) {\n                int nextRow = row + rowChange[direction];\n                int nextCol = col + colChange[direction];\n\n                if (nextRow < 0 ||\n                    nextRow >= rows ||\n                    nextCol < 0 ||\n                    nextCol >= cols ||\n                    distance[nextRow][nextCol] != -1) {\n                    continue;\n                }\n\n                distance[nextRow][nextCol] =\n                    distance[row][col] + 1;\n\n                pending.push({nextRow, nextCol});\n            }\n        }\n\n        return distance;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    vector<vector<int>> updateMatrix(vector<vector<int>>& mat) {\n        int rows = static_cast<int>(mat.size());\n        int cols = static_cast<int>(mat[0].size());\n        int infinity = rows + cols + 1;\n\n        vector<vector<int>> distance(\n            rows,\n            vector<int>(cols, infinity)\n        );\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                if (mat[row][col] == 0) {\n                    distance[row][col] = 0;\n                    continue;\n                }\n\n                if (row > 0) {\n                    distance[row][col] = min(\n                        distance[row][col],\n                        distance[row - 1][col] + 1\n                    );\n                }\n\n                if (col > 0) {\n                    distance[row][col] = min(\n                        distance[row][col],\n                        distance[row][col - 1] + 1\n                    );\n                }\n            }\n        }\n\n        for (int row = rows - 1; row >= 0; row--) {\n            for (int col = cols - 1; col >= 0; col--) {\n                if (row + 1 < rows) {\n                    distance[row][col] = min(\n                        distance[row][col],\n                        distance[row + 1][col] + 1\n                    );\n                }\n\n                if (col + 1 < cols) {\n                    distance[row][col] = min(\n                        distance[row][col],\n                        distance[row][col + 1] + 1\n                    );\n                }\n            }\n        }\n\n        return distance;\n    }\n};"}}}]
