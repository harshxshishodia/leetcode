[{"leetcode_no":894,"name":"All Possible Full Binary Trees","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    vector<TreeNode*> allPossibleFBT(int n) {\n        if (n % 2 == 0) {\n            return {};\n        }\n\n        if (n == 1) {\n            return {\n                new TreeNode(0)\n            };\n        }\n\n        vector<TreeNode*> answer;\n\n        for (int leftNodes = 1;\n             leftNodes < n;\n             leftNodes += 2) {\n            int rightNodes =\n                n - 1 - leftNodes;\n\n            vector<TreeNode*> leftTrees =\n                allPossibleFBT(leftNodes);\n\n            vector<TreeNode*> rightTrees =\n                allPossibleFBT(rightNodes);\n\n            for (TreeNode* left : leftTrees) {\n                for (TreeNode* right : rightTrees) {\n                    TreeNode* root =\n                        new TreeNode(0);\n\n                    root->left = left;\n                    root->right = right;\n\n                    answer.push_back(root);\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    unordered_map<int, vector<TreeNode*>> memo;\n\n    vector<TreeNode*> solve(int n) {\n        auto found =\n            memo.find(n);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        if (n == 1) {\n            return {\n                new TreeNode(0)\n            };\n        }\n\n        vector<TreeNode*> answer;\n\n        for (int leftNodes = 1;\n             leftNodes < n;\n             leftNodes += 2) {\n            int rightNodes =\n                n - 1 - leftNodes;\n\n            vector<TreeNode*> leftTrees =\n                solve(leftNodes);\n\n            vector<TreeNode*> rightTrees =\n                solve(rightNodes);\n\n            for (TreeNode* left : leftTrees) {\n                for (TreeNode* right : rightTrees) {\n                    TreeNode* root =\n                        new TreeNode(0);\n\n                    root->left = left;\n                    root->right = right;\n\n                    answer.push_back(root);\n                }\n            }\n        }\n\n        memo[n] = answer;\n        return memo[n];\n    }\n\npublic:\n    vector<TreeNode*> allPossibleFBT(int n) {\n        if (n % 2 == 0) {\n            return {};\n        }\n\n        memo.clear();\n\n        return solve(n);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    vector<TreeNode*> allPossibleFBT(int n) {\n        if (n % 2 == 0) {\n            return {};\n        }\n\n        vector<vector<TreeNode*>> dp(\n            n + 1\n        );\n\n        dp[1].push_back(\n            new TreeNode(0)\n        );\n\n        for (int nodes = 3;\n             nodes <= n;\n             nodes += 2) {\n            for (int leftNodes = 1;\n                 leftNodes < nodes;\n                 leftNodes += 2) {\n                int rightNodes =\n                    nodes - 1 - leftNodes;\n\n                for (TreeNode* left : dp[leftNodes]) {\n                    for (TreeNode* right : dp[rightNodes]) {\n                        TreeNode* root =\n                            new TreeNode(0);\n\n                        root->left = left;\n                        root->right = right;\n\n                        dp[nodes].push_back(root);\n                    }\n                }\n            }\n        }\n\n        return dp[n];\n    }\n};"}}}]
