[{"leetcode_no":397,"name":"Integer Replacement","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(long long n) {\n        if (n == 1) {\n            return 0;\n        }\n\n        if (n % 2 == 0) {\n            return 1 + solve(n / 2);\n        }\n\n        return 1 + min(\n            solve(n - 1),\n            solve(n + 1)\n        );\n    }\n\npublic:\n    int integerReplacement(int n) {\n        return solve(n);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        long long n,\n        unordered_map<long long, int>& memo\n    ) {\n        if (n == 1) {\n            return 0;\n        }\n\n        auto found = memo.find(n);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        int answer;\n\n        if (n % 2 == 0) {\n            answer = 1 + solve(n / 2, memo);\n        } else {\n            answer = 1 + min(\n                solve(n - 1, memo),\n                solve(n + 1, memo)\n            );\n        }\n\n        memo[n] = answer;\n        return answer;\n    }\n\npublic:\n    int integerReplacement(int n) {\n        unordered_map<long long, int> memo;\n        return solve(n, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int integerReplacement(int n) {\n        queue<pair<long long, int>> pending;\n        unordered_set<long long> visited;\n\n        pending.push({n, 0});\n        visited.insert(n);\n\n        while (!pending.empty()) {\n            auto [value, steps] = pending.front();\n            pending.pop();\n\n            if (value == 1) {\n                return steps;\n            }\n\n            if (value % 2 == 0) {\n                long long next = value / 2;\n\n                if (visited.insert(next).second) {\n                    pending.push({next, steps + 1});\n                }\n            } else {\n                long long smaller = value - 1;\n                long long larger = value + 1;\n\n                if (visited.insert(smaller).second) {\n                    pending.push({smaller, steps + 1});\n                }\n\n                if (visited.insert(larger).second) {\n                    pending.push({larger, steps + 1});\n                }\n            }\n        }\n\n        return 0;\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    int solve(\n        long long n,\n        unordered_map<long long, int>& memo\n    ) {\n        if (n == 1) {\n            return 0;\n        }\n\n        auto found = memo.find(n);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        int answer;\n\n        if (n % 2 == 0) {\n            answer = 1 + solve(n / 2, memo);\n        } else {\n            answer = 2 + min(\n                solve(n / 2, memo),\n                solve(n / 2 + 1, memo)\n            );\n        }\n\n        memo[n] = answer;\n        return answer;\n    }\n\npublic:\n    int integerReplacement(int n) {\n        unordered_map<long long, int> memo;\n        return solve(n, memo);\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int integerReplacement(int n) {\n        long long value = n;\n        int steps = 0;\n\n        while (value != 1) {\n            if (value % 2 == 0) {\n                value /= 2;\n            } else if (value == 3 || value % 4 == 1) {\n                value--;\n            } else {\n                value++;\n            }\n\n            steps++;\n        }\n\n        return steps;\n    }\n};"}}}]
