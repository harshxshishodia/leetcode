[{"leetcode_no":978,"name":"Longest Turbulent Subarray","solutions":{"approach_1":{"cpp":"class Solution {\n    bool turbulent(\n        const vector<int>& arr,\n        int left,\n        int right\n    ) {\n        for (int i = left + 1; i <= right; i++) {\n            if (arr[i] == arr[i - 1]) {\n                return false;\n            }\n\n            if (i >= left + 2) {\n                long long first =\n                    static_cast<long long>(arr[i - 1]) -\n                    arr[i - 2];\n\n                long long second =\n                    static_cast<long long>(arr[i]) -\n                    arr[i - 1];\n\n                if ((first > 0) == (second > 0)) {\n                    return false;\n                }\n            }\n        }\n\n        return true;\n    }\n\npublic:\n    int maxTurbulenceSize(vector<int>& arr) {\n        int n = static_cast<int>(arr.size());\n        int answer = 1;\n\n        for (int left = 0; left < n; left++) {\n            for (int right = left; right < n; right++) {\n                if (turbulent(\n                        arr,\n                        left,\n                        right)) {\n                    answer = max(\n                        answer,\n                        right - left + 1\n                    );\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int maxTurbulenceSize(vector<int>& arr) {\n        int n = static_cast<int>(arr.size());\n        int answer = 1;\n\n        for (int left = 0; left < n; left++) {\n            int previousSign = 0;\n\n            for (int right = left + 1; right < n; right++) {\n                int sign =\n                    arr[right] > arr[right - 1]\n                        ? 1\n                        : arr[right] < arr[right - 1]\n                            ? -1\n                            : 0;\n\n                if (sign == 0 ||\n                    sign == previousSign) {\n                    break;\n                }\n\n                answer = max(\n                    answer,\n                    right - left + 1\n                );\n\n                previousSign = sign;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxTurbulenceSize(vector<int>& arr) {\n        int up = 1;\n        int down = 1;\n        int answer = 1;\n\n        for (int i = 1; i < static_cast<int>(arr.size()); i++) {\n            if (arr[i] > arr[i - 1]) {\n                up = down + 1;\n                down = 1;\n            } else if (arr[i] < arr[i - 1]) {\n                down = up + 1;\n                up = 1;\n            } else {\n                up = 1;\n                down = 1;\n            }\n\n            answer = max({\n                answer,\n                up,\n                down\n            });\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxTurbulenceSize(vector<int>& arr) {\n        int n = static_cast<int>(arr.size());\n        int left = 0;\n        int answer = 1;\n\n        for (int right = 1; right < n; right++) {\n            int comparison =\n                arr[right - 1] < arr[right]\n                    ? -1\n                    : arr[right - 1] > arr[right]\n                        ? 1\n                        : 0;\n\n            if (comparison == 0) {\n                left = right;\n            } else if (right == n - 1 ||\n                       comparison *\n                       (\n                           arr[right] < arr[right + 1]\n                               ? -1\n                               : arr[right] > arr[right + 1]\n                                   ? 1\n                                   : 0\n                       ) != -1) {\n                answer = max(\n                    answer,\n                    right - left + 1\n                );\n\n               