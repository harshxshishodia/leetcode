[{"leetcode_no":300,"name":"Longest Increasing Subsequence","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int previousIndex\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        int skip = solve(nums, index + 1, previousIndex);\n        int take = 0;\n\n        if (previousIndex == -1 ||\n            nums[index] > nums[previousIndex]) {\n            take = 1 + solve(nums, index + 1, index);\n        }\n\n        return max(skip, take);\n    }\n\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        return solve(nums, 0, -1);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int previousIndex,\n        vector<vector<int>>& memo\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        int previousState = previousIndex + 1;\n\n        if (memo[index][previousState] != -1) {\n            return memo[index][previousState];\n        }\n\n        int skip = solve(\n            nums,\n            index + 1,\n            previousIndex,\n            memo\n        );\n\n        int take = 0;\n\n        if (previousIndex == -1 ||\n            nums[index] > nums[previousIndex]) {\n            take = 1 + solve(\n                nums,\n                index + 1,\n                index,\n                memo\n            );\n        }\n\n        memo[index][previousState] = max(skip, take);\n        return memo[index][previousState];\n    }\n\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<vector<int>> memo(\n            n,\n            vector<int>(n + 1, -1)\n        );\n\n        return solve(nums, 0, -1, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<vector<int>> dp(\n            n + 1,\n            vector<int>(n + 1)\n        );\n\n        for (int index = n - 1; index >= 0; index--) {\n            for (int previousIndex = index - 1;\n                 previousIndex >= -1;\n                 previousIndex--) {\n                int skip = dp[index + 1][previousIndex + 1];\n                int take = 0;\n\n                if (previousIndex == -1 ||\n                    nums[index] > nums[previousIndex]) {\n                    take = 1 + dp[index + 1][index + 1];\n                }\n\n                dp[index][previousIndex + 1] = max(skip, take);\n            }\n        }\n\n        return dp[0][0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<int> dp(n, 1);\n        int answer = 1;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (nums[j] < nums[i]) {\n                    dp[i] = max(dp[i], dp[j] + 1);\n                }\n            }\n\n            answer = max(answer, dp[i]);\n        }\n\n        return answer;\n    }\n};"},"approach_5":{"cpp":"class Solution {\n    struct Fenwick {\n        vector<int> tree;\n\n        Fenwick(int size) : tree(size + 1) {}\n\n        void update(int index, int value) {\n            while (index < static_cast<int>(tree.size())) {\n                tree[index] = max(tree[index], value);\n                index += index & -index;\n            }\n        }\n\n        int query(int index) {\n            int answer = 0;\n\n            while (index > 0) {\n                answer = max(answer, tree[index]);\n                index -= index & -index;\n            }\n\n            return answer;\n        }\n    };\n\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        vector<int> values = nums;\n        sort(values.begin(), values.end());\n        values.erase(unique(values.begin(), values.end()), values.end());\n\n        Fenwick fenwick(values.size());\n        int answer = 0;\n\n        for (int number : nums) {\n            int rank = static_cast<int>(\n                lower_bound(values.begin(), values.end(), number) -\n                values.begin()\n            ) + 1;\n\n            int current = 1 + fenwick.query(rank - 1);\n            fenwick.update(rank, current);\n            answer = max(answer, current);\n        }\n\n        return answer;\n    }\n};"},"approach_6":{"cpp":"class Solution {\npublic:\n    int lengthOfLIS(vector<int>& nums) {\n        vector<int> tails;\n\n        for (int number : nums) {\n            auto position = lower_bound(\n                tails.begin(),\n                tails.end(),\n                number\n            );\n\n            if (position == tails.end()) {\n                tails.push_back(number);\n            } else {\n                *position = number;\n            }\n        }\n\n        return static_cast<int>(tails.size());\n    }\n};"}}}]
