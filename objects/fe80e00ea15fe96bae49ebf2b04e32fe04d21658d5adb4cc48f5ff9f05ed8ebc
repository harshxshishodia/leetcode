[{"leetcode_no":22,"name":"Generate Parentheses","solutions":{"approach_1":{"cpp":"class Solution {\n    bool valid(const string& current) {\n        int balance = 0;\n\n        for (char character : current) {\n            if (character == '(') {\n                balance++;\n            } else {\n                balance--;\n            }\n\n            if (balance < 0) {\n                return false;\n            }\n        }\n\n        return balance == 0;\n    }\n\n    void generate(int n, string& current, vector<string>& answer) {\n        if (static_cast<int>(current.size()) == 2 * n) {\n            if (valid(current)) {\n                answer.push_back(current);\n            }\n\n            return;\n        }\n\n        current.push_back('(');\n        generate(n, current, answer);\n        current.pop_back();\n\n        current.push_back(')');\n        generate(n, current, answer);\n        current.pop_back();\n    }\n\npublic:\n    vector<string> generateParenthesis(int n) {\n        vector<string> answer;\n        string current;\n        generate(n, current, answer);\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    vector<string> solve(\n        int open,\n        int close,\n        int n,\n        vector<vector<vector<string>>>& dp,\n        vector<vector<bool>>& visited\n    ) {\n        if (open == n && close == n) {\n            return {\"\"};\n        }\n\n        if (visited[open][close]) {\n            return dp[open][close];\n        }\n\n        visited[open][close] = true;\n        vector<string> answer;\n\n        if (open < n) {\n            vector<string> suffixes = solve(open + 1, close, n, dp, visited);\n\n            for (string& suffix : suffixes) {\n                answer.push_back(\"(\" + suffix);\n            }\n        }\n\n        if (close < open) {\n            vector<string> suffixes = solve(open, close + 1, n, dp, visited);\n\n            for (string& suffix : suffixes) {\n                answer.push_back(\")\" + suffix);\n            }\n        }\n\n        dp[open][close] = answer;\n        return dp[open][close];\n    }\n\npublic:\n    vector<string> generateParenthesis(int n) {\n        vector<vector<vector<string>>> dp(\n            n + 1,\n            vector<vector<string>>(n + 1)\n        );\n        vector<vector<bool>> visited(n + 1, vector<bool>(n + 1));\n\n        return solve(0, 0, n, dp, visited);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    vector<string> generateParenthesis(int n) {\n        vector<vector<string>> dp(n + 1);\n        dp[0] = {\"\"};\n\n        for (int pairs = 1; pairs <= n; pairs++) {\n            for (int leftPairs = 0; leftPairs < pairs; leftPairs++) {\n                int rightPairs = pairs - 1 - leftPairs;\n\n                for (const string& left : dp[leftPairs]) {\n                    for (const string& right : dp[rightPairs]) {\n                        dp[pairs].push_back(\"(\" + left + \")\" + right);\n                    }\n                }\n            }\n        }\n\n        return dp[n];\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    void backtrack(\n        int n,\n        int open,\n        int close,\n        string& current,\n        vector<string>& answer\n    ) {\n        if (open == n && close == n) {\n            answer.push_back(current);\n            return;\n        }\n\n        if (open < n) {\n            current.push_back('(');\n            backtrack(n, open + 1, close, current, answer);\n            current.pop_back();\n        }\n\n        if (close < open) {\n            current.push_back(')');\n            backtrack(n, open, close + 1, current, answer);\n            current.pop_back();\n        }\n    }\n\npublic:\n    vector<string> generateParenthesis(int n) {\n        vector<string> answer;\n        string current;\n        backtrack(n, 0, 0, current, answer);\n        return answer;\n    }\n};"}}}]
