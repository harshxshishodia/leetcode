[{"leetcode_no":418,"name":"Sentence Screen Fitting","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int wordsTyping(vector<string>& sentence, int rows, int cols) {\n        int word = 0;\n        int completed = 0;\n\n        for (int row = 0; row < rows; row++) {\n            int col = 0;\n\n            while (col < cols) {\n                int length = static_cast<int>(sentence[word].size());\n\n                if (col + length > cols) {\n                    break;\n                }\n\n                col += length;\n\n                if (col < cols) {\n                    col++;\n                }\n\n                word++;\n\n                if (word == static_cast<int>(sentence.size())) {\n                    word = 0;\n                    completed++;\n                }\n            }\n        }\n\n        return completed;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int wordsTyping(vector<string>& sentence, int rows, int cols) {\n        int n = static_cast<int>(sentence.size());\n        vector<int> nextWord(n);\n        vector<int> completed(n);\n\n        for (int start = 0; start < n; start++) {\n            int col = 0;\n            int word = start;\n            int count = 0;\n\n            while (col + static_cast<int>(sentence[word].size()) <= cols) {\n                col += static_cast<int>(sentence[word].size()) + 1;\n                word++;\n\n                if (word == n) {\n                    word = 0;\n                    count++;\n                }\n            }\n\n            nextWord[start] = word;\n            completed[start] = count;\n        }\n\n        int word = 0;\n        int answer = 0;\n\n        for (int row = 0; row < rows; row++) {\n            answer += completed[word];\n            word = nextWord[word];\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int wordsTyping(vector<string>& sentence, int rows, int cols) {\n        string joined;\n\n        for (const string& word : sentence) {\n            joined += word;\n            joined += ' ';\n        }\n\n        int length = static_cast<int>(joined.size());\n        long long position = 0;\n\n        for (int row = 0; row < rows; row++) {\n            position += cols;\n\n            if (joined[position % length] == ' ') {\n                position++;\n            } else {\n                while (position > 0 &&\n                       joined[(position - 1) % length] != ' ') {\n                    position--;\n                }\n            }\n        }\n\n        return static_cast<int>(position / length);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int wordsTyping(vector<string>& sentence, int rows, int cols) {\n        string joined;\n\n        for (const string& word : sentence) {\n            joined += word;\n            joined += ' ';\n        }\n\n        int length = static_cast<int>(joined.size());\n        vector<int> adjustment(length);\n\n        for (int i = 1; i < length; i++) {\n            adjustment[i] = adjustment[i - 1];\n\n            if (joined[i] == ' ') {\n                adjustment[i] = 1;\n            } else {\n                adjustment[i]--;\n            }\n        }\n\n        long long position = 0;\n\n        for (int row = 0; row < rows; row++) {\n            position += cols;\n            position += adjustment[position % length];\n        }\n\n        return static_cast<int>(position / length);\n    }\n};"}}}]
