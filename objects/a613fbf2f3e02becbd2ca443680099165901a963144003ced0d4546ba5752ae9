[{"leetcode_no":341,"name":"Flatten Nested List Iterator","solutions":{"approach_1":{"cpp":"class NestedInteger {\npublic:\n    bool isInteger() const;\n    int getInteger() const;\n    const vector<NestedInteger> &getList() const;\n};\n\nclass NestedIterator {\n    vector<int> flattenedList;\n    int currentIndex;\n\n    void flatten(const vector<NestedInteger>& nestedList) {\n        for (const auto& item : nestedList) {\n            if (item.isInteger()) {\n                flattenedList.push_back(item.getInteger());\n            } else {\n                flatten(item.getList());\n            }\n        }\n    }\n\npublic:\n    NestedIterator(vector<NestedInteger> &nestedList) : currentIndex(0) {\n        flatten(nestedList);\n    }\n\n    int next() {\n        return flattenedList[currentIndex++];\n    }\n\n    bool hasNext() {\n        return currentIndex < static_cast<int>(flattenedList.size());\n    }\n};"},"approach_2":{"cpp":"class NestedInteger {\npublic:\n    bool isInteger() const;\n    int getInteger() const;\n    const vector<NestedInteger> &getList() const;\n};\n\nclass NestedIterator {\n    using IteratorType = vector<NestedInteger>::const_iterator;\n    stack<pair<IteratorType, IteratorType>> iteratorStack;\n\npublic:\n    NestedIterator(vector<NestedInteger> &nestedList) {\n        iteratorStack.push({nestedList.cbegin(), nestedList.cend()});\n    }\n\n    int next() {\n        hasNext();\n        return (iteratorStack.top().first++)->getInteger();\n    }\n\n    bool hasNext() {\n        while (!iteratorStack.empty()) {\n            if (iteratorStack.top().first == iteratorStack.top().second) {\n                iteratorStack.pop();\n            } else {\n                auto it = iteratorStack.top().first;\n                if (it->isInteger()) {\n                    return true;\n                }\n                iteratorStack.top().first++;\n                iteratorStack.push({it->getList().cbegin(), it->getList().cend()});\n            }\n        }\n        return false;\n    }\n};"}}}]
