[{"leetcode_no":673,"name":"Number of Longest Increasing Subsequence","solutions":{"approach_1":{"cpp":"class Solution {\n    int bestLength;\n    int count;\n\n    bool increasing(const vector<int>& sequence) {\n        for (int i = 1; i < static_cast<int>(sequence.size()); i++) {\n            if (sequence[i] <= sequence[i - 1]) {\n                return false;\n            }\n        }\n\n        return true;\n    }\n\n    void search(\n        const vector<int>& nums,\n        int index,\n        vector<int>& current\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            if (!increasing(current)) {\n                return;\n            }\n\n            int length = static_cast<int>(current.size());\n\n            if (length > bestLength) {\n                bestLength = length;\n                count = 1;\n            } else if (length == bestLength) {\n                count++;\n            }\n\n            return;\n        }\n\n        search(\n            nums,\n            index + 1,\n            current\n        );\n\n        current.push_back(nums[index]);\n\n        search(\n            nums,\n            index + 1,\n            current\n        );\n\n        current.pop_back();\n    }\n\npublic:\n    int findNumberOfLIS(vector<int>& nums) {\n        bestLength = 0;\n        count = 0;\n        vector<int> current;\n\n        search(\n            nums,\n            0,\n            current\n        );\n\n        return count;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    pair<int, int> solve(\n        const vector<int>& nums,\n        int index\n    ) {\n        int bestLength = 1;\n        int count = 1;\n\n        for (int next = index + 1;\n             next < static_cast<int>(nums.size());\n             next++) {\n            if (nums[next] <= nums[index]) {\n                continue;\n            }\n\n            auto [nextLength, nextCount] =\n                solve(nums, next);\n\n            int candidateLength =\n                1 + nextLength;\n\n            if (candidateLength > bestLength) {\n                bestLength = candidateLength;\n                count = nextCount;\n            } else if (candidateLength == bestLength) {\n                count += nextCount;\n            }\n        }\n\n        return {\n            bestLength,\n            count\n        };\n    }\n\npublic:\n    int findNumberOfLIS(vector<int>& nums) {\n        int bestLength = 0;\n        int answer = 0;\n\n        for (int i = 0; i < static_cast<int>(nums.size()); i++) {\n            auto [length, count] = solve(nums, i);\n\n            if (length > bestLength) {\n                bestLength = length;\n                answer = count;\n            } else if (length == bestLength) {\n                answer += count;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    vector<pair<int, int>> memo;\n    vector<bool> visited;\n\n    pair<int, int> solve(\n        const vector<int>& nums,\n        int index\n    ) {\n        if (visited[index]) {\n            return memo[index];\n        }\n\n        visited[index] = true;\n\n        int bestLength = 1;\n        int count = 1;\n\n        for (int next = index + 1;\n             next < static_cast<int>(nums.size());\n             next++) {\n            if (nums[next] <= nums[index]) {\n                continue;\n            }\n\n            auto [nextLength, nextCount] =\n                solve(nums, next);\n\n            int candidateLength =\n                1 + nextLength;\n\n            if (candidateLength > bestLength) {\n                bestLength = candidateLength;\n                count = nextCount;\n            } else if (candidateLength == bestLength) {\n                count += nextCount;\n            }\n        }\n\n        memo[index] = {\n            bestLength,\n            count\n        };\n\n        return memo[index];\n    }\n\npublic:\n    int findNumberOfLIS(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        memo.assign(\n            n,\n            {0, 0}\n        );\n\n        visited.assign(\n            n,\n            false\n        );\n\n        int bestLength = 0;\n        int answer = 0;\n\n        for (int i = 0; i < n; i++) {\n            auto [length, count] =\n                solve(nums, i);\n\n            if (length > bestLength) {\n                bestLength = length;\n                answer = count;\n            } else if (length == bestLength) {\n                answer += count;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int findNumberOfLIS(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<int> length(n, 1);\n        vector<int> count(n, 1);\n\n        int bestLength = 0;\n        int answer = 0;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (nums[j] >= nums[i]) {\n                    continue;\n                }\n\n                if (length[j] + 1 > length[i]) {\n                    length[i] = length[j] + 1;\n                    count[i] = count[j];\n                } else if (length[j] + 1 == length[i]) {\n                    count[i] += count[j];\n                }\n            }\n\n            if (length[i] > bestLength) {\n                bestLength = length[i];\n                answer = count[i];\n            } else if (length[i] == bestLength) {\n                answer += count[i];\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_5":{"cpp":"class Solution {\n    struct Node {\n        int length;\n        long long count;\n    };\n\n    Node combine(\n        const Node& first,\n        const Node& second\n    ) {\n        if (first.length > second.length) {\n            return first;\n        }\n\n        if (second.length > first.length) {\n            return second;\n        }\n\n        if (first.length == 0) {\n            return {\n                0,\n                0\n            };\n        }\n\n        return {\n            first.length,\n            first.count + second.count\n        };\n    }\n\n    struct Fenwick {\n        vector<Node> tree;\n        Solution* owner;\n\n        Fenwick(\n            int size,\n            Solution* solution\n        ) : tree(size + 1, {0, 0}),\n            owner(solution) {}\n\n        void update(\n            int index,\n            Node value\n        ) {\n            while (index < static_cast<int>(tree.size())) {\n                tree[index] = owner->combine(\n                    tree[index],\n                    value\n                );\n\n                index += index & -index;\n            }\n        }\n\n        Node query(int index) {\n            Node answer = {0, 0};\n\n            while (index > 0) {\n                answer = owner->combine(\n                    answer,\n                    tree[index]\n                );\n\n                index -= index & -index;\n            }\n\n            return answer;\n        }\n    };\n\npublic:\n    int findNumberOfLIS(vector<int>& nums) {\n        vector<int> values = nums;\n\n        sort(\n            values.begin(),\n            values.end()\n        );\n\n        values.erase(\n            unique(\n                values.begin(),\n                values.end()\n            ),\n            values.end()\n        );\n\n        Fenwick fenwick(\n            static_cast<int>(values.size()),\n            this\n        );\n\n        for (int number : nums) {\n            int rank =\n                static_cast<int>(\n                    lower_bound(\n                        values.begin(),\n                        values.end(),\n                        number\n                    ) -\n                    values.begin()\n                ) +\n                1;\n\n            Node previous =\n                fenwick.query(rank - 1);\n\n            Node current = {\n                previous.length + 1,\n                previous.length == 0\n                    ? 1\n                    : previous.count\n            };\n\n            fenwick.update(\n                rank,\n                current\n            );\n        }\n\n        Node answer =\n            fenwick.query(\n                static_cast<int>(values.size())\n            );\n\n        return static_cast<int>(answer.count);\n    }\n};"}}}]
