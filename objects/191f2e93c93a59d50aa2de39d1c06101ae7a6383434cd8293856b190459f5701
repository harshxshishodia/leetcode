[{"leetcode_no":416,"name":"Partition Equal Subset Sum","solutions":{"approach_1":{"cpp":"class Solution {\n    bool solve(\n        const vector<int>& nums,\n        int index,\n        int target\n    ) {\n        if (target == 0) {\n            return true;\n        }\n\n        if (index == static_cast<int>(nums.size()) ||\n            target < 0) {\n            return false;\n        }\n\n        return solve(nums, index + 1, target) ||\n               solve(nums, index + 1, target - nums[index]);\n    }\n\npublic:\n    bool canPartition(vector<int>& nums) {\n        int total = accumulate(nums.begin(), nums.end(), 0);\n\n        if (total % 2 != 0) {\n            return false;\n        }\n\n        return solve(nums, 0, total / 2);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int target,\n        vector<vector<int>>& memo\n    ) {\n        if (target == 0) {\n            return 1;\n        }\n\n        if (index == static_cast<int>(nums.size()) ||\n            target < 0) {\n            return 0;\n        }\n\n        if (memo[index][target] != -1) {\n            return memo[index][target];\n        }\n\n        bool possible = solve(\n            nums,\n            index + 1,\n            target,\n            memo\n        );\n\n        if (!possible && nums[index] <= target) {\n            possible = solve(\n                nums,\n                index + 1,\n                target - nums[index],\n                memo\n            );\n        }\n\n        memo[index][target] = possible;\n        return memo[index][target];\n    }\n\npublic:\n    bool canPartition(vector<int>& nums) {\n        int total = accumulate(nums.begin(), nums.end(), 0);\n\n        if (total % 2 != 0) {\n            return false;\n        }\n\n        int target = total / 2;\n        vector<vector<int>> memo(\n            nums.size(),\n            vector<int>(target + 1, -1)\n        );\n\n        return solve(nums, 0, target, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool canPartition(vector<int>& nums) {\n        int total = accumulate(nums.begin(), nums.end(), 0);\n\n        if (total % 2 != 0) {\n            return false;\n        }\n\n        int target = total / 2;\n        int n = static_cast<int>(nums.size());\n        vector<vector<bool>> dp(\n            n + 1,\n            vector<bool>(target + 1)\n        );\n\n        for (int index = 0; index <= n; index++) {\n            dp[index][0] = true;\n        }\n\n        for (int index = 1; index <= n; index++) {\n            for (int sum = 1; sum <= target; sum++) {\n                dp[index][sum] = dp[index - 1][sum];\n\n                if (nums[index - 1] <= sum) {\n                    dp[index][sum] =\n                        dp[index][sum] ||\n                        dp[index - 1][sum - nums[index - 1]];\n                }\n            }\n        }\n\n        return dp[n][target];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool canPartition(vector<int>& nums) {\n        int total = accumulate(nums.begin(), nums.end(), 0);\n\n        if (total % 2 != 0) {\n            return false;\n        }\n\n        int target = total / 2;\n        vector<bool> dp(target + 1);\n        dp[0] = true;\n\n        for (int number : nums) {\n            for (int sum = target; sum >= number; sum--) {\n                dp[sum] = dp[sum] || dp[sum - number];\n            }\n        }\n\n        return dp[target];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    bool canPartition(vector<int>& nums) {\n        int total = accumulate(nums.begin(), nums.end(), 0);\n\n        if (total % 2 != 0) {\n            return false;\n        }\n\n        int target = total / 2;\n        bitset<20001> possible;\n        possible[0] = 1;\n\n        for (int number : nums) {\n            possible |= possible << number;\n        }\n\n        return possible[target];\n    }\n};"}}}]
