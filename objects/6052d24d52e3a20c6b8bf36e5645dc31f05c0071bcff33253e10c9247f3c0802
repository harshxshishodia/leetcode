[{"leetcode_no":931,"name":"Minimum Falling Path Sum","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& matrix,\n        int row,\n        int col\n    ) {\n        int n = static_cast<int>(matrix.size());\n\n        if (col < 0 || col >= n) {\n            return 1000000000;\n        }\n\n        if (row == n - 1) {\n            return matrix[row][col];\n        }\n\n        return matrix[row][col] + min({\n            solve(\n                matrix,\n                row + 1,\n                col - 1\n            ),\n            solve(\n                matrix,\n                row + 1,\n                col\n            ),\n            solve(\n                matrix,\n                row + 1,\n                col + 1\n            )\n        });\n    }\n\npublic:\n    int minFallingPathSum(vector<vector<int>>& matrix) {\n        int answer =\n            numeric_limits<int>::max();\n\n        for (int col = 0;\n             col < static_cast<int>(matrix.size());\n             col++) {\n            answer = min(\n                answer,\n                solve(\n                    matrix,\n                    0,\n                    col\n                )\n            );\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& matrix,\n        int row,\n        int col,\n        vector<vector<int>>& memo\n    ) {\n        int n = static_cast<int>(matrix.size());\n\n        if (col < 0 || col >= n) {\n            return 1000000000;\n        }\n\n        if (row == n - 1) {\n            return matrix[row][col];\n        }\n\n        if (memo[row][col] != 1000000001) {\n            return memo[row][col];\n        }\n\n        memo[row][col] =\n            matrix[row][col] +\n            min({\n                solve(\n                    matrix,\n                    row + 1,\n                    col - 1,\n                    memo\n                ),\n                solve(\n                    matrix,\n                    row + 1,\n                    col,\n                    memo\n                ),\n                solve(\n                    matrix,\n                    row + 1,\n                    col + 1,\n                    memo\n                )\n            });\n\n        return memo[row][col];\n    }\n\npublic:\n    int minFallingPathSum(vector<vector<int>>& matrix) {\n        int n = static_cast<int>(matrix.size());\n\n        vector<vector<int>> memo(\n            n,\n            vector<int>(\n                n,\n                1000000001\n            )\n        );\n\n        int answer =\n            numeric_limits<int>::max();\n\n        for (int col = 0; col < n; col++) {\n            answer = min(\n                answer,\n                solve(\n                    matrix,\n                    0,\n                    col,\n                    memo\n                )\n            );\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minFallingPathSum(vector<vector<int>>& matrix) {\n        int n = static_cast<int>(matrix.size());\n\n        vector<vector<int>> dp = matrix;\n\n        for (int row = 1; row < n; row++) {\n            for (int col = 0; col < n; col++) {\n                int best =\n                    dp[row - 1][col];\n\n                if (col > 0) {\n                    best = min(\n                        best,\n                        dp[row - 1][col - 1]\n                    );\n                }\n\n                if (col + 1 < n) {\n                    best = min(\n                        best,\n                        dp[row - 1][col + 1]\n                    );\n                }\n\n                dp[row][col] += best;\n            }\n        }\n\n        return *min_element(\n            dp[n - 1].begin(),\n            dp[n - 1].end()\n        );\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minFallingPathSum(vector<vector<int>>& matrix) {\n        int n = static_cast<int>(matrix.size());\n        vector<int> previous = matrix[0];\n\n        for (int row = 1; row < n; row++) {\n            vector<int> current(n);\n\n            for (int col = 0; col < n; col++) {\n                int best =\n                    previous[col];\n\n                if (col > 0) {\n                    best = min(\n                        best,\n                        previous[col - 1]\n                    );\n                }\n\n                if (col + 1 < n) {\n                    best = min(\n                        best,\n                        previous[col + 1]\n                    );\n                }\n\n                current[col] =\n                    matrix[row][col] +\n                    best;\n            }\n\n            previous = current;\n        }\n\n        return *min_element(\n            previous.begin(),\n            previous.end()\n        );\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int minFallingPathSum(vector<vector<int>>& matrix) {\n        int n = static_cast<int>(matrix.size());\n\n        for (int row = 1; row < n; row++) {\n            for (int col = 0; col < n; col++) {\n                int best =\n                    matrix[row - 1][col];\n\n                if (col > 0) {\n                    best = min(\n                        best,\n                        matrix[row - 1][col - 1]\n                    );\n                }\n\n                if (col + 1 < n) {\n                    best = min(\n                        best,\n                        matrix[row - 1][col + 1]\n                    );\n                }\n\n                matrix[row][col] += best;\n            }\n        }\n\n        return *min_element(\n            matrix[n - 1].begin(),\n            matrix[n - 1].end()\n        );\n    }\n};"}}}]
