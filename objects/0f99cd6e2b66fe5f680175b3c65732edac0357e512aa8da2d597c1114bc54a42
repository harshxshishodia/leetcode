[{"leetcode_no":5,"name":"Longest Palindromic Substring","solutions":{"approach_1":{"cpp":"class Solution {\n    bool isPalindrome(const string& s, int left, int right) {\n        while (left < right) {\n            if (s[left] != s[right]) {\n                return false;\n            }\n\n            left++;\n            right--;\n        }\n\n        return true;\n    }\n\npublic:\n    string longestPalindrome(string s) {\n        int n = static_cast<int>(s.size());\n\n        for (int length = n; length >= 1; length--) {\n            for (int start = 0; start + length <= n; start++) {\n                int end = start + length - 1;\n\n                if (isPalindrome(s, start, end)) {\n                    return s.substr(start, length);\n                }\n            }\n        }\n\n        return \"\";\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int palindrome(const string& s, int left, int right, vector<vector<int>>& dp) {\n        if (left >= right) {\n            return 1;\n        }\n\n        if (dp[left][right] != -1) {\n            return dp[left][right];\n        }\n\n        if (s[left] != s[right]) {\n            dp[left][right] = 0;\n        } else {\n            dp[left][right] = palindrome(s, left + 1, right - 1, dp);\n        }\n\n        return dp[left][right];\n    }\n\npublic:\n    string longestPalindrome(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<int>> dp(n, vector<int>(n, -1));\n\n        for (int length = n; length >= 1; length--) {\n            for (int start = 0; start + length <= n; start++) {\n                int end = start + length - 1;\n\n                if (palindrome(s, start, end, dp)) {\n                    return s.substr(start, length);\n                }\n            }\n        }\n\n        return \"\";\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    string longestPalindrome(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<bool>> dp(n, vector<bool>(n));\n        int bestStart = 0;\n        int bestLength = 1;\n\n        for (int i = 0; i < n; i++) {\n            dp[i][i] = true;\n        }\n\n        for (int length = 2; length <= n; length++) {\n            for (int start = 0; start + length <= n; start++) {\n                int end = start + length - 1;\n\n                if (s[start] == s[end] &&\n                    (length == 2 || dp[start + 1][end - 1])) {\n                    dp[start][end] = true;\n\n                    if (length > bestLength) {\n                        bestStart = start;\n                        bestLength = length;\n                    }\n                }\n            }\n        }\n\n        return s.substr(bestStart, bestLength);\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    pair<int, int> expand(const string& s, int left, int right) {\n        while (left >= 0 &&\n               right < static_cast<int>(s.size()) &&\n               s[left] == s[right]) {\n            left--;\n            right++;\n        }\n\n        return {left + 1, right - left - 1};\n    }\n\npublic:\n    string longestPalindrome(string s) {\n        int bestStart = 0;\n        int bestLength = 1;\n\n        for (int center = 0; center < static_cast<int>(s.size()); center++) {\n            auto odd = expand(s, center, center);\n            auto even = expand(s, center, center + 1);\n\n            if (odd.second > bestLength) {\n                bestStart = odd.first;\n                bestLength = odd.second;\n            }\n\n            if (even.second > bestLength) {\n                bestStart = even.first;\n                bestLength = even.second;\n            }\n        }\n\n        return s.substr(bestStart, bestLength);\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    string longestPalindrome(string s) {\n        int n = static_cast<int>(s.size());\n        vector<int> odd(n);\n        int left = 0;\n        int right = -1;\n\n        for (int i = 0; i < n; i++) {\n            int radius = i > right ? 1 : min(odd[left + right - i], right - i + 1);\n\n            while (i - radius >= 0 &&\n                   i + radius < n &&\n                   s[i - radius] == s[i + radius]) {\n                radius++;\n            }\n\n            odd[i] = radius;\n\n            if (i + radius - 1 > right) {\n                left = i - radius + 1;\n                right = i + radius - 1;\n            }\n        }\n\n        vector<int> even(n);\n        left = 0;\n        right = -1;\n\n        for (int i = 0; i < n; i++) {\n            int radius = i > right ? 0 : min(even[left + right - i + 1], right - i + 1);\n\n            while (i - radius - 1 >= 0 &&\n                   i + radius < n &&\n                   s[i - radius - 1] == s[i + radius]) {\n                radius++;\n            }\n\n            even[i] = radius;\n\n            if (i + radius - 1 > right) {\n                left = i - radius;\n                right = i + radius - 1;\n            }\n        }\n\n        int bestStart = 0;\n        int bestLength = 1;\n\n        for (int i = 0; i < n; i++) {\n            int oddLength = 2 * odd[i] - 1;\n\n            if (oddLength > bestLength) {\n                bestLength = oddLength;\n                bestStart = i - odd[i] + 1;\n            }\n\n            int evenLength = 2 * even[i];\n\n            if (evenLength > bestLength) {\n                bestLength = evenLength;\n                bestStart = i - even[i];\n            }\n        }\n\n        return s.substr(bestStart, bestLength);\n    }\n};"}}}]
