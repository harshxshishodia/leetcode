[{"leetcode_no":309,"name":"Best Time to Buy and Sell Stock with Cooldown","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& prices,\n        int index,\n        bool canBuy\n    ) {\n        if (index >= static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (canBuy) {\n            return max(\n                solve(prices, index + 1, true),\n                -prices[index] + solve(prices, index + 1, false)\n            );\n        }\n\n        return max(\n            solve(prices, index + 1, false),\n            prices[index] + solve(prices, index + 2, true)\n        );\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        return solve(prices, 0, true);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& prices,\n        int index,\n        int canBuy,\n        vector<vector<int>>& memo\n    ) {\n        if (index >= static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (memo[index][canBuy] != -1) {\n            return memo[index][canBuy];\n        }\n\n        if (canBuy == 1) {\n            memo[index][canBuy] = max(\n                solve(prices, index + 1, 1, memo),\n                -prices[index] + solve(prices, index + 1, 0, memo)\n            );\n        } else {\n            memo[index][canBuy] = max(\n                solve(prices, index + 1, 0, memo),\n                prices[index] + solve(prices, index + 2, 1, memo)\n            );\n        }\n\n        return memo[index][canBuy];\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        vector<vector<int>> memo(\n            prices.size(),\n            vector<int>(2, -1)\n        );\n\n        return solve(prices, 0, 1, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int n = static_cast<int>(prices.size());\n        vector<vector<int>> dp(\n            n + 2,\n            vector<int>(2)\n        );\n\n        for (int index = n - 1; index >= 0; index--) {\n            dp[index][1] = max(\n                dp[index + 1][1],\n                -prices[index] + dp[index + 1][0]\n            );\n\n            dp[index][0] = max(\n                dp[index + 1][0],\n                prices[index] + dp[index + 2][1]\n            );\n        }\n\n        return dp[0][1];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int nextCanBuy = 0;\n        int nextHolding = 0;\n        int nextNextCanBuy = 0;\n\n        for (int index = static_cast<int>(prices.size()) - 1;\n             index >= 0;\n             index--) {\n            int currentCanBuy = max(\n                nextCanBuy,\n                -prices[index] + nextHolding\n            );\n\n            int currentHolding = max(\n                nextHolding,\n                prices[index] + nextNextCanBuy\n            );\n\n            nextNextCanBuy = nextCanBuy;\n            nextCanBuy = currentCanBuy;\n            nextHolding = currentHolding;\n        }\n\n        return nextCanBuy;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        if (prices.empty()) {\n            return 0;\n        }\n\n        int hold = -prices[0];\n        int sold = 0;\n        int rest = 0;\n\n        for (int i = 1; i < static_cast<int>(prices.size()); i++) {\n            int previousHold = hold;\n            int previousSold = sold;\n            int previousRest = rest;\n\n            hold = max(\n                previousHold,\n                previousRest - prices[i]\n            );\n\n            sold = previousHold + prices[i];\n            rest = max(previousRest, previousSold);\n        }\n\n        return max(sold, rest);\n    }\n};"}}}]
