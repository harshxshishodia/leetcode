[{"leetcode_no":651,"name":"4 Keys Keyboard","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(int operations) {\n        int answer = operations;\n\n        for (int breakpoint = 1;\n             breakpoint <= operations - 3;\n             breakpoint++) {\n            int pastes =\n                operations - breakpoint - 2;\n\n            answer = max(\n                answer,\n                solve(breakpoint) * (pastes + 1)\n            );\n        }\n\n        return answer;\n    }\n\npublic:\n    int maxA(int n) {\n        return solve(n);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        int operations,\n        vector<int>& memo\n    ) {\n        if (memo[operations] != -1) {\n            return memo[operations];\n        }\n\n        int answer = operations;\n\n        for (int breakpoint = 1;\n             breakpoint <= operations - 3;\n             breakpoint++) {\n            int pastes =\n                operations - breakpoint - 2;\n\n            answer = max(\n                answer,\n                solve(breakpoint, memo) * (pastes + 1)\n            );\n        }\n\n        memo[operations] = answer;\n        return memo[operations];\n    }\n\npublic:\n    int maxA(int n) {\n        vector<int> memo(n + 1, -1);\n        memo[0] = 0;\n\n        return solve(n, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxA(int n) {\n        vector<int> dp(n + 1);\n\n        for (int operations = 1;\n             operations <= n;\n             operations++) {\n            dp[operations] = operations;\n\n            for (int breakpoint = 1;\n                 breakpoint <= operations - 3;\n                 breakpoint++) {\n                int pastes =\n                    operations - breakpoint - 2;\n\n                dp[operations] = max(\n                    dp[operations],\n                    dp[breakpoint] * (pastes + 1)\n                );\n            }\n        }\n\n        return dp[n];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxA(int n) {\n        vector<int> dp(n + 1);\n\n        for (int operations = 1;\n             operations <= n;\n             operations++) {\n            dp[operations] = operations;\n\n            if (operations >= 4) {\n                dp[operations] = max(\n                    dp[operations],\n                    2 * dp[operations - 3]\n                );\n            }\n\n            if (operations >= 5) {\n                dp[operations] = max(\n                    dp[operations],\n                    3 * dp[operations - 4]\n                );\n            }\n\n            if (operations >= 6) {\n                dp[operations] = max(\n                    dp[operations],\n                    4 * dp[operations - 5]\n                );\n            }\n        }\n\n        return dp[n];\n    }\n};"}}}]
