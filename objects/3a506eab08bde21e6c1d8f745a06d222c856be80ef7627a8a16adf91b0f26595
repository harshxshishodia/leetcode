[{"leetcode_no":333,"name":"Largest BST Subtree","solutions":{"approach_1":{"cpp":"class Solution {\n    bool valid(TreeNode* root, long long lower, long long upper) {\n        if (root == nullptr) {\n            return true;\n        }\n\n        if (root->val <= lower || root->val >= upper) {\n            return false;\n        }\n\n        return valid(root->left, lower, root->val) &&\n               valid(root->right, root->val, upper);\n    }\n\n    int countNodes(TreeNode* root) {\n        if (root == nullptr) {\n            return 0;\n        }\n\n        return 1 +\n               countNodes(root->left) +\n               countNodes(root->right);\n    }\n\npublic:\n    int largestBSTSubtree(TreeNode* root) {\n        if (root == nullptr) {\n            return 0;\n        }\n\n        if (valid(\n                root,\n                numeric_limits<long long>::min(),\n                numeric_limits<long long>::max())) {\n            return countNodes(root);\n        }\n\n        return max(\n            largestBSTSubtree(root->left),\n            largestBSTSubtree(root->right)\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    struct Bounds {\n        bool bst;\n        long long minimum;\n        long long maximum;\n        int size;\n    };\n\n    unordered_map<TreeNode*, Bounds> memo;\n\n    Bounds analyze(TreeNode* root) {\n        if (root == nullptr) {\n            return {\n                true,\n                numeric_limits<long long>::max(),\n                numeric_limits<long long>::min(),\n                0\n            };\n        }\n\n        auto found = memo.find(root);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        Bounds left = analyze(root->left);\n        Bounds right = analyze(root->right);\n\n        if (left.bst &&\n            right.bst &&\n            root->val > left.maximum &&\n            root->val < right.minimum) {\n            Bounds current = {\n                true,\n                min<long long>(left.minimum, root->val),\n                max<long long>(right.maximum, root->val),\n                left.size + right.size + 1\n            };\n\n            memo[root] = current;\n            return current;\n        }\n\n        Bounds current = {\n            false,\n            numeric_limits<long long>::min(),\n            numeric_limits<long long>::max(),\n            max(left.size, right.size)\n        };\n\n        memo[root] = current;\n        return current;\n    }\n\npublic:\n    int largestBSTSubtree(TreeNode* root) {\n        return analyze(root).size;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    struct Info {\n        bool bst;\n        long long minimum;\n        long long maximum;\n        int size;\n    };\n\n    Info solve(TreeNode* root) {\n        if (root == nullptr) {\n            return {\n                true,\n                numeric_limits<long long>::max(),\n                numeric_limits<long long>::min(),\n                0\n            };\n        }\n\n        Info left = solve(root->left);\n        Info right = solve(root->right);\n\n        if (left.bst &&\n            right.bst &&\n            root->val > left.maximum &&\n            root->val < right.minimum) {\n            return {\n                true,\n                min<long long>(left.minimum, root->val),\n                max<long long>(right.maximum, root->val),\n                left.size + right.size + 1\n            };\n        }\n\n        return {\n            false,\n            numeric_limits<long long>::min(),\n            numeric_limits<long long>::max(),\n            max(left.size, right.size)\n        };\n    }\n\npublic:\n    int largestBSTSubtree(TreeNode* root) {\n        return solve(root).size;\n    }\n};"}}}]
