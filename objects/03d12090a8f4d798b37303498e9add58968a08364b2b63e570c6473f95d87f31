[{"leetcode_no":256,"name":"Paint House","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& costs,\n        int house,\n        int previousColor\n    ) {\n        if (house == static_cast<int>(costs.size())) {\n            return 0;\n        }\n\n        int answer = numeric_limits<int>::max();\n\n        for (int color = 0; color < 3; color++) {\n            if (color == previousColor) {\n                continue;\n            }\n\n            answer = min(\n                answer,\n                costs[house][color] +\n                solve(costs, house + 1, color)\n            );\n        }\n\n        return answer;\n    }\n\npublic:\n    int minCost(vector<vector<int>>& costs) {\n        return solve(costs, 0, -1);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& costs,\n        int house,\n        int previousColor,\n        vector<vector<int>>& memo\n    ) {\n        if (house == static_cast<int>(costs.size())) {\n            return 0;\n        }\n\n        int state = previousColor + 1;\n\n        if (memo[house][state] != -1) {\n            return memo[house][state];\n        }\n\n        int answer = numeric_limits<int>::max();\n\n        for (int color = 0; color < 3; color++) {\n            if (color == previousColor) {\n                continue;\n            }\n\n            answer = min(\n                answer,\n                costs[house][color] +\n                solve(costs, house + 1, color, memo)\n            );\n        }\n\n        memo[house][state] = answer;\n        return memo[house][state];\n    }\n\npublic:\n    int minCost(vector<vector<int>>& costs) {\n        vector<vector<int>> memo(\n            costs.size(),\n            vector<int>(4, -1)\n        );\n\n        return solve(costs, 0, -1, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minCost(vector<vector<int>>& costs) {\n        if (costs.empty()) {\n            return 0;\n        }\n\n        int n = static_cast<int>(costs.size());\n        vector<vector<int>> dp(n, vector<int>(3));\n        dp[0] = costs[0];\n\n        for (int house = 1; house < n; house++) {\n            dp[house][0] = costs[house][0] +\n                           min(dp[house - 1][1], dp[house - 1][2]);\n\n            dp[house][1] = costs[house][1] +\n                           min(dp[house - 1][0], dp[house - 1][2]);\n\n            dp[house][2] = costs[house][2] +\n                           min(dp[house - 1][0], dp[house - 1][1]);\n        }\n\n        return min({\n            dp[n - 1][0],\n            dp[n - 1][1],\n            dp[n - 1][2]\n        });\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minCost(vector<vector<int>>& costs) {\n        if (costs.empty()) {\n            return 0;\n        }\n\n        int red = costs[0][0];\n        int blue = costs[0][1];\n        int green = costs[0][2];\n\n        for (int house = 1; house < static_cast<int>(costs.size()); house++) {\n            int nextRed = costs[house][0] + min(blue, green);\n            int nextBlue = costs[house][1] + min(red, green);\n            int nextGreen = costs[house][2] + min(red, blue);\n\n            red = nextRed;\n            blue = nextBlue;\n            green = nextGreen;\n        }\n\n        return min({red, blue, green});\n    }\n};"}}}]
