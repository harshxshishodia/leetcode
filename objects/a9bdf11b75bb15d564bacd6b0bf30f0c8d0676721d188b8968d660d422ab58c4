[{"leetcode_no":494,"name":"Target Sum","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int current,\n        int target\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return current == target ? 1 : 0;\n        }\n\n        return\n            solve(\n                nums,\n                index + 1,\n                current + nums[index],\n                target\n            ) +\n            solve(\n                nums,\n                index + 1,\n                current - nums[index],\n                target\n            );\n    }\n\npublic:\n    int findTargetSumWays(vector<int>& nums, int target) {\n        return solve(nums, 0, 0, target);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int current,\n        int target,\n        int offset,\n        vector<vector<int>>& memo\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return current == target ? 1 : 0;\n        }\n\n        int state = current + offset;\n\n        if (memo[index][state] != -1) {\n            return memo[index][state];\n        }\n\n        memo[index][state] =\n            solve(\n                nums,\n                index + 1,\n                current + nums[index],\n                target,\n                offset,\n                memo\n            ) +\n            solve(\n                nums,\n                index + 1,\n                current - nums[index],\n                target,\n                offset,\n                memo\n            );\n\n        return memo[index][state];\n    }\n\npublic:\n    int findTargetSumWays(vector<int>& nums, int target) {\n        int total = accumulate(\n            nums.begin(),\n            nums.end(),\n            0\n        );\n\n        vector<vector<int>> memo(\n            nums.size(),\n            vector<int>(2 * total + 1, -1)\n        );\n\n        return solve(\n            nums,\n            0,\n            0,\n            target,\n            total,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int findTargetSumWays(vector<int>& nums, int target) {\n        int total = accumulate(\n            nums.begin(),\n            nums.end(),\n            0\n        );\n\n        if (abs(target) > total) {\n            return 0;\n        }\n\n        int offset = total;\n        vector<int> dp(2 * total + 1);\n        dp[offset] = 1;\n\n        for (int number : nums) {\n            vector<int> next(2 * total + 1);\n\n            for (int sum = -total; sum <= total; sum++) {\n                int ways = dp[sum + offset];\n\n                if (ways == 0) {\n                    continue;\n                }\n\n                next[sum + number + offset] += ways;\n                next[sum - number + offset] += ways;\n            }\n\n            dp = next;\n        }\n\n        return dp[target + offset];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int findTargetSumWays(vector<int>& nums, int target) {\n        int total = accumulate(\n            nums.begin(),\n            nums.end(),\n            0\n        );\n\n        if (abs(target) > total ||\n            (total + target) % 2 != 0) {\n            return 0;\n        }\n\n        int subset = (total + target) / 2;\n\n        if (subset < 0) {\n            return 0;\n        }\n\n        vector<int> dp(subset + 1);\n        dp[0] = 1;\n\n        for (int number : nums) {\n            for (int sum = subset; sum >= number; sum--) {\n                dp[sum] += dp[sum - number];\n            }\n        }\n\n        return dp[subset];\n    }\n};"}}}]
