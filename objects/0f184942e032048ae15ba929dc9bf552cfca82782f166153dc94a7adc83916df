[{"leetcode_no":413,"name":"Arithmetic Slices","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int numberOfArithmeticSlices(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        int answer = 0;\n\n        for (int left = 0; left < n; left++) {\n            for (int right = left + 2; right < n; right++) {\n                bool arithmetic = true;\n                long long difference =\n                    static_cast<long long>(nums[left + 1]) -\n                    nums[left];\n\n                for (int i = left + 2; i <= right; i++) {\n                    if (static_cast<long long>(nums[i]) -\n                        nums[i - 1] != difference) {\n                        arithmetic = false;\n                        break;\n                    }\n                }\n\n                if (arithmetic) {\n                    answer++;\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int numberOfArithmeticSlices(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        int answer = 0;\n\n        for (int left = 0; left + 2 < n; left++) {\n            long long difference =\n                static_cast<long long>(nums[left + 1]) -\n                nums[left];\n\n            for (int right = left + 2; right < n; right++) {\n                if (static_cast<long long>(nums[right]) -\n                    nums[right - 1] != difference) {\n                    break;\n                }\n\n                answer++;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int numberOfArithmeticSlices(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        if (n < 3) {\n            return 0;\n        }\n\n        vector<int> dp(n);\n        int answer = 0;\n\n        for (int i = 2; i < n; i++) {\n            if (static_cast<long long>(nums[i]) -\n                nums[i - 1] ==\n                static_cast<long long>(nums[i - 1]) -\n                nums[i - 2]) {\n                dp[i] = dp[i - 1] + 1;\n                answer += dp[i];\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int numberOfArithmeticSlices(vector<int>& nums) {\n        int endingHere = 0;\n        int answer = 0;\n\n        for (int i = 2; i < static_cast<int>(nums.size()); i++) {\n            if (static_cast<long long>(nums[i]) -\n                nums[i - 1] ==\n                static_cast<long long>(nums[i - 1]) -\n                nums[i - 2]) {\n                endingHere++;\n                answer += endingHere;\n            } else {\n                endingHere = 0;\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
