[{"leetcode_no":376,"name":"Wiggle Subsequence","solutions":{"approach_1":{"cpp":"class Solution {\n    int best = 0;\n\n    bool wiggles(const vector<int>& sequence) {\n        if (sequence.size() <= 1) {\n            return true;\n        }\n\n        long long previousDifference = 0;\n\n        for (int i = 1; i < static_cast<int>(sequence.size()); i++) {\n            long long difference =\n                static_cast<long long>(sequence[i]) -\n                sequence[i - 1];\n\n            if (difference == 0) {\n                return false;\n            }\n\n            if (previousDifference != 0 &&\n                ((difference > 0) == (previousDifference > 0))) {\n                return false;\n            }\n\n            previousDifference = difference;\n        }\n\n        return true;\n    }\n\n    void search(\n        const vector<int>& nums,\n        int index,\n        vector<int>& current\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            if (wiggles(current)) {\n                best = max(best, static_cast<int>(current.size()));\n            }\n\n            return;\n        }\n\n        search(nums, index + 1, current);\n\n        current.push_back(nums[index]);\n        search(nums, index + 1, current);\n        current.pop_back();\n    }\n\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        best = 0;\n        vector<int> current;\n        search(nums, 0, current);\n        return best;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int previousIndex,\n        int direction\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        int skip = solve(\n            nums,\n            index + 1,\n            previousIndex,\n            direction\n        );\n\n        int take = 0;\n\n        if (previousIndex == -1) {\n            take = 1 + solve(\n                nums,\n                index + 1,\n                index,\n                0\n            );\n        } else {\n            long long difference =\n                static_cast<long long>(nums[index]) -\n                nums[previousIndex];\n\n            if (difference > 0 && direction != 1) {\n                take = 1 + solve(\n                    nums,\n                    index + 1,\n                    index,\n                    1\n                );\n            } else if (difference < 0 && direction != 2) {\n                take = 1 + solve(\n                    nums,\n                    index + 1,\n                    index,\n                    2\n                );\n            }\n        }\n\n        return max(skip, take);\n    }\n\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        return solve(nums, 0, -1, 0);\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int previousIndex,\n        int direction,\n        vector<vector<array<int, 3>>>& memo\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        int previousState = previousIndex + 1;\n\n        if (memo[index][previousState][direction] != -1) {\n            return memo[index][previousState][direction];\n        }\n\n        int skip = solve(\n            nums,\n            index + 1,\n            previousIndex,\n            direction,\n            memo\n        );\n\n        int take = 0;\n\n        if (previousIndex == -1) {\n            take = 1 + solve(\n                nums,\n                index + 1,\n                index,\n                0,\n                memo\n            );\n        } else {\n            long long difference =\n                static_cast<long long>(nums[index]) -\n                nums[previousIndex];\n\n            if (difference > 0 && direction != 1) {\n                take = 1 + solve(\n                    nums,\n                    index + 1,\n                    index,\n                    1,\n                    memo\n                );\n            } else if (difference < 0 && direction != 2) {\n                take = 1 + solve(\n                    nums,\n                    index + 1,\n                    index,\n                    2,\n                    memo\n                );\n            }\n        }\n\n        memo[index][previousState][direction] = max(skip, take);\n        return memo[index][previousState][direction];\n    }\n\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<vector<array<int, 3>>> memo(\n            n,\n            vector<array<int, 3>>(n + 1)\n        );\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j <= n; j++) {\n                memo[i][j].fill(-1);\n            }\n        }\n\n        return solve(nums, 0, -1, 0, memo);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<int> up(n, 1);\n        vector<int> down(n, 1);\n        int answer = 1;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (nums[i] > nums[j]) {\n                    up[i] = max(up[i], down[j] + 1);\n                } else if (nums[i] < nums[j]) {\n                    down[i] = max(down[i], up[j] + 1);\n                }\n            }\n\n            answer = max({\n                answer,\n                up[i],\n                down[i]\n            });\n        }\n\n        return answer;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        if (n == 1) {\n            return 1;\n        }\n\n        vector<int> up(n, 1);\n        vector<int> down(n, 1);\n\n        for (int i = 1; i < n; i++) {\n            if (nums[i] > nums[i - 1]) {\n                up[i] = down[i - 1] + 1;\n                down[i] = down[i - 1];\n            } else if (nums[i] < nums[i - 1]) {\n                down[i] = up[i - 1] + 1;\n                up[i] = up[i - 1];\n            } else {\n                up[i] = up[i - 1];\n                down[i] = down[i - 1];\n            }\n        }\n\n        return max(up[n - 1], down[n - 1]);\n    }\n};"},"approach_6":{"cpp":"class Solution {\npublic:\n    int wiggleMaxLength(vector<int>& nums) {\n        int up = 1;\n        int down = 1;\n\n        for (int i = 1; i < static_cast<int>(nums.size()); i++) {\n            if (nums[i] > nums[i - 1]) {\n                up = down + 1;\n            } else if (nums[i] < nums[i - 1]) {\n                down = up + 1;\n            }\n        }\n\n        return max(up, down);\n    }\n};"}}}]
