[{"leetcode_no":678,"name":"Valid Parenthesis String","solutions":{"approach_1":{"cpp":"class Solution {\n    bool solve(\n        const string& s,\n        int index,\n        int balance\n    ) {\n        if (balance < 0) {\n            return false;\n        }\n\n        if (index == static_cast<int>(s.size())) {\n            return balance == 0;\n        }\n\n        if (s[index] == '(') {\n            return solve(\n                s,\n                index + 1,\n                balance + 1\n            );\n        }\n\n        if (s[index] == ')') {\n            return solve(\n                s,\n                index + 1,\n                balance - 1\n            );\n        }\n\n        return\n            solve(\n                s,\n                index + 1,\n                balance\n            ) ||\n            solve(\n                s,\n                index + 1,\n                balance + 1\n            ) ||\n            solve(\n                s,\n                index + 1,\n                balance - 1\n            );\n    }\n\npublic:\n    bool checkValidString(string s) {\n        return solve(\n            s,\n            0,\n            0\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const string& s,\n        int index,\n        int balance,\n        vector<vector<int>>& memo\n    ) {\n        if (balance < 0) {\n            return 0;\n        }\n\n        if (index == static_cast<int>(s.size())) {\n            return balance == 0;\n        }\n\n        if (memo[index][balance] != -1) {\n            return memo[index][balance];\n        }\n\n        bool possible;\n\n        if (s[index] == '(') {\n            possible = solve(\n                s,\n                index + 1,\n                balance + 1,\n                memo\n            );\n        } else if (s[index] == ')') {\n            possible = solve(\n                s,\n                index + 1,\n                balance - 1,\n                memo\n            );\n        } else {\n            possible =\n                solve(\n                    s,\n                    index + 1,\n                    balance,\n                    memo\n                ) ||\n                solve(\n                    s,\n                    index + 1,\n                    balance + 1,\n                    memo\n                ) ||\n                solve(\n                    s,\n                    index + 1,\n                    balance - 1,\n                    memo\n                );\n        }\n\n        memo[index][balance] = possible;\n        return memo[index][balance];\n    }\n\npublic:\n    bool checkValidString(string s) {\n        int n = static_cast<int>(s.size());\n\n        vector<vector<int>> memo(\n            n,\n            vector<int>(n + 1, -1)\n        );\n\n        return solve(\n            s,\n            0,\n            0,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool checkValidString(string s) {\n        int n = static_cast<int>(s.size());\n\n        vector<vector<bool>> dp(\n            n + 1,\n            vector<bool>(n + 1)\n        );\n\n        dp[0][0] = true;\n\n        for (int index = 0; index < n; index++) {\n            for (int balance = 0; balance <= n; balance++) {\n                if (!dp[index][balance]) {\n                    continue;\n                }\n\n                if (s[index] == '(') {\n                    dp[index + 1][balance + 1] = true;\n                } else if (s[index] == ')') {\n                    if (balance > 0) {\n                        dp[index + 1][balance - 1] = true;\n                    }\n                } else {\n                    dp[index + 1][balance] = true;\n                    dp[index + 1][balance + 1] = true;\n\n                    if (balance > 0) {\n                        dp[index + 1][balance - 1] = true;\n                    }\n                }\n            }\n        }\n\n        return dp[n][0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool checkValidString(string s) {\n        stack<int> leftParentheses;\n        stack<int> stars;\n\n        for (int i = 0; i < static_cast<int>(s.size()); i++) {\n            if (s[i] == '(') {\n                leftParentheses.push(i);\n            } else if (s[i] == '*') {\n                stars.push(i);\n            } else {\n                if (!leftParentheses.empty()) {\n                    leftParentheses.pop();\n                } else if (!stars.empty()) {\n                    stars.pop();\n                } else {\n                    return false;\n                }\n            }\n        }\n\n        while (!leftParentheses.empty() &&\n               !stars.empty()) {\n            if (leftParentheses.top() > stars.top()) {\n                return false;\n            }\n\n            leftParentheses.pop();\n            stars.pop();\n        }\n\n        return leftParentheses.empty();\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    bool checkValidString(string s) {\n        int minimumOpen = 0;\n        int maximumOpen = 0;\n\n        for (char character : s) {\n            if (character == '(') {\n                minimumOpen++;\n                maximumOpen++;\n            } else if (character == ')') {\n                minimumOpen--;\n                maximumOpen--;\n            } else {\n                minimumOpen--;\n                maximumOpen++;\n            }\n\n            if (maximumOpen < 0) {\n                return false;\n            }\n\n            minimumOpen = max(\n                minimumOpen,\n                0\n            );\n        }\n\n        return minimumOpen == 0;\n    }\n};"}}}]
