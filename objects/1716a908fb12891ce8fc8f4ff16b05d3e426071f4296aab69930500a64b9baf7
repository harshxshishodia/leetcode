[{"leetcode_no":901,"name":"Online Stock Span","solutions":{"approach_1":{"cpp":"class StockSpanner {\n    vector<int> priceHistory;\n\npublic:\n    StockSpanner() {}\n\n    int next(int price) {\n        priceHistory.push_back(price);\n        int span = 0;\n        for (int i = static_cast<int>(priceHistory.size()) - 1; i >= 0; i--) {\n            if (priceHistory[i] <= price) {\n                span++;\n            } else {\n                break;\n            }\n        }\n        return span;\n    }\n};"},"approach_2":{"cpp":"class StockSpanner {\n    stack<pair<int, int>> monotonicStack; // pair of (price, span)\n\npublic:\n    StockSpanner() {}\n\n    int next(int price) {\n        int currentSpan = 1;\n        while (!monotonicStack.empty() && monotonicStack.top().first <= price) {\n            currentSpan += monotonicStack.top().second;\n            monotonicStack.pop();\n        }\n        monotonicStack.emplace(price, currentSpan);\n        return currentSpan;\n    }\n};"}}}]
