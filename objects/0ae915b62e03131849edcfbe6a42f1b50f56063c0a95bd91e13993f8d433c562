[{"leetcode_no":64,"name":"Minimum Path Sum","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(const vector<vector<int>>& grid, int row, int col) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n\n        if (row == rows - 1 && col == cols - 1) {\n            return grid[row][col];\n        }\n\n        if (row >= rows || col >= cols) {\n            return 1000000000;\n        }\n\n        return grid[row][col] + min(\n            solve(grid, row + 1, col),\n            solve(grid, row, col + 1)\n        );\n    }\n\npublic:\n    int minPathSum(vector<vector<int>>& grid) {\n        return solve(grid, 0, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& grid,\n        int row,\n        int col,\n        vector<vector<int>>& dp\n    ) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n\n        if (row == rows - 1 && col == cols - 1) {\n            return grid[row][col];\n        }\n\n        if (row >= rows || col >= cols) {\n            return 1000000000;\n        }\n\n        if (dp[row][col] != -1) {\n            return dp[row][col];\n        }\n\n        dp[row][col] = grid[row][col] + min(\n            solve(grid, row + 1, col, dp),\n            solve(grid, row, col + 1, dp)\n        );\n\n        return dp[row][col];\n    }\n\npublic:\n    int minPathSum(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n        vector<vector<int>> dp(rows, vector<int>(cols, -1));\n\n        return solve(grid, 0, 0, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minPathSum(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n        vector<vector<int>> dp(rows, vector<int>(cols));\n\n        dp[0][0] = grid[0][0];\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                if (row == 0 && col == 0) {\n                    continue;\n                }\n\n                int fromTop = row > 0 ? dp[row - 1][col] : 1000000000;\n                int fromLeft = col > 0 ? dp[row][col - 1] : 1000000000;\n                dp[row][col] = grid[row][col] + min(fromTop, fromLeft);\n            }\n        }\n\n        return dp[rows - 1][cols - 1];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minPathSum(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n        vector<int> dp(cols, 1000000000);\n        dp[0] = 0;\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                int fromTop = dp[col];\n                int fromLeft = col > 0 ? dp[col - 1] : 1000000000;\n\n                if (row == 0 && col == 0) {\n                    dp[col] = grid[row][col];\n                } else {\n                    dp[col] = grid[row][col] + min(fromTop, fromLeft);\n                }\n            }\n        }\n\n        return dp[cols - 1];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int minPathSum(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n\n        for (int row = 0; row < rows; row++) {\n            for (int col = 0; col < cols; col++) {\n                if (row == 0 && col == 0) {\n                    continue;\n                }\n\n                int fromTop = row > 0 ? grid[row - 1][col] : 1000000000;\n                int fromLeft = col > 0 ? grid[row][col - 1] : 1000000000;\n                grid[row][col] += min(fromTop, fromLeft);\n            }\n        }\n\n        return grid[rows - 1][cols - 1];\n    }\n};"}}}]
