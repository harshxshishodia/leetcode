[{"leetcode_no":121,"name":"Best Time to Buy and Sell Stock","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int bestProfit = 0;\n\n        for (int buy = 0; buy < static_cast<int>(prices.size()); buy++) {\n            for (int sell = buy + 1; sell < static_cast<int>(prices.size()); sell++) {\n                bestProfit = max(bestProfit, prices[sell] - prices[buy]);\n            }\n        }\n\n        return bestProfit;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(vector<int>& prices, int index, bool canBuy) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (canBuy) {\n            int skip = solve(prices, index + 1, true);\n            int buy = -prices[index] + solve(prices, index + 1, false);\n            return max(skip, buy);\n        }\n\n        int skip = solve(prices, index + 1, false);\n        int sell = prices[index];\n        return max(skip, sell);\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        return solve(prices, 0, true);\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int solve(vector<int>& prices, int index, int canBuy, vector<vector<int>>& dp) {\n        if (index == static_cast<int>(prices.size())) {\n            return 0;\n        }\n\n        if (dp[index][canBuy] != -1) {\n            return dp[index][canBuy];\n        }\n\n        if (canBuy == 1) {\n            int skip = solve(prices, index + 1, 1, dp);\n            int buy = -prices[index] + solve(prices, index + 1, 0, dp);\n            dp[index][canBuy] = max(skip, buy);\n        } else {\n            int skip = solve(prices, index + 1, 0, dp);\n            int sell = prices[index];\n            dp[index][canBuy] = max(skip, sell);\n        }\n\n        return dp[index][canBuy];\n    }\n\npublic:\n    int maxProfit(vector<int>& prices) {\n        vector<vector<int>> dp(prices.size(), vector<int>(2, -1));\n        return solve(prices, 0, 1, dp);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int n = static_cast<int>(prices.size());\n        vector<vector<int>> dp(n + 1, vector<int>(2));\n\n        for (int index = n - 1; index >= 0; index--) {\n            dp[index][1] = max(dp[index + 1][1], -prices[index] + dp[index + 1][0]);\n            dp[index][0] = max(dp[index + 1][0], prices[index]);\n        }\n\n        return dp[0][1];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int nextCanBuy = 0;\n        int nextHolding = 0;\n\n        for (int index = static_cast<int>(prices.size()) - 1; index >= 0; index--) {\n            int currentCanBuy = max(nextCanBuy, -prices[index] + nextHolding);\n            int currentHolding = max(nextHolding, prices[index]);\n            nextCanBuy = currentCanBuy;\n            nextHolding = currentHolding;\n        }\n\n        return nextCanBuy;\n    }\n};"},"approach_6":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int bestEndingHere = 0;\n        int bestProfit = 0;\n\n        for (int i = 1; i < static_cast<int>(prices.size()); i++) {\n            int difference = prices[i] - prices[i - 1];\n            bestEndingHere = max(0, bestEndingHere + difference);\n            bestProfit = max(bestProfit, bestEndingHere);\n        }\n\n        return bestProfit;\n    }\n};"},"approach_7":{"cpp":"class Solution {\npublic:\n    int maxProfit(vector<int>& prices) {\n        int minimumPrice = numeric_limits<int>::max();\n        int bestProfit = 0;\n\n        for (int price : prices) {\n            minimumPrice = min(minimumPrice, price);\n            bestProfit = max(bestProfit, price - minimumPrice);\n        }\n\n        return bestProfit;\n    }\n};"}}}]
