[{"leetcode_no":750,"name":"Number Of Corner Rectangles","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int countCornerRectangles(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n        int answer = 0;\n\n        for (int firstRow = 0; firstRow < rows; firstRow++) {\n            for (int secondRow = firstRow + 1;\n                 secondRow < rows;\n                 secondRow++) {\n                for (int firstCol = 0;\n                     firstCol < cols;\n                     firstCol++) {\n                    if (grid[firstRow][firstCol] == 0 ||\n                        grid[secondRow][firstCol] == 0) {\n                        continue;\n                    }\n\n                    for (int secondCol = firstCol + 1;\n                         secondCol < cols;\n                         secondCol++) {\n                        if (grid[firstRow][secondCol] == 1 &&\n                            grid[secondRow][secondCol] == 1) {\n                            answer++;\n                        }\n                    }\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int countCornerRectangles(vector<vector<int>>& grid) {\n        int rows = static_cast<int>(grid.size());\n        int cols = static_cast<int>(grid[0].size());\n        int answer = 0;\n\n        for (int firstRow = 0; firstRow < rows; firstRow++) {\n            for (int secondRow = firstRow + 1;\n                 secondRow < rows;\n                 secondRow++) {\n                int common = 0;\n\n                for (int col = 0; col < cols; col++) {\n                    if (grid[firstRow][col] == 1 &&\n                        grid[secondRow][col] == 1) {\n                        common++;\n                    }\n                }\n\n                answer +=\n                    common *\n                    (common - 1) /\n                    2;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int countCornerRectangles(vector<vector<int>>& grid) {\n        int cols = static_cast<int>(grid[0].size());\n\n        unordered_map<int, int> pairCount;\n        int answer = 0;\n\n        for (const vector<int>& row : grid) {\n            vector<int> ones;\n\n            for (int col = 0; col < cols; col++) {\n                if (row[col] == 1) {\n                    ones.push_back(col);\n                }\n            }\n\n            for (int i = 0; i < static_cast<int>(ones.size()); i++) {\n                for (int j = i + 1;\n                     j < static_cast<int>(ones.size());\n                     j++) {\n                    int key =\n                        ones[i] * cols +\n                        ones[j];\n\n                    answer += pairCount[key];\n                    pairCount[key]++;\n                }\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
