[{"leetcode_no":703,"name":"Kth Largest Element in a Stream","solutions":{"approach_1":{"cpp":"class KthLargest {\n    vector<int> elements;\n    int kRank;\n\npublic:\n    KthLargest(int k, vector<int>& nums) : elements(nums), kRank(k) {}\n\n    int add(int val) {\n        elements.push_back(val);\n        sort(elements.begin(), elements.end(), greater<int>());\n        return elements[kRank - 1];\n    }\n};"},"approach_2":{"cpp":"class KthLargest {\n    priority_queue<int, vector<int>, greater<int>> minHeap;\n    int kSize;\n\npublic:\n    KthLargest(int k, vector<int>& nums) : kSize(k) {\n        for (int num : nums) {\n            add(num);\n        }\n    }\n\n    int add(int val) {\n        minHeap.push(val);\n        if (static_cast<int>(minHeap.size()) > kSize) {\n            minHeap.pop();\n        }\n        return minHeap.top();\n    }\n};"}}}]
