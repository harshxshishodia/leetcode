[{"leetcode_no":907,"name":"Sum of Subarray Minimums","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int sumSubarrayMins(vector<int>& arr) {\n        const int MOD = 1000000007;\n        long long answer = 0;\n\n        for (int left = 0;\n             left < static_cast<int>(arr.size());\n             left++) {\n            for (int right = left;\n                 right < static_cast<int>(arr.size());\n                 right++) {\n                int minimum = arr[left];\n\n                for (int i = left + 1; i <= right; i++) {\n                    minimum = min(\n                        minimum,\n                        arr[i]\n                    );\n                }\n\n                answer += minimum;\n                answer %= MOD;\n            }\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int sumSubarrayMins(vector<int>& arr) {\n        const int MOD = 1000000007;\n        long long answer = 0;\n\n        for (int left = 0;\n             left < static_cast<int>(arr.size());\n             left++) {\n            int minimum =\n                numeric_limits<int>::max();\n\n            for (int right = left;\n                 right < static_cast<int>(arr.size());\n                 right++) {\n                minimum = min(\n                    minimum,\n                    arr[right]\n                );\n\n                answer += minimum;\n                answer %= MOD;\n            }\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int sumSubarrayMins(vector<int>& arr) {\n        const int MOD = 1000000007;\n\n        vector<pair<int, int>> stack;\n        long long endingSum = 0;\n        long long answer = 0;\n\n        for (int value : arr) {\n            int count = 1;\n\n            while (!stack.empty() &&\n                   stack.back().first >= value) {\n                endingSum -=\n                    1LL *\n                    stack.back().first *\n                    stack.back().second;\n\n                count +=\n                    stack.back().second;\n\n                stack.pop_back();\n            }\n\n            stack.push_back({\n                value,\n                count\n            });\n\n            endingSum +=\n                1LL *\n                value *\n                count;\n\n            endingSum %= MOD;\n\n            answer +=\n                endingSum;\n\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int sumSubarrayMins(vector<int>& arr) {\n        const int MOD = 1000000007;\n        int n = static_cast<int>(arr.size());\n\n        vector<int> previousLess(\n            n\n        );\n\n        vector<int> nextLessOrEqual(\n            n\n        );\n\n        stack<int> indices;\n\n        for (int i = 0; i < n; i++) {\n            while (!indices.empty() &&\n                   arr[indices.top()] > arr[i]) {\n                indices.pop();\n            }\n\n            previousLess[i] =\n                indices.empty()\n                    ? -1\n                    : indices.top();\n\n            indices.push(i);\n        }\n\n        while (!indices.empty()) {\n            indices.pop();\n        }\n\n        for (int i = n - 1; i >= 0; i--) {\n            while (!indices.empty() &&\n                   arr[indices.top()] >= arr[i]) {\n                indices.pop();\n            }\n\n            nextLessOrEqual[i] =\n                indices.empty()\n                    ? n\n                    : indices.top();\n\n            indices.push(i);\n        }\n\n        long long answer = 0;\n\n        for (int i = 0; i < n; i++) {\n            long long left =\n                i - previousLess[i];\n\n            long long right =\n                nextLessOrEqual[i] - i;\n\n            answer +=\n                1LL *\n                arr[i] *\n                left *\n                right;\n\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
