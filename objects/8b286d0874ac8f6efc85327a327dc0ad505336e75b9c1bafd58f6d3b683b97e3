[{"leetcode_no":486,"name":"Predict the Winner","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int left,\n        int right\n    ) {\n        if (left == right) {\n            return nums[left];\n        }\n\n        int takeLeft =\n            nums[left] -\n            solve(nums, left + 1, right);\n\n        int takeRight =\n            nums[right] -\n            solve(nums, left, right - 1);\n\n        return max(takeLeft, takeRight);\n    }\n\npublic:\n    bool predictTheWinner(vector<int>& nums) {\n        return solve(\n            nums,\n            0,\n            static_cast<int>(nums.size()) - 1\n        ) >= 0;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int left,\n        int right,\n        vector<vector<int>>& memo\n    ) {\n        if (left == right) {\n            return nums[left];\n        }\n\n        if (memo[left][right] != numeric_limits<int>::min()) {\n            return memo[left][right];\n        }\n\n        int takeLeft =\n            nums[left] -\n            solve(nums, left + 1, right, memo);\n\n        int takeRight =\n            nums[right] -\n            solve(nums, left, right - 1, memo);\n\n        memo[left][right] = max(takeLeft, takeRight);\n        return memo[left][right];\n    }\n\npublic:\n    bool predictTheWinner(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        vector<vector<int>> memo(\n            n,\n            vector<int>(\n                n,\n                numeric_limits<int>::min()\n            )\n        );\n\n        return solve(nums, 0, n - 1, memo) >= 0;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    bool predictTheWinner(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<vector<int>> dp(n, vector<int>(n));\n\n        for (int i = 0; i < n; i++) {\n            dp[i][i] = nums[i];\n        }\n\n        for (int length = 2; length <= n; length++) {\n            for (int left = 0;\n                 left + length <= n;\n                 left++) {\n                int right = left + length - 1;\n\n                dp[left][right] = max(\n                    nums[left] - dp[left + 1][right],\n                    nums[right] - dp[left][right - 1]\n                );\n            }\n        }\n\n        return dp[0][n - 1] >= 0;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    bool predictTheWinner(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<int> dp = nums;\n\n        for (int length = 2; length <= n; length++) {\n            for (int left = 0;\n                 left + length <= n;\n                 left++) {\n                int right = left + length - 1;\n\n                dp[left] = max(\n                    nums[left] - dp[left + 1],\n                    nums[right] - dp[left]\n                );\n            }\n        }\n\n        return dp[0] >= 0;\n    }\n};"}}}]
