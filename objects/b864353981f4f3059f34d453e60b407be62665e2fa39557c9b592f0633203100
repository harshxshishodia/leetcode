[{"leetcode_no":338,"name":"Counting Bits","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    vector<int> countBits(int n) {\n        vector<int> answer(n + 1);\n\n        for (int i = 0; i <= n; i++) {\n            int value = i;\n            int count = 0;\n\n            while (value > 0) {\n                count += value & 1;\n                value >>= 1;\n            }\n\n            answer[i] = count;\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    vector<int> countBits(int n) {\n        vector<int> answer(n + 1);\n\n        for (int i = 0; i <= n; i++) {\n            int value = i;\n            int count = 0;\n\n            while (value > 0) {\n                value &= value - 1;\n                count++;\n            }\n\n            answer[i] = count;\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    vector<int> countBits(int n) {\n        vector<int> answer(n + 1);\n        int offset = 1;\n\n        for (int i = 1; i <= n; i++) {\n            if (i == offset * 2) {\n                offset = i;\n            }\n\n            answer[i] = 1 + answer[i - offset];\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    vector<int> countBits(int n) {\n        vector<int> answer(n + 1);\n\n        for (int i = 1; i <= n; i++) {\n            answer[i] = answer[i >> 1] + (i & 1);\n        }\n\n        return answer;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    vector<int> countBits(int n) {\n        vector<int> answer(n + 1);\n\n        for (int i = 1; i <= n; i++) {\n            answer[i] = answer[i & (i - 1)] + 1;\n        }\n\n        return answer;\n    }\n};"}}}]
