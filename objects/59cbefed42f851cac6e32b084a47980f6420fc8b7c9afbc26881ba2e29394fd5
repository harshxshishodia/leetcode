[{"leetcode_no":435,"name":"Non-overlapping Intervals","solutions":{"approach_1":{"cpp":"class Solution {\n    int best;\n\n    void search(\n        const vector<vector<int>>& intervals,\n        int index,\n        vector<vector<int>>& chosen\n    ) {\n        if (index == static_cast<int>(intervals.size())) {\n            for (int i = 0; i < static_cast<int>(chosen.size()); i++) {\n                for (int j = i + 1; j < static_cast<int>(chosen.size()); j++) {\n                    if (max(chosen[i][0], chosen[j][0]) <\n                        min(chosen[i][1], chosen[j][1])) {\n                        return;\n                    }\n                }\n            }\n\n            best = max(best, static_cast<int>(chosen.size()));\n            return;\n        }\n\n        search(intervals, index + 1, chosen);\n\n        chosen.push_back(intervals[index]);\n        search(intervals, index + 1, chosen);\n        chosen.pop_back();\n    }\n\npublic:\n    int eraseOverlapIntervals(vector<vector<int>>& intervals) {\n        best = 0;\n        vector<vector<int>> chosen;\n        search(intervals, 0, chosen);\n\n        return static_cast<int>(intervals.size()) - best;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int eraseOverlapIntervals(vector<vector<int>>& intervals) {\n        sort(\n            intervals.begin(),\n            intervals.end(),\n            [](const vector<int>& first, const vector<int>& second) {\n                if (first[0] != second[0]) {\n                    return first[0] < second[0];\n                }\n\n                return first[1] < second[1];\n            }\n        );\n\n        int n = static_cast<int>(intervals.size());\n        vector<int> dp(n, 1);\n        int best = 1;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (intervals[j][1] <= intervals[i][0]) {\n                    dp[i] = max(dp[i], dp[j] + 1);\n                }\n            }\n\n            best = max(best, dp[i]);\n        }\n\n        return n - best;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int eraseOverlapIntervals(vector<vector<int>>& intervals) {\n        sort(\n            intervals.begin(),\n            intervals.end(),\n            [](const vector<int>& first, const vector<int>& second) {\n                if (first[0] != second[0]) {\n                    return first[0] < second[0];\n                }\n\n                return first[1] < second[1];\n            }\n        );\n\n        int removals = 0;\n        int end = intervals[0][1];\n\n        for (int i = 1; i < static_cast<int>(intervals.size()); i++) {\n            if (intervals[i][0] < end) {\n                removals++;\n                end = min(end, intervals[i][1]);\n            } else {\n                end = intervals[i][1];\n            }\n        }\n\n        return removals;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int eraseOverlapIntervals(vector<vector<int>>& intervals) {\n        sort(\n            intervals.begin(),\n            intervals.end(),\n            [](const vector<int>& first, const vector<int>& second) {\n                return first[1] < second[1];\n            }\n        );\n\n        int kept = 0;\n        int end = numeric_limits<int>::min();\n\n        for (const vector<int>& interval : intervals) {\n            if (interval[0] >= end) {\n                kept++;\n                end = interval[1];\n            }\n        }\n\n        return static_cast<int>(intervals.size()) - kept;\n    }\n};"}}}]
