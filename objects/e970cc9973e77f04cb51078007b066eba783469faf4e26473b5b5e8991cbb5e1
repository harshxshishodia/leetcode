[{"leetcode_no":62,"name":"Unique Paths","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(int row, int col, int rows, int cols) {\n        if (row == rows - 1 && col == cols - 1) {\n            return 1;\n        }\n\n        if (row >= rows || col >= cols) {\n            return 0;\n        }\n\n        return solve(row + 1, col, rows, cols) +\n               solve(row, col + 1, rows, cols);\n    }\n\npublic:\n    int uniquePaths(int m, int n) {\n        return solve(0, 0, m, n);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(int row, int col, int rows, int cols, vector<vector<int>>& dp) {\n        if (row == rows - 1 && col == cols - 1) {\n            return 1;\n        }\n\n        if (row >= rows || col >= cols) {\n            return 0;\n        }\n\n        if (dp[row][col] != -1) {\n            return dp[row][col];\n        }\n\n        dp[row][col] = solve(row + 1, col, rows, cols, dp) +\n                       solve(row, col + 1, rows, cols, dp);\n\n        return dp[row][col];\n    }\n\npublic:\n    int uniquePaths(int m, int n) {\n        vector<vector<int>> dp(m, vector<int>(n, -1));\n        return solve(0, 0, m, n, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int uniquePaths(int m, int n) {\n        vector<vector<int>> dp(m, vector<int>(n, 1));\n\n        for (int row = 1; row < m; row++) {\n            for (int col = 1; col < n; col++) {\n                dp[row][col] = dp[row - 1][col] + dp[row][col - 1];\n            }\n        }\n\n        return dp[m - 1][n - 1];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int uniquePaths(int m, int n) {\n        vector<int> dp(n, 1);\n\n        for (int row = 1; row < m; row++) {\n            for (int col = 1; col < n; col++) {\n                dp[col] += dp[col - 1];\n            }\n        }\n\n        return dp[n - 1];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int uniquePaths(int m, int n) {\n        int moves = m + n - 2;\n        int choose = min(m - 1, n - 1);\n        long long answer = 1;\n\n        for (int i = 1; i <= choose; i++) {\n            answer = answer * (moves - choose + i) / i;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
