[{"leetcode_no":152,"name":"Maximum Product Subarray","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        long long answer = numeric_limits<long long>::min();\n\n        for (int left = 0; left < n; left++) {\n            for (int right = left; right < n; right++) {\n                long long product = 1;\n\n                for (int i = left; i <= right; i++) {\n                    product *= nums[i];\n                }\n\n                answer = max(answer, product);\n            }\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        long long answer = numeric_limits<long long>::min();\n\n        for (int left = 0; left < n; left++) {\n            long long product = 1;\n\n            for (int right = left; right < n; right++) {\n                product *= nums[right];\n                answer = max(answer, product);\n            }\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        long long prefix = 1;\n        long long suffix = 1;\n        long long answer = numeric_limits<long long>::min();\n        int n = static_cast<int>(nums.size());\n\n        for (int i = 0; i < n; i++) {\n            if (prefix == 0) {\n                prefix = 1;\n            }\n\n            if (suffix == 0) {\n                suffix = 1;\n            }\n\n            prefix *= nums[i];\n            suffix *= nums[n - 1 - i];\n            answer = max({answer, prefix, suffix});\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<long long> maximum(n);\n        vector<long long> minimum(n);\n        maximum[0] = nums[0];\n        minimum[0] = nums[0];\n        long long answer = nums[0];\n\n        for (int i = 1; i < n; i++) {\n            long long value = nums[i];\n\n            maximum[i] = max({\n                value,\n                value * maximum[i - 1],\n                value * minimum[i - 1]\n            });\n\n            minimum[i] = min({\n                value,\n                value * maximum[i - 1],\n                value * minimum[i - 1]\n            });\n\n            answer = max(answer, maximum[i]);\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxProduct(vector<int>& nums) {\n        long long maximumEnding = nums[0];\n        long long minimumEnding = nums[0];\n        long long answer = nums[0];\n\n        for (int i = 1; i < static_cast<int>(nums.size()); i++) {\n            long long value = nums[i];\n\n            if (value < 0) {\n                swap(maximumEnding, minimumEnding);\n            }\n\n            maximumEnding = max(value, maximumEnding * value);\n            minimumEnding = min(value, minimumEnding * value);\n            answer = max(answer, maximumEnding);\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
