[{"leetcode_no":213,"name":"House Robber II","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        bool previousTaken,\n        bool firstTaken\n    ) {\n        int n = static_cast<int>(nums.size());\n\n        if (index == n) {\n            return 0;\n        }\n\n        int skip = solve(nums, index + 1, false, firstTaken);\n        int take = 0;\n\n        if (!previousTaken && !(index == n - 1 && firstTaken)) {\n            take = nums[index] + solve(\n                nums,\n                index + 1,\n                true,\n                firstTaken || index == 0\n            );\n        }\n\n        return max(skip, take);\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        if (nums.size() == 1) {\n            return nums[0];\n        }\n\n        return solve(nums, 0, false, false);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& nums,\n        int index,\n        int previousTaken,\n        int firstTaken,\n        vector<vector<vector<int>>>& memo\n    ) {\n        int n = static_cast<int>(nums.size());\n\n        if (index == n) {\n            return 0;\n        }\n\n        if (memo[index][previousTaken][firstTaken] != -1) {\n            return memo[index][previousTaken][firstTaken];\n        }\n\n        int skip = solve(\n            nums,\n            index + 1,\n            0,\n            firstTaken,\n            memo\n        );\n\n        int take = 0;\n\n        if (previousTaken == 0 &&\n            !(index == n - 1 && firstTaken == 1)) {\n            take = nums[index] + solve(\n                nums,\n                index + 1,\n                1,\n                firstTaken == 1 || index == 0,\n                memo\n            );\n        }\n\n        memo[index][previousTaken][firstTaken] = max(skip, take);\n        return memo[index][previousTaken][firstTaken];\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        if (nums.size() == 1) {\n            return nums[0];\n        }\n\n        vector<vector<vector<int>>> memo(\n            nums.size(),\n            vector<vector<int>>(2, vector<int>(2, -1))\n        );\n\n        return solve(nums, 0, 0, 0, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int robRange(const vector<int>& nums, int left, int right) {\n        int length = right - left + 1;\n        vector<int> dp(length + 1);\n        dp[1] = nums[left];\n\n        for (int i = 2; i <= length; i++) {\n            dp[i] = max(\n                dp[i - 1],\n                dp[i - 2] + nums[left + i - 1]\n            );\n        }\n\n        return dp[length];\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        if (n == 1) {\n            return nums[0];\n        }\n\n        return max(\n            robRange(nums, 0, n - 2),\n            robRange(nums, 1, n - 1)\n        );\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    int robRange(const vector<int>& nums, int left, int right) {\n        int previous2 = 0;\n        int previous1 = 0;\n\n        for (int i = left; i <= right; i++) {\n            int current = max(previous1, previous2 + nums[i]);\n            previous2 = previous1;\n            previous1 = current;\n        }\n\n        return previous1;\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        if (n == 1) {\n            return nums[0];\n        }\n\n        return max(\n            robRange(nums, 0, n - 2),\n            robRange(nums, 1, n - 1)\n        );\n    }\n};"}}}]
