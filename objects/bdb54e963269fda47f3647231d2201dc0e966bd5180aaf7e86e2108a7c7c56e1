[{"leetcode_no":53,"name":"Maximum Subarray","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int maxSubArray(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        int answer = numeric_limits<int>::min();\n\n        for (int left = 0; left < n; left++) {\n            for (int right = left; right < n; right++) {\n                int sum = 0;\n\n                for (int i = left; i <= right; i++) {\n                    sum += nums[i];\n                }\n\n                answer = max(answer, sum);\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int maxSubArray(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        int answer = numeric_limits<int>::min();\n\n        for (int left = 0; left < n; left++) {\n            int sum = 0;\n\n            for (int right = left; right < n; right++) {\n                sum += nums[right];\n                answer = max(answer, sum);\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int solve(const vector<int>& nums, int left, int right) {\n        if (left == right) {\n            return nums[left];\n        }\n\n        int middle = left + (right - left) / 2;\n        int leftAnswer = solve(nums, left, middle);\n        int rightAnswer = solve(nums, middle + 1, right);\n\n        int bestLeftSuffix = numeric_limits<int>::min();\n        int sum = 0;\n\n        for (int i = middle; i >= left; i--) {\n            sum += nums[i];\n            bestLeftSuffix = max(bestLeftSuffix, sum);\n        }\n\n        int bestRightPrefix = numeric_limits<int>::min();\n        sum = 0;\n\n        for (int i = middle + 1; i <= right; i++) {\n            sum += nums[i];\n            bestRightPrefix = max(bestRightPrefix, sum);\n        }\n\n        return max({\n            leftAnswer,\n            rightAnswer,\n            bestLeftSuffix + bestRightPrefix\n        });\n    }\n\npublic:\n    int maxSubArray(vector<int>& nums) {\n        return solve(nums, 0, static_cast<int>(nums.size()) - 1);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int maxSubArray(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<long long> prefix(n + 1);\n\n        for (int i = 0; i < n; i++) {\n            prefix[i + 1] = prefix[i] + nums[i];\n        }\n\n        long long minimumPrefix = 0;\n        long long answer = numeric_limits<long long>::min();\n\n        for (int right = 1; right <= n; right++) {\n            answer = max(answer, prefix[right] - minimumPrefix);\n            minimumPrefix = min(minimumPrefix, prefix[right]);\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int maxSubArray(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n        vector<int> dp(n);\n        dp[0] = nums[0];\n        int answer = dp[0];\n\n        for (int i = 1; i < n; i++) {\n            dp[i] = max(nums[i], nums[i] + dp[i - 1]);\n            answer = max(answer, dp[i]);\n        }\n\n        return answer;\n    }\n};"},"approach_6":{"cpp":"class Solution {\npublic:\n    int maxSubArray(vector<int>& nums) {\n        int current = nums[0];\n        int answer = nums[0];\n\n        for (int i = 1; i < static_cast<int>(nums.size()); i++) {\n            current = max(nums[i], current + nums[i]);\n            answer = max(answer, current);\n        }\n\n        return answer;\n    }\n};"}}}]
