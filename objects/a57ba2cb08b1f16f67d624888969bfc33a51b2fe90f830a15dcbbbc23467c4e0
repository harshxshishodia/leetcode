[{"leetcode_no":646,"name":"Maximum Length of Pair Chain","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& pairs,\n        int index,\n        int previousIndex\n    ) {\n        if (index == static_cast<int>(pairs.size())) {\n            return 0;\n        }\n\n        int skip = solve(\n            pairs,\n            index + 1,\n            previousIndex\n        );\n\n        int take = 0;\n\n        if (previousIndex == -1 ||\n            pairs[previousIndex][1] < pairs[index][0]) {\n            take = 1 + solve(\n                pairs,\n                index + 1,\n                index\n            );\n        }\n\n        return max(skip, take);\n    }\n\npublic:\n    int findLongestChain(vector<vector<int>>& pairs) {\n        sort(\n            pairs.begin(),\n            pairs.end()\n        );\n\n        return solve(pairs, 0, -1);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<vector<int>>& pairs,\n        int index,\n        int previousIndex,\n        vector<vector<int>>& memo\n    ) {\n        if (index == static_cast<int>(pairs.size())) {\n            return 0;\n        }\n\n        int previousState = previousIndex + 1;\n\n        if (memo[index][previousState] != -1) {\n            return memo[index][previousState];\n        }\n\n        int skip = solve(\n            pairs,\n            index + 1,\n            previousIndex,\n            memo\n        );\n\n        int take = 0;\n\n        if (previousIndex == -1 ||\n            pairs[previousIndex][1] < pairs[index][0]) {\n            take = 1 + solve(\n                pairs,\n                index + 1,\n                index,\n                memo\n            );\n        }\n\n        memo[index][previousState] = max(skip, take);\n        return memo[index][previousState];\n    }\n\npublic:\n    int findLongestChain(vector<vector<int>>& pairs) {\n        sort(\n            pairs.begin(),\n            pairs.end()\n        );\n\n        int n = static_cast<int>(pairs.size());\n\n        vector<vector<int>> memo(\n            n,\n            vector<int>(n + 1, -1)\n        );\n\n        return solve(pairs, 0, -1, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int findLongestChain(vector<vector<int>>& pairs) {\n        sort(\n            pairs.begin(),\n            pairs.end()\n        );\n\n        int n = static_cast<int>(pairs.size());\n        vector<int> dp(n, 1);\n        int answer = 1;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (pairs[j][1] < pairs[i][0]) {\n                    dp[i] = max(\n                        dp[i],\n                        dp[j] + 1\n                    );\n                }\n            }\n\n            answer = max(answer, dp[i]);\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int findLongestChain(vector<vector<int>>& pairs) {\n        sort(\n            pairs.begin(),\n            pairs.end(),\n            [](const vector<int>& first, const vector<int>& second) {\n                return first[1] < second[1];\n            }\n        );\n\n        int answer = 0;\n        int currentEnd = numeric_limits<int>::min();\n\n        for (const vector<int>& pair : pairs) {\n            if (pair[0] > currentEnd) {\n                answer++;\n                currentEnd = pair[1];\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
