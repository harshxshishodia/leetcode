[{"leetcode_no":118,"name":"Pascal's Triangle","solutions":{"approach_1":{"cpp":"class Solution {\n    int value(int row, int col) {\n        if (col == 0 || col == row) {\n            return 1;\n        }\n\n        return value(row - 1, col - 1) + value(row - 1, col);\n    }\n\npublic:\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> triangle;\n\n        for (int row = 0; row < numRows; row++) {\n            vector<int> current;\n\n            for (int col = 0; col <= row; col++) {\n                current.push_back(value(row, col));\n            }\n\n            triangle.push_back(current);\n        }\n\n        return triangle;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    long long combination(int n, int r) {\n        r = min(r, n - r);\n        long long result = 1;\n\n        for (int i = 1; i <= r; i++) {\n            result = result * (n - r + i) / i;\n        }\n\n        return result;\n    }\n\npublic:\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> triangle;\n\n        for (int row = 0; row < numRows; row++) {\n            vector<int> current;\n\n            for (int col = 0; col <= row; col++) {\n                current.push_back(static_cast<int>(combination(row, col)));\n            }\n\n            triangle.push_back(current);\n        }\n\n        return triangle;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int solve(int row, int col, vector<vector<int>>& dp) {\n        if (col == 0 || col == row) {\n            return 1;\n        }\n\n        if (dp[row][col] != -1) {\n            return dp[row][col];\n        }\n\n        dp[row][col] = solve(row - 1, col - 1, dp) + solve(row - 1, col, dp);\n        return dp[row][col];\n    }\n\npublic:\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> dp(numRows, vector<int>(numRows, -1));\n        vector<vector<int>> triangle;\n\n        for (int row = 0; row < numRows; row++) {\n            vector<int> current;\n\n            for (int col = 0; col <= row; col++) {\n                current.push_back(solve(row, col, dp));\n            }\n\n            triangle.push_back(current);\n        }\n\n        return triangle;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> triangle(numRows);\n\n        for (int row = 0; row < numRows; row++) {\n            triangle[row].resize(row + 1, 1);\n\n            for (int col = 1; col < row; col++) {\n                triangle[row][col] = triangle[row - 1][col - 1] + triangle[row - 1][col];\n            }\n        }\n\n        return triangle;\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    vector<vector<int>> generate(int numRows) {\n        vector<vector<int>> triangle;\n\n        for (int row = 0; row < numRows; row++) {\n            vector<int> current(row + 1);\n            long long value = 1;\n            current[0] = 1;\n\n            for (int col = 1; col <= row; col++) {\n                value = value * (row - col + 1) / col;\n                current[col] = static_cast<int>(value);\n            }\n\n            triangle.push_back(current);\n        }\n\n        return triangle;\n    }\n};"}}}]
