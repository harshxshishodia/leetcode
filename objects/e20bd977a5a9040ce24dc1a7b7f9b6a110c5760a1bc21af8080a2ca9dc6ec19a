[{"leetcode_no":712,"name":"Minimum ASCII Delete Sum for Two Strings","solutions":{"approach_1":{"cpp":"class Solution {\n    int suffixSum(\n        const string& s,\n        int index\n    ) {\n        int answer = 0;\n\n        for (int i = index;\n             i < static_cast<int>(s.size());\n             i++) {\n            answer += static_cast<unsigned char>(s[i]);\n        }\n\n        return answer;\n    }\n\n    int solve(\n        const string& first,\n        const string& second,\n        int i,\n        int j\n    ) {\n        if (i == static_cast<int>(first.size())) {\n            return suffixSum(\n                second,\n                j\n            );\n        }\n\n        if (j == static_cast<int>(second.size())) {\n            return suffixSum(\n                first,\n                i\n            );\n        }\n\n        if (first[i] == second[j]) {\n            return solve(\n                first,\n                second,\n                i + 1,\n                j + 1\n            );\n        }\n\n        return min(\n            static_cast<unsigned char>(first[i]) +\n            solve(\n                first,\n                second,\n                i + 1,\n                j\n            ),\n            static_cast<unsigned char>(second[j]) +\n            solve(\n                first,\n                second,\n                i,\n                j + 1\n            )\n        );\n    }\n\npublic:\n    int minimumDeleteSum(string s1, string s2) {\n        return solve(\n            s1,\n            s2,\n            0,\n            0\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    vector<int> suffixFirst;\n    vector<int> suffixSecond;\n\n    int solve(\n        const string& first,\n        const string& second,\n        int i,\n        int j,\n        vector<vector<int>>& memo\n    ) {\n        if (i == static_cast<int>(first.size())) {\n            return suffixSecond[j];\n        }\n\n        if (j == static_cast<int>(second.size())) {\n            return suffixFirst[i];\n        }\n\n        if (memo[i][j] != -1) {\n            return memo[i][j];\n        }\n\n        if (first[i] == second[j]) {\n            memo[i][j] = solve(\n                first,\n                second,\n                i + 1,\n                j + 1,\n                memo\n            );\n        } else {\n            memo[i][j] = min(\n                static_cast<unsigned char>(first[i]) +\n                solve(\n                    first,\n                    second,\n                    i + 1,\n                    j,\n                    memo\n                ),\n                static_cast<unsigned char>(second[j]) +\n                solve(\n                    first,\n                    second,\n                    i,\n                    j + 1,\n                    memo\n                )\n            );\n        }\n\n        return memo[i][j];\n    }\n\npublic:\n    int minimumDeleteSum(string s1, string s2) {\n        suffixFirst.assign(\n            s1.size() + 1,\n            0\n        );\n\n        suffixSecond.assign(\n            s2.size() + 1,\n            0\n        );\n\n        for (int i = static_cast<int>(s1.size()) - 1; i >= 0; i--) {\n            suffixFirst[i] =\n                suffixFirst[i + 1] +\n                static_cast<unsigned char>(s1[i]);\n        }\n\n        for (int j = static_cast<int>(s2.size()) - 1; j >= 0; j--) {\n            suffixSecond[j] =\n                suffixSecond[j + 1] +\n                static_cast<unsigned char>(s2[j]);\n        }\n\n        vector<vector<int>> memo(\n            s1.size(),\n            vector<int>(s2.size(), -1)\n        );\n\n        return solve(\n            s1,\n            s2,\n            0,\n            0,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int minimumDeleteSum(string s1, string s2) {\n        int firstLength = static_cast<int>(s1.size());\n        int secondLength = static_cast<int>(s2.size());\n\n        vector<vector<int>> dp(\n            firstLength + 1,\n            vector<int>(secondLength + 1)\n        );\n\n        for (int i = firstLength - 1; i >= 0; i--) {\n            dp[i][secondLength] =\n                dp[i + 1][secondLength] +\n                static_cast<unsigned char>(s1[i]);\n        }\n\n        for (int j = secondLength - 1; j >= 0; j--) {\n            dp[firstLength][j] =\n                dp[firstLength][j + 1] +\n                static_cast<unsigned char>(s2[j]);\n        }\n\n        for (int i = firstLength - 1; i >= 0; i--) {\n            for (int j = secondLength - 1; j >= 0; j--) {\n                if (s1[i] == s2[j]) {\n                    dp[i][j] =\n                        dp[i + 1][j + 1];\n                } else {\n                    dp[i][j] = min(\n                        static_cast<unsigned char>(s1[i]) +\n                        dp[i + 1][j],\n                        static_cast<unsigned char>(s2[j]) +\n                        dp[i][j + 1]\n                    );\n                }\n            }\n        }\n\n        return dp[0][0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int minimumDeleteSum(string s1, string s2) {\n        int firstLength = static_cast<int>(s1.size());\n        int secondLength = static_cast<int>(s2.size());\n\n        vector<vector<int>> common(\n            firstLength + 1,\n            vector<int>(secondLength + 1)\n        );\n\n        for (int i = 1; i <= firstLength; i++) {\n            for (int j = 1; j <= secondLength; j++) {\n                if (s1[i - 1] == s2[j - 1]) {\n                    common[i][j] =\n                        common[i - 1][j - 1] +\n                        static_cast<unsigned char>(s1[i - 1]);\n                } else {\n                    common[i][j] = max(\n                        common[i - 1][j],\n                        common[i][j - 1]\n                    );\n                }\n            }\n        }\n\n        int total = 0;\n\n        for (char character : s1) {\n            total += static_cast<unsigned char>(character);\n        }\n\n        for (char character : s2) {\n            total += static_cast<unsigned char>(character);\n        }\n\n        return\n            total -\n            2 * common[firstLength][secondLength];\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int minimumDeleteSum(string s1, string s2) {\n        if (s1.size() < s2.size()) {\n            swap(s1, s2);\n        }\n\n        int firstLength = static_cast<int>(s1.size());\n        int secondLength = static_cast<int>(s2.size());\n\n        vector<int> dp(secondLength + 1);\n\n        for (int j = 1; j <= secondLength; j++) {\n            dp[j] =\n                dp[j - 1] +\n                static_cast<unsigned char>(s2[j - 1]);\n        }\n\n        for (int i = 1; i <= firstLength; i++) {\n            int diagonal = dp[0];\n\n            dp[0] +=\n                static_cast<unsigned char>(s1[i - 1]);\n\n            for (int j = 1; j <= secondLength; j++) {\n                int fromTop = dp[j];\n\n                if (s1[i - 1] == s2[j - 1]) {\n                    dp[j] = diagonal;\n                } else {\n                    dp[j] = min(\n                        fromTop +\n                        static_cast<unsigned char>(s1[i - 1]),\n                        dp[j - 1] +\n                        static_cast<unsigned char>(s2[j - 1])\n                    );\n                }\n\n                diagonal = fromTop;\n            }\n        }\n\n        return dp[secondLength];\n    }\n};"}}}]
