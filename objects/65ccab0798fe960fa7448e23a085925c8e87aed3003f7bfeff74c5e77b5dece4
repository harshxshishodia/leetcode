[{"leetcode_no":634,"name":"Find the Derangement of An Array","solutions":{"approach_1":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n    int answer;\n\n    void generate(\n        int n,\n        int position,\n        vector<int>& permutation,\n        vector<bool>& used\n    ) {\n        if (position > n) {\n            answer++;\n\n            if (answer >= MOD) {\n                answer -= MOD;\n            }\n\n            return;\n        }\n\n        for (int value = 1; value <= n; value++) {\n            if (used[value] || value == position) {\n                continue;\n            }\n\n            used[value] = true;\n            permutation.push_back(value);\n\n            generate(\n                n,\n                position + 1,\n                permutation,\n                used\n            );\n\n            permutation.pop_back();\n            used[value] = false;\n        }\n    }\n\npublic:\n    int findDerangement(int n) {\n        answer = 0;\n        vector<int> permutation;\n        vector<bool> used(n + 1);\n\n        generate(\n            n,\n            1,\n            permutation,\n            used\n        );\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n\n    long long solve(int n) {\n        if (n == 0) {\n            return 1;\n        }\n\n        if (n == 1) {\n            return 0;\n        }\n\n        return\n            1LL *\n            (n - 1) *\n            (solve(n - 1) + solve(n - 2)) %\n            MOD;\n    }\n\npublic:\n    int findDerangement(int n) {\n        return static_cast<int>(solve(n));\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n\n    long long solve(\n        int n,\n        vector<long long>& memo\n    ) {\n        if (n == 0) {\n            return 1;\n        }\n\n        if (n == 1) {\n            return 0;\n        }\n\n        if (memo[n] != -1) {\n            return memo[n];\n        }\n\n        memo[n] =\n            1LL *\n            (n - 1) *\n            (solve(n - 1, memo) +\n             solve(n - 2, memo)) %\n            MOD;\n\n        return memo[n];\n    }\n\npublic:\n    int findDerangement(int n) {\n        vector<long long> memo(n + 1, -1);\n        return static_cast<int>(solve(n, memo));\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int findDerangement(int n) {\n        const int MOD = 1000000007;\n\n        if (n == 0) {\n            return 1;\n        }\n\n        vector<long long> dp(n + 1);\n        dp[0] = 1;\n\n        if (n >= 1) {\n            dp[1] = 0;\n        }\n\n        for (int value = 2; value <= n; value++) {\n            dp[value] =\n                1LL *\n                (value - 1) *\n                (dp[value - 1] + dp[value - 2]) %\n                MOD;\n        }\n\n        return static_cast<int>(dp[n]);\n    }\n};"},"approach_5":{"cpp":"class Solution {\npublic:\n    int findDerangement(int n) {\n        const int MOD = 1000000007;\n\n        if (n == 0) {\n            return 1;\n        }\n\n        if (n == 1) {\n            return 0;\n        }\n\n        long long previous2 = 1;\n        long long previous1 = 0;\n\n        for (int value = 2; value <= n; value++) {\n            long long current =\n                1LL *\n                (value - 1) *\n                (previous1 + previous2) %\n                MOD;\n\n            previous2 = previous1;\n            previous1 = current;\n        }\n\n        return static_cast<int>(previous1);\n    }\n};"}}}]
