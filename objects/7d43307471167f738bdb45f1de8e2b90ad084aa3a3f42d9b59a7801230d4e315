[{"leetcode_no":740,"name":"Delete and Earn","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<pair<int, int>>& values,\n        int index\n    ) {\n        if (index == static_cast<int>(values.size())) {\n            return 0;\n        }\n\n        int skip = solve(\n            values,\n            index + 1\n        );\n\n        int next = index + 1;\n\n        if (next < static_cast<int>(values.size()) &&\n            values[next].first == values[index].first + 1) {\n            next++;\n        }\n\n        int take =\n            values[index].first *\n            values[index].second +\n            solve(\n                values,\n                next\n            );\n\n        return max(skip, take);\n    }\n\npublic:\n    int deleteAndEarn(vector<int>& nums) {\n        map<int, int> frequency;\n\n        for (int number : nums) {\n            frequency[number]++;\n        }\n\n        vector<pair<int, int>> values(\n            frequency.begin(),\n            frequency.end()\n        );\n\n        return solve(\n            values,\n            0\n        );\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<pair<int, int>>& values,\n        int index,\n        vector<int>& memo\n    ) {\n        if (index == static_cast<int>(values.size())) {\n            return 0;\n        }\n\n        if (memo[index] != -1) {\n            return memo[index];\n        }\n\n        int skip = solve(\n            values,\n            index + 1,\n            memo\n        );\n\n        int next = index + 1;\n\n        if (next < static_cast<int>(values.size()) &&\n            values[next].first == values[index].first + 1) {\n            next++;\n        }\n\n        int take =\n            values[index].first *\n            values[index].second +\n            solve(\n                values,\n                next,\n                memo\n            );\n\n        memo[index] = max(skip, take);\n        return memo[index];\n    }\n\npublic:\n    int deleteAndEarn(vector<int>& nums) {\n        map<int, int> frequency;\n\n        for (int number : nums) {\n            frequency[number]++;\n        }\n\n        vector<pair<int, int>> values(\n            frequency.begin(),\n            frequency.end()\n        );\n\n        vector<int> memo(\n            values.size(),\n            -1\n        );\n\n        return solve(\n            values,\n            0,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int deleteAndEarn(vector<int>& nums) {\n        int maximum =\n            *max_element(\n                nums.begin(),\n                nums.end()\n            );\n\n        vector<int> points(maximum + 1);\n\n        for (int number : nums) {\n            points[number] += number;\n        }\n\n        vector<int> dp(maximum + 1);\n        dp[0] = 0;\n\n        if (maximum >= 1) {\n            dp[1] = points[1];\n        }\n\n        for (int value = 2; value <= maximum; value++) {\n            dp[value] = max(\n                dp[value - 1],\n                dp[value - 2] + points[value]\n            );\n        }\n\n        return dp[maximum];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int deleteAndEarn(vector<int>& nums) {\n        map<int, int> points;\n\n        for (int number : nums) {\n            points[number] += number;\n        }\n\n        int previousValue = -2;\n        int previous2 = 0;\n        int previous1 = 0;\n\n        for (auto [value, earned] : points) {\n            int current;\n\n            if (value == previousValue + 1) {\n                current = max(\n                    previous1,\n                    previous2 + earned\n                );\n            } else {\n                current =\n                    previous1 + earned;\n            }\n\n            previous2 = previous1;\n            previous1 = current;\n            previousValue = value;\n        }\n\n        return previous1;\n    }\n};"}}}]
