[{"leetcode_no":368,"name":"Largest Divisible Subset","solutions":{"approach_1":{"cpp":"class Solution {\n    vector<int> best;\n\n    bool valid(const vector<int>& subset) {\n        for (int i = 0; i < static_cast<int>(subset.size()); i++) {\n            for (int j = i + 1; j < static_cast<int>(subset.size()); j++) {\n                if (subset[j] % subset[i] != 0 &&\n                    subset[i] % subset[j] != 0) {\n                    return false;\n                }\n            }\n        }\n\n        return true;\n    }\n\n    void search(\n        const vector<int>& nums,\n        int index,\n        vector<int>& current\n    ) {\n        if (index == static_cast<int>(nums.size())) {\n            if (current.size() > best.size() && valid(current)) {\n                best = current;\n            }\n\n            return;\n        }\n\n        search(nums, index + 1, current);\n\n        current.push_back(nums[index]);\n        search(nums, index + 1, current);\n        current.pop_back();\n    }\n\npublic:\n    vector<int> largestDivisibleSubset(vector<int>& nums) {\n        best.clear();\n        vector<int> current;\n        search(nums, 0, current);\n        return best;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    vector<int> solve(\n        const vector<int>& nums,\n        int index\n    ) {\n        vector<int> best = {nums[index]};\n\n        for (int next = index + 1;\n             next < static_cast<int>(nums.size());\n             next++) {\n            if (nums[next] % nums[index] != 0) {\n                continue;\n            }\n\n            vector<int> candidate = solve(nums, next);\n            candidate.insert(candidate.begin(), nums[index]);\n\n            if (candidate.size() > best.size()) {\n                best = candidate;\n            }\n        }\n\n        return best;\n    }\n\npublic:\n    vector<int> largestDivisibleSubset(vector<int>& nums) {\n        sort(nums.begin(), nums.end());\n        vector<int> answer;\n\n        for (int i = 0; i < static_cast<int>(nums.size()); i++) {\n            vector<int> candidate = solve(nums, i);\n\n            if (candidate.size() > answer.size()) {\n                answer = candidate;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    vector<vector<int>> memo;\n    vector<bool> visited;\n\n    vector<int> solve(\n        const vector<int>& nums,\n        int index\n    ) {\n        if (visited[index]) {\n            return memo[index];\n        }\n\n        visited[index] = true;\n        vector<int> best = {nums[index]};\n\n        for (int next = index + 1;\n             next < static_cast<int>(nums.size());\n             next++) {\n            if (nums[next] % nums[index] != 0) {\n                continue;\n            }\n\n            vector<int> candidate = solve(nums, next);\n            candidate.insert(candidate.begin(), nums[index]);\n\n            if (candidate.size() > best.size()) {\n                best = candidate;\n            }\n        }\n\n        memo[index] = best;\n        return memo[index];\n    }\n\npublic:\n    vector<int> largestDivisibleSubset(vector<int>& nums) {\n        sort(nums.begin(), nums.end());\n        int n = static_cast<int>(nums.size());\n        memo.assign(n, {});\n        visited.assign(n, false);\n\n        vector<int> answer;\n\n        for (int i = 0; i < n; i++) {\n            vector<int> candidate = solve(nums, i);\n\n            if (candidate.size() > answer.size()) {\n                answer = candidate;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    vector<int> largestDivisibleSubset(vector<int>& nums) {\n        sort(nums.begin(), nums.end());\n        int n = static_cast<int>(nums.size());\n        vector<int> length(n, 1);\n        vector<int> parent(n, -1);\n        int bestIndex = 0;\n\n        for (int i = 0; i < n; i++) {\n            for (int j = 0; j < i; j++) {\n                if (nums[i] % nums[j] == 0 &&\n                    length[j] + 1 > length[i]) {\n                    length[i] = length[j] + 1;\n                    parent[i] = j;\n                }\n            }\n\n            if (length[i] > length[bestIndex]) {\n                bestIndex = i;\n            }\n        }\n\n        vector<int> answer;\n\n        while (bestIndex != -1) {\n            answer.push_back(nums[bestIndex]);\n            bestIndex = parent[bestIndex];\n        }\n\n        reverse(answer.begin(), answer.end());\n        return answer;\n    }\n};"}}}]
