[{"leetcode_no":337,"name":"House Robber III","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int rob(TreeNode* root) {\n        if (root == nullptr) {\n            return 0;\n        }\n\n        int take = root->val;\n\n        if (root->left != nullptr) {\n            take += rob(root->left->left);\n            take += rob(root->left->right);\n        }\n\n        if (root->right != nullptr) {\n            take += rob(root->right->left);\n            take += rob(root->right->right);\n        }\n\n        int skip = rob(root->left) + rob(root->right);\n\n        return max(take, skip);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    unordered_map<TreeNode*, int> memo;\n\npublic:\n    int rob(TreeNode* root) {\n        if (root == nullptr) {\n            return 0;\n        }\n\n        auto found = memo.find(root);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        int take = root->val;\n\n        if (root->left != nullptr) {\n            take += rob(root->left->left);\n            take += rob(root->left->right);\n        }\n\n        if (root->right != nullptr) {\n            take += rob(root->right->left);\n            take += rob(root->right->right);\n        }\n\n        int skip = rob(root->left) + rob(root->right);\n        memo[root] = max(take, skip);\n\n        return memo[root];\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    pair<int, int> solve(TreeNode* root) {\n        if (root == nullptr) {\n            return {0, 0};\n        }\n\n        auto left = solve(root->left);\n        auto right = solve(root->right);\n\n        int take = root->val + left.second + right.second;\n        int skip = max(left.first, left.second) +\n                   max(right.first, right.second);\n\n        return {take, skip};\n    }\n\npublic:\n    int rob(TreeNode* root) {\n        auto result = solve(root);\n        return max(result.first, result.second);\n    }\n};"}}}]
