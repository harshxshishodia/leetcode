[{"leetcode_no":638,"name":"Shopping Offers","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& price,\n        const vector<vector<int>>& special,\n        vector<int>& needs\n    ) {\n        int direct = 0;\n\n        for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n            direct += needs[i] * price[i];\n        }\n\n        int answer = direct;\n\n        for (const vector<int>& offer : special) {\n            bool applicable = true;\n            bool changes = false;\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                if (offer[i] > needs[i]) {\n                    applicable = false;\n                    break;\n                }\n\n                if (offer[i] > 0) {\n                    changes = true;\n                }\n            }\n\n            if (!applicable || !changes) {\n                continue;\n            }\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                needs[i] -= offer[i];\n            }\n\n            answer = min(\n                answer,\n                offer.back() +\n                solve(price, special, needs)\n            );\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                needs[i] += offer[i];\n            }\n        }\n\n        return answer;\n    }\n\npublic:\n    int shoppingOffers(\n        vector<int>& price,\n        vector<vector<int>>& special,\n        vector<int>& needs\n    ) {\n        return solve(price, special, needs);\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int shoppingOffers(\n        vector<int>& price,\n        vector<vector<int>>& special,\n        vector<int>& needs\n    ) {\n        int itemCount = static_cast<int>(needs.size());\n        vector<int> base(itemCount);\n        int states = 1;\n\n        for (int i = 0; i < itemCount; i++) {\n            base[i] = states;\n            states *= needs[i] + 1;\n        }\n\n        const int INF = 1000000000;\n        vector<int> dp(states, INF);\n        dp[0] = 0;\n\n        for (int state = 0; state < states; state++) {\n            if (dp[state] == INF) {\n                continue;\n            }\n\n            vector<int> count(itemCount);\n            int remainingState = state;\n\n            for (int i = itemCount - 1; i >= 0; i--) {\n                count[i] =\n                    remainingState / base[i] %\n                    (needs[i] + 1);\n            }\n\n            for (int item = 0; item < itemCount; item++) {\n                if (count[item] == needs[item]) {\n                    continue;\n                }\n\n                int nextState = state + base[item];\n\n                dp[nextState] = min(\n                    dp[nextState],\n                    dp[state] + price[item]\n                );\n            }\n\n            for (const vector<int>& offer : special) {\n                bool valid = true;\n                int nextState = state;\n                int regularCost = 0;\n                bool changes = false;\n\n                for (int item = 0; item < itemCount; item++) {\n                    if (count[item] + offer[item] > needs[item]) {\n                        valid = false;\n                        break;\n                    }\n\n                    nextState += offer[item] * base[item];\n                    regularCost += offer[item] * price[item];\n                    changes = changes || offer[item] > 0;\n                }\n\n                if (valid && changes && offer.back() < regularCost) {\n                    dp[nextState] = min(\n                        dp[nextState],\n                        dp[state] + offer.back()\n                    );\n                }\n            }\n        }\n\n        return dp[states - 1];\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    unordered_map<string, int> memo;\n    vector<vector<int>> offers;\n\n    string encode(const vector<int>& needs) {\n        string key;\n\n        for (int value : needs) {\n            key += to_string(value);\n            key += '#';\n        }\n\n        return key;\n    }\n\n    int solve(\n        const vector<int>& price,\n        vector<int>& needs\n    ) {\n        string key = encode(needs);\n\n        auto found = memo.find(key);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        int answer = 0;\n\n        for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n            answer += needs[i] * price[i];\n        }\n\n        for (const vector<int>& offer : offers) {\n            bool applicable = true;\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                if (offer[i] > needs[i]) {\n                    applicable = false;\n                    break;\n                }\n            }\n\n            if (!applicable) {\n                continue;\n            }\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                needs[i] -= offer[i];\n            }\n\n            answer = min(\n                answer,\n                offer.back() + solve(price, needs)\n            );\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                needs[i] += offer[i];\n            }\n        }\n\n        memo[key] = answer;\n        return memo[key];\n    }\n\npublic:\n    int shoppingOffers(\n        vector<int>& price,\n        vector<vector<int>>& special,\n        vector<int>& needs\n    ) {\n        offers.clear();\n        memo.clear();\n\n        for (const vector<int>& offer : special) {\n            int regularCost = 0;\n            bool useful = false;\n\n            for (int i = 0; i < static_cast<int>(needs.size()); i++) {\n                regularCost += offer[i] * price[i];\n                useful = useful || offer[i] > 0;\n            }\n\n            if (useful && offer.back() < regularCost) {\n                offers.push_back(offer);\n            }\n        }\n\n        return solve(price, needs);\n    }\n};"}}}]
