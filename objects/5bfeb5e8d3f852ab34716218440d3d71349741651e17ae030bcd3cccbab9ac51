[{"leetcode_no":518,"name":"Coin Change II","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& coins,\n        int index,\n        int amount\n    ) {\n        if (amount == 0) {\n            return 1;\n        }\n\n        if (index == static_cast<int>(coins.size()) || amount < 0) {\n            return 0;\n        }\n\n        int skip = solve(\n            coins,\n            index + 1,\n            amount\n        );\n\n        int take = solve(\n            coins,\n            index,\n            amount - coins[index]\n        );\n\n        return skip + take;\n    }\n\npublic:\n    int change(int amount, vector<int>& coins) {\n        return solve(coins, 0, amount);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(\n        const vector<int>& coins,\n        int index,\n        int amount,\n        vector<vector<int>>& memo\n    ) {\n        if (amount == 0) {\n            return 1;\n        }\n\n        if (index == static_cast<int>(coins.size()) || amount < 0) {\n            return 0;\n        }\n\n        if (memo[index][amount] != -1) {\n            return memo[index][amount];\n        }\n\n        int skip = solve(\n            coins,\n            index + 1,\n            amount,\n            memo\n        );\n\n        int take = 0;\n\n        if (coins[index] <= amount) {\n            take = solve(\n                coins,\n                index,\n                amount - coins[index],\n                memo\n            );\n        }\n\n        memo[index][amount] = skip + take;\n        return memo[index][amount];\n    }\n\npublic:\n    int change(int amount, vector<int>& coins) {\n        vector<vector<int>> memo(\n            coins.size(),\n            vector<int>(amount + 1, -1)\n        );\n\n        return solve(\n            coins,\n            0,\n            amount,\n            memo\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int change(int amount, vector<int>& coins) {\n        int n = static_cast<int>(coins.size());\n\n        vector<vector<unsigned long long>> dp(\n            n + 1,\n            vector<unsigned long long>(amount + 1)\n        );\n\n        for (int index = 0; index <= n; index++) {\n            dp[index][0] = 1;\n        }\n\n        for (int index = n - 1; index >= 0; index--) {\n            for (int value = 1; value <= amount; value++) {\n                dp[index][value] = dp[index + 1][value];\n\n                if (coins[index] <= value) {\n                    dp[index][value] +=\n                        dp[index][value - coins[index]];\n                }\n            }\n        }\n\n        return static_cast<int>(dp[0][amount]);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int change(int amount, vector<int>& coins) {\n        vector<unsigned long long> dp(amount + 1);\n        dp[0] = 1;\n\n        for (int coin : coins) {\n            for (int value = coin; value <= amount; value++) {\n                dp[value] += dp[value - coin];\n            }\n        }\n\n        return static_cast<int>(dp[amount]);\n    }\n};"}}}]
