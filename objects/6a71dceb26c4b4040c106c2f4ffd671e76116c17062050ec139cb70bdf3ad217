[{"leetcode_no":131,"name":"Palindrome Partitioning","solutions":{"approach_1":{"cpp":"class Solution {\n    bool isPalindrome(const string& s, int left, int right) {\n        while (left < right) {\n            if (s[left] != s[right]) {\n                return false;\n            }\n\n            left++;\n            right--;\n        }\n\n        return true;\n    }\n\npublic:\n    vector<vector<string>> partition(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<string>> answer;\n        int cutPositions = n - 1;\n        int totalMasks = 1 << cutPositions;\n\n        for (int mask = 0; mask < totalMasks; mask++) {\n            vector<string> current;\n            int start = 0;\n            bool valid = true;\n\n            for (int position = 0; position < n; position++) {\n                bool makeCut = position == n - 1 ||\n                               ((mask & (1 << position)) != 0);\n\n                if (!makeCut) {\n                    continue;\n                }\n\n                if (!isPalindrome(s, start, position)) {\n                    valid = false;\n                    break;\n                }\n\n                current.push_back(s.substr(start, position - start + 1));\n                start = position + 1;\n            }\n\n            if (valid) {\n                answer.push_back(current);\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    bool isPalindrome(const string& s, int left, int right) {\n        while (left < right) {\n            if (s[left] != s[right]) {\n                return false;\n            }\n\n            left++;\n            right--;\n        }\n\n        return true;\n    }\n\n    void backtrack(\n        const string& s,\n        int start,\n        vector<string>& current,\n        vector<vector<string>>& answer\n    ) {\n        if (start == static_cast<int>(s.size())) {\n            answer.push_back(current);\n            return;\n        }\n\n        for (int end = start; end < static_cast<int>(s.size()); end++) {\n            if (!isPalindrome(s, start, end)) {\n                continue;\n            }\n\n            current.push_back(s.substr(start, end - start + 1));\n            backtrack(s, end + 1, current, answer);\n            current.pop_back();\n        }\n    }\n\npublic:\n    vector<vector<string>> partition(string s) {\n        vector<vector<string>> answer;\n        vector<string> current;\n        backtrack(s, 0, current, answer);\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\n    int palindrome(\n        const string& s,\n        int left,\n        int right,\n        vector<vector<int>>& memo\n    ) {\n        if (left >= right) {\n            return 1;\n        }\n\n        if (memo[left][right] != -1) {\n            return memo[left][right];\n        }\n\n        if (s[left] != s[right]) {\n            memo[left][right] = 0;\n        } else {\n            memo[left][right] = palindrome(s, left + 1, right - 1, memo);\n        }\n\n        return memo[left][right];\n    }\n\n    void backtrack(\n        const string& s,\n        int start,\n        vector<vector<int>>& memo,\n        vector<string>& current,\n        vector<vector<string>>& answer\n    ) {\n        if (start == static_cast<int>(s.size())) {\n            answer.push_back(current);\n            return;\n        }\n\n        for (int end = start; end < static_cast<int>(s.size()); end++) {\n            if (!palindrome(s, start, end, memo)) {\n                continue;\n            }\n\n            current.push_back(s.substr(start, end - start + 1));\n            backtrack(s, end + 1, memo, current, answer);\n            current.pop_back();\n        }\n    }\n\npublic:\n    vector<vector<string>> partition(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<int>> memo(n, vector<int>(n, -1));\n        vector<vector<string>> answer;\n        vector<string> current;\n\n        backtrack(s, 0, memo, current, answer);\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\n    void backtrack(\n        const string& s,\n        int start,\n        const vector<vector<bool>>& palindrome,\n        vector<string>& current,\n        vector<vector<string>>& answer\n    ) {\n        if (start == static_cast<int>(s.size())) {\n            answer.push_back(current);\n            return;\n        }\n\n        for (int end = start; end < static_cast<int>(s.size()); end++) {\n            if (!palindrome[start][end]) {\n                continue;\n            }\n\n            current.push_back(s.substr(start, end - start + 1));\n            backtrack(s, end + 1, palindrome, current, answer);\n            current.pop_back();\n        }\n    }\n\npublic:\n    vector<vector<string>> partition(string s) {\n        int n = static_cast<int>(s.size());\n        vector<vector<bool>> palindrome(n, vector<bool>(n));\n\n        for (int right = 0; right < n; right++) {\n            for (int left = right; left >= 0; left--) {\n                palindrome[left][right] =\n                    s[left] == s[right] &&\n                    (right - left <= 2 || palindrome[left + 1][right - 1]);\n            }\n        }\n\n        vector<vector<string>> answer;\n        vector<string> current;\n        backtrack(s, 0, palindrome, current, answer);\n        return answer;\n    }\n};"}}}]
