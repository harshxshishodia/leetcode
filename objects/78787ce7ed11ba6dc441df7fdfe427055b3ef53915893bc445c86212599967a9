[{"leetcode_no":91,"name":"Decode Ways","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(const string& s, int index) {\n        if (index == static_cast<int>(s.size())) {\n            return 1;\n        }\n\n        if (s[index] == '0') {\n            return 0;\n        }\n\n        int answer = solve(s, index + 1);\n\n        if (index + 1 < static_cast<int>(s.size())) {\n            int value = (s[index] - '0') * 10 + (s[index + 1] - '0');\n\n            if (value >= 10 && value <= 26) {\n                answer += solve(s, index + 2);\n            }\n        }\n\n        return answer;\n    }\n\npublic:\n    int numDecodings(string s) {\n        return solve(s, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(const string& s, int index, vector<int>& dp) {\n        if (index == static_cast<int>(s.size())) {\n            return 1;\n        }\n\n        if (s[index] == '0') {\n            return 0;\n        }\n\n        if (dp[index] != -1) {\n            return dp[index];\n        }\n\n        int answer = solve(s, index + 1, dp);\n\n        if (index + 1 < static_cast<int>(s.size())) {\n            int value = (s[index] - '0') * 10 + (s[index + 1] - '0');\n\n            if (value >= 10 && value <= 26) {\n                answer += solve(s, index + 2, dp);\n            }\n        }\n\n        dp[index] = answer;\n        return dp[index];\n    }\n\npublic:\n    int numDecodings(string s) {\n        vector<int> dp(s.size(), -1);\n        return solve(s, 0, dp);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int numDecodings(string s) {\n        int n = static_cast<int>(s.size());\n        vector<int> dp(n + 1);\n        dp[n] = 1;\n\n        for (int index = n - 1; index >= 0; index--) {\n            if (s[index] == '0') {\n                dp[index] = 0;\n                continue;\n            }\n\n            dp[index] = dp[index + 1];\n\n            if (index + 1 < n) {\n                int value = (s[index] - '0') * 10 + (s[index + 1] - '0');\n\n                if (value >= 10 && value <= 26) {\n                    dp[index] += dp[index + 2];\n                }\n            }\n        }\n\n        return dp[0];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int numDecodings(string s) {\n        int n = static_cast<int>(s.size());\n        int next1 = 1;\n        int next2 = 0;\n\n        for (int index = n - 1; index >= 0; index--) {\n            int current = 0;\n\n            if (s[index] != '0') {\n                current = next1;\n\n                if (index + 1 < n) {\n                    int value = (s[index] - '0') * 10 + (s[index + 1] - '0');\n\n                    if (value >= 10 && value <= 26) {\n                        current += index + 2 == n ? 1 : next2;\n                    }\n                }\n            }\n\n            next2 = next1;\n            next1 = current;\n        }\n\n        return next1;\n    }\n};"}}}]
