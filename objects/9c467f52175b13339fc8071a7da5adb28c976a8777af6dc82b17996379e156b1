[{"leetcode_no":271,"name":"Encode and Decode Strings","solutions":{"approach_1":{"cpp":"class Codec {\npublic:\n    string encode(vector<string>& strs) {\n        string encodedString = \"\";\n        for (const string& s : strs) {\n            string escaped = \"\";\n            for (char c : s) {\n                if (c == '/') {\n                    escaped += \"//\";\n                } else if (c == ':') {\n                    escaped += \"/:\";\n                } else {\n                    escaped += c;\n                }\n            }\n            encodedString += escaped + \":;\";\n        }\n        return encodedString;\n    }\n\n    vector<string> decode(string s) {\n        vector<string> decodedStrings;\n        string currentWord = \"\";\n        int i = 0;\n        int n = static_cast<int>(s.size());\n        while (i < n) {\n            if (i + 1 < n && s[i] == ':' && s[i + 1] == ';') {\n                decodedStrings.push_back(currentWord);\n                currentWord = \"\";\n                i += 2;\n            } else if (i + 1 < n && s[i] == '/' && s[i + 1] == '/') {\n                currentWord += '/';\n                i += 2;\n            } else if (i + 1 < n && s[i] == '/' && s[i + 1] == ':') {\n                currentWord += ':';\n                i += 2;\n            } else {\n                currentWord += s[i++];\n            }\n        }\n        return decodedStrings;\n    }\n};"},"approach_2":{"cpp":"class Codec {\npublic:\n    string encode(vector<string>& strs) {\n        string encoded = \"\";\n        for (const string& s : strs) {\n            encoded += to_string(s.size()) + \"#\" + s;\n        }\n        return encoded;\n    }\n\n    vector<string> decode(string s) {\n        vector<string> result;\n        int i = 0;\n        int n = static_cast<int>(s.size());\n        while (i < n) {\n            int hashPos = s.find('#', i);\n            int len = stoi(s.substr(i, hashPos - i));\n            result.push_back(s.substr(hashPos + 1, len));\n            i = hashPos + 1 + len;\n        }\n        return result;\n    }\n};"}}}]
