[{"leetcode_no":264,"name":"Ugly Number II","solutions":{"approach_1":{"cpp":"class Solution {\n    bool isUgly(int number) {\n        if (number <= 0) {\n            return false;\n        }\n\n        for (int factor : {2, 3, 5}) {\n            while (number % factor == 0) {\n                number /= factor;\n            }\n        }\n\n        return number == 1;\n    }\n\npublic:\n    int nthUglyNumber(int n) {\n        int count = 0;\n        int number = 0;\n\n        while (count < n) {\n            number++;\n\n            if (isUgly(number)) {\n                count++;\n            }\n        }\n\n        return number;\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int nthUglyNumber(int n) {\n        priority_queue<\n            long long,\n            vector<long long>,\n            greater<long long>\n        > minimumHeap;\n\n        unordered_set<long long> seen;\n        minimumHeap.push(1);\n        seen.insert(1);\n        long long current = 1;\n\n        for (int i = 0; i < n; i++) {\n            current = minimumHeap.top();\n            minimumHeap.pop();\n\n            for (long long factor : {2LL, 3LL, 5LL}) {\n                long long next = current * factor;\n\n                if (seen.insert(next).second) {\n                    minimumHeap.push(next);\n                }\n            }\n        }\n\n        return static_cast<int>(current);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int nthUglyNumber(int n) {\n        vector<long long> ugly(n);\n        ugly[0] = 1;\n\n        int index2 = 0;\n        int index3 = 0;\n        int index5 = 0;\n\n        for (int i = 1; i < n; i++) {\n            long long next2 = ugly[index2] * 2;\n            long long next3 = ugly[index3] * 3;\n            long long next5 = ugly[index5] * 5;\n            long long next = min({next2, next3, next5});\n\n            ugly[i] = next;\n\n            if (next == next2) {\n                index2++;\n            }\n\n            if (next == next3) {\n                index3++;\n            }\n\n            if (next == next5) {\n                index5++;\n            }\n        }\n\n        return static_cast<int>(ugly[n - 1]);\n    }\n};"}}}]
