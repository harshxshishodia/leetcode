[{"leetcode_no":838,"name":"Push Dominoes","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    string pushDominoes(string dominoes) {\n        string current = dominoes;\n        int n = static_cast<int>(dominoes.size());\n\n        while (true) {\n            string next = current;\n            bool changed = false;\n\n            for (int i = 0; i < n; i++) {\n                if (current[i] != '.') {\n                    continue;\n                }\n\n                bool pushedRight =\n                    i > 0 &&\n                    current[i - 1] == 'R';\n\n                bool pushedLeft =\n                    i + 1 < n &&\n                    current[i + 1] == 'L';\n\n                if (pushedRight == pushedLeft) {\n                    continue;\n                }\n\n                next[i] =\n                    pushedRight\n                        ? 'R'\n                        : 'L';\n\n                changed = true;\n            }\n\n            if (!changed) {\n                return current;\n            }\n\n            current = next;\n        }\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    string pushDominoes(string dominoes) {\n        int n = static_cast<int>(dominoes.size());\n\n        vector<int> rightForce(\n            n,\n            n\n        );\n\n        vector<int> leftForce(\n            n,\n            n\n        );\n\n        int distance = n;\n\n        for (int i = 0; i < n; i++) {\n            if (dominoes[i] == 'R') {\n                distance = 0;\n            } else if (dominoes[i] == 'L') {\n                distance = n;\n            } else if (distance < n) {\n                distance++;\n            }\n\n            rightForce[i] = distance;\n        }\n\n        distance = n;\n\n        for (int i = n - 1; i >= 0; i--) {\n            if (dominoes[i] == 'L') {\n                distance = 0;\n            } else if (dominoes[i] == 'R') {\n                distance = n;\n            } else if (distance < n) {\n                distance++;\n            }\n\n            leftForce[i] = distance;\n        }\n\n        string answer = dominoes;\n\n        for (int i = 0; i < n; i++) {\n            if (rightForce[i] < leftForce[i]) {\n                answer[i] = 'R';\n            } else if (leftForce[i] < rightForce[i]) {\n                answer[i] = 'L';\n            } else {\n                answer[i] = '.';\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    string pushDominoes(string dominoes) {\n        string extended =\n            \"L\" +\n            dominoes +\n            \"R\";\n\n        int previous = 0;\n\n        for (int current = 1;\n             current < static_cast<int>(extended.size());\n             current++) {\n            if (extended[current] == '.') {\n                continue;\n            }\n\n            if (current - previous > 1) {\n                char left =\n                    extended[previous];\n\n                char right =\n                    extended[current];\n\n                if (left == right) {\n                    for (int i = previous + 1; i < current; i++) {\n                        extended[i] = left;\n                    }\n                } else if (left == 'R' &&\n                           right == 'L') {\n                    int first =\n                        previous + 1;\n\n                    int second =\n                        current - 1;\n\n                    while (first < second) {\n                        extended[first] = 'R';\n                        extended[second] = 'L';\n                        first++;\n                        second--;\n                    }\n                }\n            }\n\n            previous = current;\n        }\n\n        return extended.substr(\n            1,\n            dominoes.size()\n        );\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    string pushDominoes(string dominoes) {\n        int n = static_cast<int>(dominoes.size());\n        vector<int> force(n);\n\n        int value = 0;\n\n        for (int i = 0; i < n; i++) {\n            if (dominoes[i] == 'R') {\n                value = n;\n            } else if (dominoes[i] == 'L') {\n                value = 0;\n            } else {\n                value = max(\n                    value - 1,\n                    0\n                );\n            }\n\n            force[i] += value;\n        }\n\n        value = 0;\n\n        for (int i = n - 1; i >= 0; i--) {\n            if (dominoes[i] == 'L') {\n                value = n;\n            } else if (dominoes[i] == 'R') {\n                value = 0;\n            } else {\n                value = max(\n                    value - 1,\n                    0\n                );\n            }\n\n            force[i] -= value;\n        }\n\n        string answer = dominoes;\n\n        for (int i = 0; i < n; i++) {\n            if (force[i] > 0) {\n                answer[i] = 'R';\n            } else if (force[i] < 0) {\n                answer[i] = 'L';\n            } else {\n                answer[i] = '.';\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
