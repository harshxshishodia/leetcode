[{"leetcode_no":935,"name":"Knight Dialer","solutions":{"approach_1":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n\n    long long solve(\n        int digit,\n        int remaining\n    ) {\n        if (remaining == 1) {\n            return 1;\n        }\n\n        static const vector<vector<int>> next = {\n            {4, 6},\n            {6, 8},\n            {7, 9},\n            {4, 8},\n            {0, 3, 9},\n            {},\n            {0, 1, 7},\n            {2, 6},\n            {1, 3},\n            {2, 4}\n        };\n\n        long long answer = 0;\n\n        for (int nextDigit : next[digit]) {\n            answer += solve(\n                nextDigit,\n                remaining - 1\n            );\n\n            answer %= MOD;\n        }\n\n        return answer;\n    }\n\npublic:\n    int knightDialer(int n) {\n        long long answer = 0;\n\n        for (int digit = 0; digit <= 9; digit++) {\n            answer += solve(\n                digit,\n                n\n            );\n\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n    vector<array<long long, 10>> memo;\n    vector<array<bool, 10>> visited;\n\n    long long solve(\n        int digit,\n        int remaining\n    ) {\n        if (remaining == 1) {\n            return 1;\n        }\n\n        if (visited[remaining][digit]) {\n            return memo[remaining][digit];\n        }\n\n        visited[remaining][digit] = true;\n\n        static const vector<vector<int>> next = {\n            {4, 6},\n            {6, 8},\n            {7, 9},\n            {4, 8},\n            {0, 3, 9},\n            {},\n            {0, 1, 7},\n            {2, 6},\n            {1, 3},\n            {2, 4}\n        };\n\n        long long answer = 0;\n\n        for (int nextDigit : next[digit]) {\n            answer += solve(\n                nextDigit,\n                remaining - 1\n            );\n\n            answer %= MOD;\n        }\n\n        memo[remaining][digit] = answer;\n        return memo[remaining][digit];\n    }\n\npublic:\n    int knightDialer(int n) {\n        memo.assign(\n            n + 1,\n            {}\n        );\n\n        visited.assign(\n            n + 1,\n            {}\n        );\n\n        long long answer = 0;\n\n        for (int digit = 0; digit <= 9; digit++) {\n            answer += solve(\n                digit,\n                n\n            );\n\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int knightDialer(int n) {\n        const int MOD = 1000000007;\n\n        static const vector<vector<int>> next = {\n            {4, 6},\n            {6, 8},\n            {7, 9},\n            {4, 8},\n            {0, 3, 9},\n            {},\n            {0, 1, 7},\n            {2, 6},\n            {1, 3},\n            {2, 4}\n        };\n\n        vector<vector<long long>> dp(\n            n + 1,\n            vector<long long>(10)\n        );\n\n        for (int digit = 0; digit <= 9; digit++) {\n            dp[1][digit] = 1;\n        }\n\n        for (int length = 2; length <= n; length++) {\n            for (int digit = 0; digit <= 9; digit++) {\n                for (int nextDigit : next[digit]) {\n                    dp[length][nextDigit] +=\n                        dp[length - 1][digit];\n\n                    dp[length][nextDigit] %= MOD;\n                }\n            }\n        }\n\n        long long answer = 0;\n\n        for (int digit = 0; digit <= 9; digit++) {\n            answer += dp[n][digit];\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int knightDialer(int n) {\n        const int MOD = 1000000007;\n\n        static const vector<vector<int>> next = {\n            {4, 6},\n            {6, 8},\n            {7, 9},\n            {4, 8},\n            {0, 3, 9},\n            {},\n            {0, 1, 7},\n            {2, 6},\n            {1, 3},\n            {2, 4}\n        };\n\n        vector<long long> current(\n            10,\n            1\n        );\n\n        for (int length = 2; length <= n; length++) {\n            vector<long long> nextCount(10);\n\n            for (int digit = 0; digit <= 9; digit++) {\n                for (int nextDigit : next[digit]) {\n                    nextCount[nextDigit] +=\n                        current[digit];\n\n                    nextCount[nextDigit] %= MOD;\n                }\n            }\n\n            current = nextCount;\n        }\n\n        long long answer = 0;\n\n        for (long long count : current) {\n            answer += count;\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_5":{"cpp":"class Solution {\n    static constexpr long long MOD = 1000000007;\n    using Matrix = vector<vector<long long>>;\n\n    Matrix multiply(\n        const Matrix& first,\n        const Matrix& second\n    ) {\n        int n = static_cast<int>(first.size());\n\n        Matrix result(\n            n,\n            vector<long long>(n)\n        );\n\n        for (int i = 0; i < n; i++) {\n            for (int k = 0; k < n; k++) {\n                if (first[i][k] == 0) {\n                    continue;\n                }\n\n                for (int j = 0; j < n; j++) {\n                    result[i][j] =\n                        (\n                            result[i][j] +\n                            first[i][k] *\n                            second[k][j]\n                        ) %\n                        MOD;\n                }\n            }\n        }\n\n        return result;\n    }\n\n    Matrix power(\n        Matrix base,\n        int exponent\n    ) {\n        int n = static_cast<int>(base.size());\n\n        Matrix result(\n            n,\n            vector<long long>(n)\n        );\n\n        for (int i = 0; i < n; i++) {\n            result[i][i] = 1;\n        }\n\n        while (exponent > 0) {\n            if (exponent % 2 == 1) {\n                result = multiply(\n                    result,\n                    base\n                );\n            }\n\n            base = multiply(\n                base,\n                base\n            );\n\n            exponent /= 2;\n        }\n\n        return result;\n    }\n\npublic:\n    int knightDialer(int n) {\n        if (n == 1) {\n            return 10;\n        }\n\n        Matrix transition(\n            10,\n            vector<long long>(10)\n        );\n\n        static const vector<vector<int>> next = {\n            {4, 6},\n            {6, 8},\n            {7, 9},\n            {4, 8},\n            {0, 3, 9},\n            {},\n            {0, 1, 7},\n            {2, 6},\n            {1, 3},\n            {2, 4}\n        };\n\n        for (int from = 0; from <= 9; from++) {\n            for (int to : next[from]) {\n                transition[to][from] = 1;\n            }\n        }\n\n        Matrix result = power(\n            transition,\n            n - 1\n        );\n\n        long long answer = 0;\n\n        for (int row = 0; row < 10; row++) {\n            for (int col = 0; col < 10; col++) {\n                answer += result[row][col];\n                answer %= MOD;\n            }\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
