[{"leetcode_no":933,"name":"Number of Recent Calls","solutions":{"approach_1":{"cpp":"class RecentCounter {\n    vector<int> pings;\n\npublic:\n    RecentCounter() {}\n\n    int ping(int t) {\n        pings.push_back(t);\n        auto it = lower_bound(pings.begin(), pings.end(), t - 3000);\n        return static_cast<int>(pings.end() - it);\n    }\n};"},"approach_2":{"cpp":"class RecentCounter {\n    queue<int> pingQueue;\n\npublic:\n    RecentCounter() {}\n\n    int ping(int t) {\n        pingQueue.push(t);\n        while (!pingQueue.empty() && pingQueue.front() < t - 3000) {\n            pingQueue.pop();\n        }\n        return static_cast<int>(pingQueue.size());\n    }\n};"}}}]
