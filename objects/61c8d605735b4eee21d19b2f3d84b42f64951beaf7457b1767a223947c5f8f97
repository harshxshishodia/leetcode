[{"leetcode_no":198,"name":"House Robber","solutions":{"approach_1":{"cpp":"class Solution {\n    int solve(const vector<int>& nums, int index) {\n        if (index >= static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        int skip = solve(nums, index + 1);\n        int take = nums[index] + solve(nums, index + 2);\n\n        return max(skip, take);\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        return solve(nums, 0);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    int solve(const vector<int>& nums, int index, vector<int>& memo) {\n        if (index >= static_cast<int>(nums.size())) {\n            return 0;\n        }\n\n        if (memo[index] != -1) {\n            return memo[index];\n        }\n\n        int skip = solve(nums, index + 1, memo);\n        int take = nums[index] + solve(nums, index + 2, memo);\n\n        memo[index] = max(skip, take);\n        return memo[index];\n    }\n\npublic:\n    int rob(vector<int>& nums) {\n        vector<int> memo(nums.size(), -1);\n        return solve(nums, 0, memo);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int rob(vector<int>& nums) {\n        int n = static_cast<int>(nums.size());\n\n        if (n == 1) {\n            return nums[0];\n        }\n\n        vector<int> dp(n + 1);\n        dp[1] = nums[0];\n\n        for (int i = 2; i <= n; i++) {\n            dp[i] = max(\n                dp[i - 1],\n                dp[i - 2] + nums[i - 1]\n            );\n        }\n\n        return dp[n];\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int rob(vector<int>& nums) {\n        int previous2 = 0;\n        int previous1 = 0;\n\n        for (int money : nums) {\n            int current = max(previous1, previous2 + money);\n            previous2 = previous1;\n            previous1 = current;\n        }\n\n        return previous1;\n    }\n};"}}}]
