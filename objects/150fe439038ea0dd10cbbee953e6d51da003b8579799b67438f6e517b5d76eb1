[{"leetcode_no":788,"name":"Rotated Digits","solutions":{"approach_1":{"cpp":"class Solution {\n    bool good(int number) {\n        bool changed = false;\n\n        while (number > 0) {\n            int digit = number % 10;\n\n            if (digit == 3 ||\n                digit == 4 ||\n                digit == 7) {\n                return false;\n            }\n\n            if (digit == 2 ||\n                digit == 5 ||\n                digit == 6 ||\n                digit == 9) {\n                changed = true;\n            }\n\n            number /= 10;\n        }\n\n        return changed;\n    }\n\npublic:\n    int rotatedDigits(int n) {\n        int answer = 0;\n\n        for (int number = 1; number <= n; number++) {\n            if (good(number)) {\n                answer++;\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    string digits;\n    int memo[6][2][2];\n    bool visited[6][2][2];\n\n    int solve(\n        int position,\n        int started,\n        int changed,\n        bool tight\n    ) {\n        if (position == static_cast<int>(digits.size())) {\n            return started && changed;\n        }\n\n        if (!tight &&\n            visited[position][started][changed]) {\n            return memo[position][started][changed];\n        }\n\n        int limit =\n            tight\n                ? digits[position] - '0'\n                : 9;\n\n        int answer = 0;\n\n        for (int digit = 0; digit <= limit; digit++) {\n            bool nextTight =\n                tight && digit == limit;\n\n            if (!started && digit == 0) {\n                answer += solve(\n                    position + 1,\n                    0,\n                    0,\n                    nextTight\n                );\n\n                continue;\n            }\n\n            if (digit == 3 ||\n                digit == 4 ||\n                digit == 7) {\n                continue;\n            }\n\n            int nextChanged =\n                changed ||\n                digit == 2 ||\n                digit == 5 ||\n                digit == 6 ||\n                digit == 9;\n\n            answer += solve(\n                position + 1,\n                1,\n                nextChanged,\n                nextTight\n            );\n        }\n\n        if (!tight) {\n            visited[position][started][changed] = true;\n            memo[position][started][changed] = answer;\n        }\n\n        return answer;\n    }\n\npublic:\n    int rotatedDigits(int n) {\n        digits = to_string(n);\n        memset(\n            visited,\n            0,\n            sizeof(visited)\n        );\n\n        return solve(\n            0,\n            0,\n            0,\n            true\n        );\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int rotatedDigits(int n) {\n        string digits = to_string(n);\n\n        array<array<long long, 2>, 2> dp = {};\n        dp[1][0] = 1;\n\n        for (char character : digits) {\n            int limitDigit = character - '0';\n\n            array<array<long long, 2>, 2> next = {};\n\n            for (int tight = 0; tight <= 1; tight++) {\n                for (int changed = 0; changed <= 1; changed++) {\n                    long long ways = dp[tight][changed];\n\n                    if (ways == 0) {\n                        continue;\n                    }\n\n                    int limit =\n                        tight\n                            ? limitDigit\n                            : 9;\n\n                    for (int digit = 0; digit <= limit; digit++) {\n                        if (digit == 3 ||\n                            digit == 4 ||\n                            digit == 7) {\n                            continue;\n                        }\n\n                        int nextTight =\n                            tight && digit == limitDigit;\n\n                        int nextChanged =\n                            changed ||\n                            digit == 2 ||\n                            digit == 5 ||\n                            digit == 6 ||\n                            digit == 9;\n\n                        next[nextTight][nextChanged] += ways;\n                    }\n                }\n            }\n\n            dp = next;\n        }\n\n        return static_cast<int>(\n            dp[0][1] +\n            dp[1][1]\n        );\n    }\n};"}}}]
