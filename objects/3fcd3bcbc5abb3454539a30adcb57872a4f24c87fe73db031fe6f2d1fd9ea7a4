[{"leetcode_no":251,"name":"Flatten 2D Vector","solutions":{"approach_1":{"cpp":"class Vector2D {\n    vector<int> elements;\n    int currentIndex;\n\npublic:\n    Vector2D(vector<vector<int>>& vec) : currentIndex(0) {\n        for (const auto& row : vec) {\n            for (int val : row) {\n                elements.push_back(val);\n            }\n        }\n    }\n\n    int next() {\n        return elements[currentIndex++];\n    }\n\n    bool hasNext() {\n        return currentIndex < static_cast<int>(elements.size());\n    }\n};"},"approach_2":{"cpp":"class Vector2D {\n    vector<vector<int>> matrix;\n    int row;\n    int col;\n\n    void advanceToNextValid() {\n        while (row < static_cast<int>(matrix.size()) && col == static_cast<int>(matrix[row].size())) {\n            row++;\n            col = 0;\n        }\n    }\n\npublic:\n    Vector2D(vector<vector<int>>& vec) : matrix(vec), row(0), col(0) {}\n\n    int next() {\n        advanceToNextValid();\n        return matrix[row][col++];\n    }\n\n    bool hasNext() {\n        advanceToNextValid();\n        return row < static_cast<int>(matrix.size());\n    }\n};"}}}]
