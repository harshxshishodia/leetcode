[{"leetcode_no":873,"name":"Length of Longest Fibonacci Subsequence","solutions":{"approach_1":{"cpp":"class Solution {\npublic:\n    int lenLongestFibSubseq(vector<int>& arr) {\n        unordered_set<int> values(\n            arr.begin(),\n            arr.end()\n        );\n\n        int n = static_cast<int>(arr.size());\n        int answer = 0;\n\n        for (int first = 0; first < n; first++) {\n            for (int second = first + 1; second < n; second++) {\n                int a = arr[first];\n                int b = arr[second];\n                int length = 2;\n\n                while (values.count(a + b)) {\n                    int next = a + b;\n                    a = b;\n                    b = next;\n                    length++;\n                }\n\n                answer = max(\n                    answer,\n                    length\n                );\n            }\n        }\n\n        return answer >= 3\n            ? answer\n            : 0;\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    unordered_map<long long, int> memo;\n    unordered_map<int, int> index;\n    vector<int>* values;\n\n    int solve(\n        int first,\n        int second\n    ) {\n        long long key =\n            (\n                static_cast<long long>(first) << 32\n            ) |\n            static_cast<unsigned int>(second);\n\n        auto found =\n            memo.find(key);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        int nextValue =\n            (*values)[first] +\n            (*values)[second];\n\n        auto position =\n            index.find(nextValue);\n\n        int answer = 2;\n\n        if (position != index.end()) {\n            answer =\n                1 +\n                solve(\n                    second,\n                    position->second\n                );\n        }\n\n        memo[key] = answer;\n        return memo[key];\n    }\n\npublic:\n    int lenLongestFibSubseq(vector<int>& arr) {\n        values = &arr;\n        memo.clear();\n        index.clear();\n\n        for (int i = 0; i < static_cast<int>(arr.size()); i++) {\n            index[arr[i]] = i;\n        }\n\n        int answer = 0;\n\n        for (int first = 0;\n             first < static_cast<int>(arr.size());\n             first++) {\n            for (int second = first + 1;\n                 second < static_cast<int>(arr.size());\n                 second++) {\n                answer = max(\n                    answer,\n                    solve(\n                        first,\n                        second\n                    )\n                );\n            }\n        }\n\n        return answer >= 3\n            ? answer\n            : 0;\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int lenLongestFibSubseq(vector<int>& arr) {\n        int n = static_cast<int>(arr.size());\n\n        unordered_map<int, int> index;\n\n        for (int i = 0; i < n; i++) {\n            index[arr[i]] = i;\n        }\n\n        vector<vector<int>> dp(\n            n,\n            vector<int>(n, 2)\n        );\n\n        int answer = 0;\n\n        for (int second = 0; second < n; second++) {\n            for (int third = second + 1; third < n; third++) {\n                int firstValue =\n                    arr[third] -\n                    arr[second];\n\n                auto found =\n                    index.find(firstValue);\n\n                if (found != index.end() &&\n                    found->second < second) {\n                    dp[second][third] =\n                        dp[found->second][second] +\n                        1;\n\n                    answer = max(\n                        answer,\n                        dp[second][third]\n                    );\n                }\n            }\n        }\n\n        return answer;\n    }\n};"},"approach_4":{"cpp":"class Solution {\npublic:\n    int lenLongestFibSubseq(vector<int>& arr) {\n        int n = static_cast<int>(arr.size());\n\n        vector<vector<int>> dp(\n            n,\n            vector<int>(n, 2)\n        );\n\n        int answer = 0;\n\n        for (int third = 2; third < n; third++) {\n            int first = 0;\n            int second = third - 1;\n\n            while (first < second) {\n                long long sum =\n                    static_cast<long long>(arr[first]) +\n                    arr[second];\n\n                if (sum < arr[third]) {\n                    first++;\n                } else if (sum > arr[third]) {\n                    second--;\n                } else {\n                    dp[second][third] =\n                        dp[first][second] +\n                        1;\n\n                    answer = max(\n                        answer,\n                        dp[second][third]\n                    );\n\n                    first++;\n                    second--;\n                }\n            }\n        }\n\n        return answer;\n    }\n};"}}}]
