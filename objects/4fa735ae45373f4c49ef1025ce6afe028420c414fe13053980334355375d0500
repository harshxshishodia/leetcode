[{"leetcode_no":467,"name":"Unique Substrings in Wraparound String","solutions":{"approach_1":{"cpp":"class Solution {\n    bool valid(const string& s) {\n        for (int i = 1; i < static_cast<int>(s.size()); i++) {\n            int previous = s[i - 1] - 'a';\n            int current = s[i] - 'a';\n\n            if ((previous + 1) % 26 != current) {\n                return false;\n            }\n        }\n\n        return true;\n    }\n\npublic:\n    int findSubstringInWraproundString(string s) {\n        unordered_set<string> unique;\n\n        for (int left = 0; left < static_cast<int>(s.size()); left++) {\n            for (int right = left;\n                 right < static_cast<int>(s.size());\n                 right++) {\n                string current = s.substr(\n                    left,\n                    right - left + 1\n                );\n\n                if (valid(current)) {\n                    unique.insert(current);\n                }\n            }\n        }\n\n        return static_cast<int>(unique.size());\n    }\n};"},"approach_2":{"cpp":"class Solution {\npublic:\n    int findSubstringInWraproundString(string s) {\n        unordered_set<string> unique;\n\n        for (int left = 0; left < static_cast<int>(s.size()); left++) {\n            string current;\n            current.push_back(s[left]);\n            unique.insert(current);\n\n            for (int right = left + 1;\n                 right < static_cast<int>(s.size());\n                 right++) {\n                int previous = s[right - 1] - 'a';\n                int next = s[right] - 'a';\n\n                if ((previous + 1) % 26 != next) {\n                    break;\n                }\n\n                current.push_back(s[right]);\n                unique.insert(current);\n            }\n        }\n\n        return static_cast<int>(unique.size());\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int findSubstringInWraproundString(string s) {\n        array<int, 26> longest = {};\n        int currentLength = 0;\n\n        for (int i = 0; i < static_cast<int>(s.size()); i++) {\n            if (i > 0 &&\n                (s[i - 1] - 'a' + 1) % 26 == s[i] - 'a') {\n                currentLength++;\n            } else {\n                currentLength = 1;\n            }\n\n            int index = s[i] - 'a';\n            longest[index] = max(\n                longest[index],\n                currentLength\n            );\n        }\n\n        return accumulate(\n            longest.begin(),\n            longest.end(),\n            0\n        );\n    }\n};"}}}]
