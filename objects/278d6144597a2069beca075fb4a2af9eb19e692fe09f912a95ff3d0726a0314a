[{"leetcode_no":823,"name":"Binary Trees With Factors","solutions":{"approach_1":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n    unordered_set<int> values;\n\n    long long countTrees(int root) {\n        long long answer = 1;\n\n        for (int left : values) {\n            if (root % left != 0) {\n                continue;\n            }\n\n            int right = root / left;\n\n            if (!values.count(right)) {\n                continue;\n            }\n\n            answer +=\n                countTrees(left) *\n                countTrees(right);\n\n            answer %= MOD;\n        }\n\n        return answer;\n    }\n\npublic:\n    int numFactoredBinaryTrees(vector<int>& arr) {\n        values.clear();\n\n        for (int value : arr) {\n            values.insert(value);\n        }\n\n        long long answer = 0;\n\n        for (int value : arr) {\n            answer += countTrees(value);\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_2":{"cpp":"class Solution {\n    static constexpr int MOD = 1000000007;\n    unordered_set<int> values;\n    unordered_map<int, long long> memo;\n\n    long long countTrees(int root) {\n        auto found = memo.find(root);\n\n        if (found != memo.end()) {\n            return found->second;\n        }\n\n        long long answer = 1;\n\n        for (int left : values) {\n            if (root % left != 0) {\n                continue;\n            }\n\n            int right = root / left;\n\n            if (!values.count(right)) {\n                continue;\n            }\n\n            answer +=\n                countTrees(left) *\n                countTrees(right);\n\n            answer %= MOD;\n        }\n\n        memo[root] = answer;\n        return memo[root];\n    }\n\npublic:\n    int numFactoredBinaryTrees(vector<int>& arr) {\n        values.clear();\n        memo.clear();\n\n        for (int value : arr) {\n            values.insert(value);\n        }\n\n        long long answer = 0;\n\n        for (int value : arr) {\n            answer += countTrees(value);\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"},"approach_3":{"cpp":"class Solution {\npublic:\n    int numFactoredBinaryTrees(vector<int>& arr) {\n        const int MOD = 1000000007;\n\n        sort(\n            arr.begin(),\n            arr.end()\n        );\n\n        int n = static_cast<int>(arr.size());\n\n        unordered_map<int, int> index;\n\n        for (int i = 0; i < n; i++) {\n            index[arr[i]] = i;\n        }\n\n        vector<long long> dp(\n            n,\n            1\n        );\n\n        for (int root = 0; root < n; root++) {\n            for (int left = 0; left < root; left++) {\n                if (arr[root] % arr[left] != 0) {\n                    continue;\n                }\n\n                int rightValue =\n                    arr[root] / arr[left];\n\n                auto found =\n                    index.find(rightValue);\n\n                if (found == index.end() ||\n                    found->second >= root) {\n                    continue;\n                }\n\n                dp[root] +=\n                    dp[left] *\n                    dp[found->second];\n\n                dp[root] %= MOD;\n            }\n        }\n\n        long long answer = 0;\n\n        for (long long ways : dp) {\n            answer += ways;\n            answer %= MOD;\n        }\n\n        return static_cast<int>(answer);\n    }\n};"}}}]
